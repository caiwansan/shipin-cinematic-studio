<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>昆仑镜 Kunlun Desktop</title>
<style>
  :root {
    --bg: #0e0f1a; --panel: #16182b; --panel2: #1d2038;
    --text: #e8e6f0; --dim: #8a8aa0; --accent: #c8562a; --accent2: #e6c878;
    --ok: #4ade80; --err: #f87171; --warn: #fbbf24;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: "Segoe UI", "Microsoft YaHei", sans-serif; height: 100vh; overflow: hidden; }
  #app { display: flex; height: 100vh; }
  .sidebar { width: 230px; background: var(--panel); padding: 20px 16px; display: flex; flex-direction: column; gap: 8px; border-right: 1px solid #242748; }
  .logo { font-size: 18px; font-weight: 700; margin-bottom: 18px; }
  .logo span { color: var(--accent2); }
  .nav-item { padding: 10px 12px; border-radius: 8px; cursor: pointer; color: var(--dim); font-size: 14px; }
  .nav-item.active, .nav-item:hover { background: var(--panel2); color: var(--text); }
  .main { flex: 1; padding: 28px 36px; overflow-y: auto; }
  h1 { font-size: 22px; margin-bottom: 6px; }
  .sub { color: var(--dim); font-size: 13px; margin-bottom: 24px; }
  .card { background: var(--panel); border: 1px solid #242748; border-radius: 12px; padding: 18px 20px; margin-bottom: 14px; }
  .card h3 { font-size: 15px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--panel2); color: var(--dim); }
  .badge.ok { background: rgba(74,222,128,.12); color: var(--ok); }
  .badge.err { background: rgba(248,113,113,.12); color: var(--err); }
  .badge.warn { background: rgba(251,191,36,.12); color: var(--warn); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  button { background: var(--accent); color: #fff; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-size: 14px; }
  button.secondary { background: var(--panel2); color: var(--text); border: 1px solid #2d3158; }
  button:disabled { opacity: .4; cursor: not-allowed; }
  input { background: var(--panel2); border: 1px solid #2d3158; color: var(--text); padding: 10px 12px; border-radius: 8px; width: 100%; font-size: 14px; margin-bottom: 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .app-card { background: var(--panel); border: 1px solid #242748; border-radius: 12px; padding: 16px; }
  .app-card .name { font-weight: 600; font-size: 15px; }
  .app-card .desc { color: var(--dim); font-size: 12px; margin: 8px 0 12px; min-height: 34px; }
  .plugin-item { padding: 10px 0; border-bottom: 1px solid #242748; }
  .plugin-item:last-child { border-bottom: none; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .hidden { display: none !important; }
  .login-wrap { display: flex; align-items: center; justify-content: center; height: 100%; }
  .login-box { width: 360px; background: var(--panel); border: 1px solid #242748; border-radius: 16px; padding: 32px; }
  .login-box h2 { margin-bottom: 20px; font-size: 18px; }
  .err-msg { color: var(--err); font-size: 13px; margin-top: 8px; }
  .muted { color: var(--dim); font-size: 12px; }
  a { color: var(--accent2); }

  /* ── RCA-01 Diagnostic Mode 样式 ── */
  .diag-wrap { height: 100vh; overflow-y: auto; padding: 28px 36px; }
  .diag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 14px; }
  .diag-state { font-size: 15px; font-weight: 600; margin-top: 6px; }
  .diag-state.ok { color: var(--ok); } .diag-state.fail { color: var(--err); } .diag-state.warn { color: var(--warn); }
  .diag-env { font: 12px/1.7 monospace; color: var(--dim); white-space: pre-wrap; word-break: break-all; }
  .diag-log { font: 11px/1.6 monospace; color: #b9b9d0; background: #0a0b14; border: 1px solid #242748; border-radius: 8px; padding: 12px; max-height: 320px; overflow: auto; white-space: pre-wrap; word-break: break-all; }
  .diag-tabs { display: flex; gap: 6px; margin: 10px 0; }
  .diag-tab { font-size: 12px; padding: 6px 14px; border-radius: 8px; background: var(--panel2); color: var(--dim); cursor: pointer; border: none; }
  .diag-tab.active { background: var(--accent); color: #fff; }
  .diag-float { position: fixed; right: 16px; bottom: 16px; z-index: 99999; }
  .diag-boot { position: fixed; right: 10px; top: 10px; z-index: 99998; font: 10px monospace; color: var(--dim); text-align: right; }
</style>
</head>
<body>
<div id="app">
  <!-- 登录视图 -->
  <div id="view-login" class="login-wrap hidden">
    <div class="login-box">
      <div class="logo">昆仑镜 <span>KUNLUN</span></div>
      <h2>登录昆仑镜账号</h2>
      <input id="login-account" placeholder="邮箱 / 手机号 / 账号" autocomplete="username" />
      <input id="login-password" type="password" placeholder="密码" autocomplete="current-password" />
      <button id="btn-login" style="width:100%">登 录</button>
      <div id="login-err" class="err-msg"></div>
      <div class="muted" style="margin-top:16px">登录即完成设备激活（Steam/Adobe 激活模式，随机设备标识，不采集硬件序列号）</div>
    </div>
  </div>

  <!-- 主视图 -->
  <div id="view-main" class="hidden">
    <div class="sidebar">
      <div class="logo">昆仑镜 <span>KUNLUN</span></div>
      <div class="nav-item active" data-view="apps">我的应用</div>
      <div class="nav-item" data-view="plugins">插件授权</div>
      <div class="nav-item" data-view="device">设备信息</div>
      <div style="flex:1"></div>
      <div class="nav-item" id="btn-logout">退出登录</div>
    </div>
    <div class="main">
      <div id="page-apps">
        <h1>我的应用</h1>
        <div class="sub" id="sub-apps">加载中…</div>
        <div class="grid" id="apps-grid"></div>
      </div>
      <div id="page-plugins" class="hidden">
        <h1>插件授权</h1>
        <div class="sub" id="sub-plugins">加载中…</div>
        <div class="card" id="plugins-list"></div>
      </div>
      <div id="page-device" class="hidden">
        <h1>设备信息</h1>
        <div class="sub">设备身份与本地应用安装记录</div>
        <div class="card" id="device-info"></div>
      </div>
    </div>
  </div>

  <!-- RCA-01 诊断视图（--diag 强制；不加载登录/API/License/Device/Plugin） -->
  <div id="view-diag" class="hidden">
    <div class="diag-wrap">
      <h1>🩺 Kunlun Media 诊断模式</h1>
      <div class="sub">Desktop Runtime Diagnostic Mode · 本页不加载登录 / API / License / Device / Plugin，仅验证三层运行时</div>
      <div class="diag-grid">
        <div class="card">
          <h3>Tauri Runtime</h3>
          <div id="diag-tauri" class="diag-state warn">检测中…</div>
          <div class="muted">Rust 壳 / 资源协议 / invoke 桥</div>
        </div>
        <div class="card">
          <h3>WebView2</h3>
          <div id="diag-webview" class="diag-state warn">检测中…</div>
          <div class="muted">页面加载 / 渲染引擎</div>
        </div>
        <div class="card">
          <h3>Frontend</h3>
          <div id="diag-frontend" class="diag-state warn">检测中…</div>
          <div class="muted">HTML / CSS / JS 执行</div>
        </div>
      </div>
      <div class="card">
        <h3>环境信息</h3>
        <div id="diag-env" class="diag-env">…</div>
      </div>
      <div class="card">
        <h3>运行时日志（logs/）</h3>
        <div class="diag-tabs" id="diag-tabs">
          <button class="diag-tab active" data-sec="startup">startup.log</button>
          <button class="diag-tab" data-sec="webview">webview.log</button>
          <button class="diag-tab" data-sec="api">api.log</button>
          <button class="diag-tab" data-sec="error">error.log</button>
        </div>
        <div id="diag-log" class="diag-log">加载中…</div>
      </div>
      <div class="row" style="max-width:420px">
        <button id="diag-refresh">刷新日志</button>
        <button id="diag-copy" class="secondary">📋 复制诊断报告</button>
        <button id="diag-exit" class="secondary">退出诊断 → 正常界面</button>
      </div>
      <div class="muted" style="margin-top:12px">日志目录：<span id="diag-logdir">…</span>（打包该目录 + 采集脚本输出发回即可）</div>
    </div>
  </div>
</div>

<script>

// ── RCA-01 诊断管线（SPRINT-RELEASE-WINDOWS-WHITE-SCREEN-ROOT-CAUSE-01）──
// 四日志：startup（启动时间线/BOOT 步骤） webview（页面加载） api（网络请求） error（JS 异常）
// 全部经 diag_write 落盘到 %LOCALAPPDATA%\com.kunlun.desktop\logs\
var __diag = { enabled: false, diagShell: false, logDir: '', boot: [] };
function diagLog(section, line) {
  var entry = line;
  if (section === 'startup' && entry.indexOf('[BOOT]') === 0) {
    __diag.boot.push(entry);
  }
  try {
    if (window.__TAURI__ && window.__TAURI__.core) {
      window.__TAURI__.core.invoke('diag_write', { section: section, line: entry }).catch(function () {});
    }
  } catch (e) {}
}
function bootMark(step, detail) {
  var line = '[BOOT] ' + step + (detail ? ' — ' + detail : '');
  diagLog('startup', line);
  try {
    var el = document.getElementById('diag-bootline');
    if (el) el.textContent = line;
  } catch (e) {}
}
// 网络请求全量记录 → api.log（CSP/网络层证据）
(function () {
  var origFetch = window.fetch;
  window.fetch = function (input, init) {
    var t0 = (window.performance && performance.now) ? performance.now() : 0;
    var url = (typeof input === 'string') ? input : (input && input.url) || String(input);
    var method = (init && init.method) || 'GET';
    return origFetch.apply(this, arguments).then(function (res) {
      diagLog('api', method + ' ' + url + ' -> ' + res.status + ' ' + (res.statusText || '') + ' (' + Math.round(performance.now() - t0) + 'ms)');
      return res;
    }).catch(function (err) {
      diagLog('error', 'FETCH FAIL ' + method + ' ' + url + ' : ' + (err && err.message ? err.message : String(err)));
      throw err;
    });
  };
})();
// 白屏自诊断：JS 错误写入标题+页面（Release-01.3 保留）+ 落盘 error.log（RCA-01）
(function () {
  function probe(color) {
    try {
      var d = document.createElement('div');
      d.style.cssText = 'position:fixed;top:0;left:' + (document.querySelectorAll('[data-probe]').length * 9) + 'px;width:8px;height:8px;background:' + color + ';z-index:999999';
      d.setAttribute('data-probe', '1');
      document.body.appendChild(d);
    } catch (e) {}
  }
  window.__probe = probe;
  probe('#00ff00'); // 脚本已执行
})();
function showFatalError(title, body) {
  try {
    document.title = title;
    var d = document.createElement('div');
    d.style.cssText = 'position:fixed;left:0;right:0;bottom:0;background:#7f1d1d;color:#fff;font:11px monospace;padding:6px;z-index:99999;white-space:pre-wrap;max-height:40%;overflow:auto';
    d.textContent = body;
    document.body.appendChild(d);
  } catch (e) {}
}
window.addEventListener('unhandledrejection', function (e) {
  try {
    var r = e.reason || {};
    var msg = (r && r.message) ? r.message : (r && r.stack) ? r.stack : String(r);
    diagLog('error', 'UNHANDLED REJECTION: ' + msg);
    showFatalError('JS-REJ: ' + msg, 'PROMISE REJECTED: ' + msg);
  } catch (err) {}
});
window.onerror = function (msg, src, line, col, err) {
  try {
    var stack = (err && err.stack) ? err.stack : '';
    diagLog('error', 'JS ERROR: ' + msg + ' @ ' + (src || '') + ':' + line + ':' + col + (stack ? '\n' + stack : ''));
    showFatalError('JS-ERR: ' + msg + ' @' + line + ':' + col, 'JS ERROR: ' + msg + ' @ ' + (src || '') + ':' + line + ':' + col + '\n' + stack);
  } catch (e) {}
};
// ─────────────────────────────────────────────
// ECO-11.2 Kunlun Desktop Shell UI
// 掌柜冻结：只读 Shell；启动线上工作台 = 新 WebView 窗口
// API 走线上 https://aigc.fushtn.com（生产）或 http://127.0.0.1:4002（本地调试）
// ─────────────────────────────────────────────
const API_BASE = (window.__KUNLUN_API__) || 'https://aigc.fushtn.com';
const WORKSPACE_BASE = 'https://aigc.fushtn.com';
const isTauri = !!(window.__TAURI_INTERNALS__);

let creds = { device_id: null, device_token: null, device_fingerprint: null, access_token: null, user_name: null, organization_id: null };
let apps = [];
let plugins = [];

const $ = (id) => document.getElementById(id);

// ── Tauri 桥 ────────────────────────────────
async function invoke(cmd, args = {}) {
  if (!isTauri) {
    // 浏览器调试模式：本地模拟（不落盘）
    if (cmd === 'get_credentials') return { device_id: localStorage.getItem('dbg_device_id'), access_token: localStorage.getItem('dbg_token') };
    if (cmd === 'save_credentials') {
      if (args.device_id) localStorage.setItem('dbg_device_id', args.device_id);
      if (args.access_token) localStorage.setItem('dbg_token', args.access_token);
      return {};
    }
    if (cmd === 'clear_credentials') { localStorage.removeItem('dbg_device_id'); localStorage.removeItem('dbg_token'); return {}; }
    if (cmd === 'generate_device_fingerprint') return crypto.randomUUID();
    if (cmd === 'open_workspace') { throw new Error('open_workspace must go through RuntimeRouter'); }
    return {};
  }
  return window.__TAURI__.core.invoke(cmd, args);
}

// ── 视图切换 ────────────────────────────────
function showMain() { $('view-login').classList.add('hidden'); $('view-main').classList.remove('hidden'); }
function showLogin() { $('view-main').classList.add('hidden'); $('view-login').classList.remove('hidden'); }
function switchPage(name) {
  ['apps','plugins','device'].forEach(p => $(`page-${p}`).classList.toggle('hidden', p !== name));
  document.querySelectorAll('.nav-item[data-view]').forEach(n => n.classList.toggle('active', n.dataset.view === name));
}

// ── API ─────────────────────────────────────
async function api(path, { method = 'GET', body } = {}) {
  const headers = { 'Content-Type': 'application/json' };
  if (creds.access_token) headers['Authorization'] = `Bearer ${creds.access_token}`;
  const res = await fetch(`${API_BASE}${path}`, { method, headers, body: body ? JSON.stringify(body) : undefined });
  const json = await res.json().catch(() => ({}));
  if (res.status === 401) { await logout(); throw new Error('登录已过期，请重新登录'); }
  if (json.code !== 0 && json.code !== undefined && json.code !== 200) throw new Error(json.message || `请求失败(${res.status})`);
  return json.data ?? json;
}

// ── 登录 ────────────────────────────────────
async function doLogin() {
  const account = $('login-account').value.trim();
  const password = $('login-password').value;
  $('login-err').textContent = '';
  if (!account || !password) { $('login-err').textContent = '请输入账号和密码'; return; }
  try {
    const data = await fetch(`${API_BASE}/api/auth/login`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ account, password }),
    }).then(r => r.json());
    const token = data.accessToken;
    if (!token) throw new Error(data.message || '登录失败');
    creds.access_token = token;
    creds.user_name = data.user?.email || data.user?.name || account;
    creds.organization_id = data.user?.organizationId || null;
    await invoke('save_credentials', { access_token: token, user_name: creds.user_name, organization_id: creds.organization_id });
    await ensureDevice();
    showMain();
    await refreshApps(); await refreshPlugins(); await refreshDevice();
  } catch (e) { $('login-err').textContent = e.message; }
}

// ── 设备注册（首次：随机指纹 + 签名 token + 用户确认=已登录）──
async function ensureDevice() {
  if (creds.device_id) return;
  const fingerprint = await invoke('generate_device_fingerprint');
  const data = await api('/api/ecosystem/devices/register', {
    method: 'POST',
    body: { deviceName: `Kunlun Desktop (${navigator.platform || 'Windows'})`, os: 'windows', deviceFingerprint: fingerprint },
  });
  creds.device_id = data.device.deviceId;
  creds.device_token = data.token;
  await invoke('save_credentials', { device_id: creds.device_id, device_token: creds.device_token, device_fingerprint: fingerprint });
}

// ── 应用列表 ────────────────────────────────
async function refreshApps() {
  try {
    const data = await api('/api/ecosystem/applications');
    apps = data.applications || [];
    $('sub-apps').textContent = `共 ${apps.length} 个内置应用 · 启动即打开线上工作台`;
    $('apps-grid').innerHTML = apps.map(a => `
      <div class="app-card">
        <div class="name">${a.name}</div>
        <div class="desc">${a.description || ''}</div>
        <div class="row">
          <span class="badge">${a.category || ''}</span>
          <button data-app-slug="${a.slug}" data-app-entry="${a.workspaceEntry || ''}">启动</button>
        </div>
      </div>`).join('');
    document.querySelectorAll('[data-app-slug]').forEach(b => b.addEventListener('click', () => launchApp(b.dataset.appSlug, b.dataset.appEntry)));
  } catch (e) { $('sub-apps').textContent = `❌ ${e.message}`; }
}

// ═══════════════════════════════════════════════════════════
// RuntimeRouter — AI OS Invocation Layer（S1.2-A 冻结）
// 唯一入口: launch()；状态机 INIT→DISCOVER→AUTH→ISSUE_TICKET→CONNECT→READY
// 能力协议族: workspace(实现) / app / skill / plugin(预留)
// 复用: S1.1 ticket 接口 + bridge.html + from_config
// ═══════════════════════════════════════════════════════════
const RuntimeRouter = (() => {
  const PROTOCOLS = ['workspace', 'app', 'skill', 'plugin']; // 预留扩展
  let _state = 'idle';

  function setState(s) {
    _state = s;
    try {
      if (window.__TAURI_INTERNALS__) {
        window.__TAURI__.core.invoke('diag_write', { key: 'router_state', value: s });
      }
    } catch (e) { /* 静默 */ }
  }

  // 深链解析: kunlun://workspace/{slug}[/project/{id}]（含 decode + 防注入）
  function parseDeepLink(uri) {
    try {
      const m = String(uri).match(/^kunlun:\/\/(workspace|app|skill|plugin)\/([^\/?]+)(?:\/project\/([^\/?]+))?/);
      if (!m) return null;
      return {
        protocol: m[1],
        id: decodeURIComponent(m[2]),
        projectId: m[3] ? decodeURIComponent(m[3]) : undefined,
      };
    } catch (e) { return null; }
  }

  // Registry 解析（消费 ecosystem/applications；本版只实现 workspace）
  function resolveTarget(kind, id) {
    if (kind === 'workspace') {
      const app = (window.__KUNLUN_APPS__ || []).find(a => a.slug === id);
      const entry = app?.workspaceEntry || '';
      return { connectUrl: `${WORKSPACE_BASE}${entry || '/workspace/media'}` };
    }
    return null; // app/skill/plugin 预留
  }

  // ticket 签发（S1.1 后端接口）
  async function issueTicket() {
    const token = creds.access_token;
    if (!token) throw Object.assign(new Error('AUTH_REQUIRED'), { code: 'AUTH_REQUIRED' });
    const res = await fetch(`${API_BASE}/api/auth/desktop/ticket`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({}),
    });
    if (!res.ok) throw Object.assign(new Error('SESSION_FAILED'), { code: 'SESSION_FAILED' });
    const data = await res.json();
    return data?.data?.ticket;
  }

  // 打开桥页（S1.1 bridge.html + from_config；非 Tauri 调试 = 直接跳转）
  function openBridge(connectUrl, ticket) {
    if (isTauri) {
      invoke('open_workspace', { url: connectUrl });
      // ticket 由壳内 Rust 侧注入 bridge 参数（S1.2-B 壳构建时接线）
      // 本版桥页透传在 Rust 侧实现；前端负责签发与传递目标
      sessionStorage.setItem('kunlun_pending_ticket', ticket || '');
      sessionStorage.setItem('kunlun_pending_url', connectUrl);
    } else {
      // 浏览器调试模式: 直接带 ticket 跳转（模拟桥页行为，S1.1 R4 已验证该链路）
      const sep = connectUrl.indexOf('?') >= 0 ? '&' : '?';
      window.location.href = connectUrl + sep + 'ticket=' + encodeURIComponent(ticket);
    }
  }

  // 唯一入口（launch）
  async function launch(spec) {
    try {
      setState('INIT');
      let kind = 'workspace', id, projectId;

      if (spec.kind === 'deepLink') {
        setState('DISCOVER');
        const dl = parseDeepLink(spec.uri);
        if (!dl) return { ok: false, error: 'INVALID_LINK' };
        kind = dl.protocol; id = dl.id; projectId = dl.projectId;
        if (kind !== 'workspace') return { ok: false, error: 'TARGET_NOT_FOUND' }; // 预留协议暂未实现
      } else if (spec.kind === 'app' || spec.kind === 'continue') {
        setState('DISCOVER');
        kind = 'workspace'; id = spec.slug || spec.appSlug; projectId = spec.projectId;
      } else if (spec.kind === 'workspace') {
        setState('DISCOVER');
        kind = 'workspace'; id = spec.slug; projectId = spec.projectId;
      } else {
        return { ok: false, error: 'INVALID_LINK' };
      }

      // AUTH_CHECK
      setState('AUTH_CHECK');
      if (!creds.access_token) {
        showLogin();
        return { ok: false, error: 'AUTH_REQUIRED' };
      }

      // ISSUE_TICKET
      setState('ISSUE_TICKET');
      const ticket = await issueTicket();

      // CONNECT（目标解析 + 打开桥页）
      setState('CONNECT');
      const target = resolveTarget(kind, id);
      if (!target) return { ok: false, error: 'TARGET_NOT_FOUND' };
      let url = target.connectUrl;
      if (projectId) {
        url += (url.indexOf('?') >= 0 ? '&' : '?') + 'project=' + encodeURIComponent(projectId);
      }
      openBridge(url, ticket);

      // READY（桥页接管；诊断状态由 bridge.html connection_state 上报）
      setState('READY');
      return { ok: true, state: 'READY' };
    } catch (e) {
      const code = e?.code || 'SESSION_FAILED';
      console.warn('[RuntimeRouter]', e?.message || e);
      return { ok: false, error: code };
    }
  }

  // 暴露内部（诊断/测试）
  return { launch, parseDeepLink, resolveTarget, getState: () => _state };
})();

// 兼容旧调用点: launchApp = RuntimeRouter.launch（应用中心点击）
function launchApp(slug, entry) {
  return RuntimeRouter.launch({ kind: 'workspace', slug, projectId: undefined });
}

// 深链入口（S1.2-B 壳注册 kunlun:// 后调用；当前留接口）
window.__runtimeRouter__ = RuntimeRouter;
if (typeof window.__KUNLUN_DEEP_LINK__ !== 'undefined') {
  const dl = window.__KUNLUN_DEEP_LINK__;
  RuntimeRouter.launch({ kind: 'deepLink', uri: dl });
}

// ── 插件授权状态 + 本地运行时（ECO-11.3）────────────────────
// 本地 = 入口 + 状态管理；云端 = AI 执行真相（本地零代码执行）
async function startPlugin(pluginId) {
  try {
    const r = await api(`/api/ecosystem/devices/${creds.device_id}/plugins/${pluginId}/start`, { method: 'POST', body: { version: '1.0.0' } });
    if (r.allowed === false) { alert(`插件无法启动: ${r.reason}`); }
    await refreshPlugins();
  } catch (e) { alert(`启动失败: ${e.message}`); }
}
// 进入工作台（云端 Agent 能力呈现处；本地只负责入口）
function openPluginWorkspace(pluginId) {
  openWorkspace(`/workspace/media?plugin=${pluginId}`);
}
async function stopPlugin(pluginId) {
  try {
    await api(`/api/ecosystem/devices/${creds.device_id}/plugins/${pluginId}/stop`, { method: 'POST' });
    await refreshPlugins();
  } catch (e) { alert(`停止失败: ${e.message}`); }
}
async function uninstallPlugin(pluginId) {
  if (!confirm('卸载该插件？（仅本地记录移除，不影响云端授权）')) return;
  try {
    await api(`/api/ecosystem/devices/${creds.device_id}/plugins/${pluginId}/uninstall`, { method: 'POST' });
    await refreshPlugins();
  } catch (e) { alert(`卸载失败: ${e.message}`); }
}

async function refreshPlugins() {
  try {
    if (!creds.device_id) { $('sub-plugins').textContent = '未注册设备'; return; }
    const data = await api(`/api/ecosystem/devices/${creds.device_id}/authorized-plugins`);
    plugins = data.plugins || [];
    const localCount = plugins.filter(p => p.runtimeLocal).length;
    $('sub-plugins').textContent = `设备状态: ${data.deviceStatus || 'ACTIVE'} · ${plugins.length} 个有效授权 · ${localCount} 个支持本地`;
    $('plugins-list').innerHTML = plugins.length === 0
      ? '<div class="muted">暂无已授权插件（订阅插件后此处自动出现）</div>'
      : plugins.map(p => {
          const runtimeBadge = p.runtimeStatus
            ? `<span class="badge ${p.runtimeStatus === 'RUNNING' ? 'ok' : 'warn'}">本地:${p.runtimeStatus}</span>`
            : '<span class="badge">未启动</span>';
          const actions = p.runtimeLocal
            ? `<div style="margin-top:8px;display:flex;gap:8px">
                 ${p.runtimeStatus === 'RUNNING'
                   ? `<button onclick="stopPlugin('${p.pluginId}')">停止</button><button onclick="openPluginWorkspace('${p.pluginId}')">打开工作台</button>`
                   : `<button onclick="startPlugin('${p.pluginId}')">启动</button>`}
                 <button onclick="uninstallPlugin('${p.pluginId}')" style="opacity:.6">卸载</button>
               </div>`
            : '';
          return `
        <div class="plugin-item">
          <div class="row">
            <div>
              <span class="status-dot" style="background:${p.allowed ? 'var(--ok)' : 'var(--err)'}"></span>
              <strong>${p.name}</strong> <span class="badge">${p.type}</span> ${runtimeBadge}
              <div class="muted">${p.pluginId} · ${p.licenseType} · 到期 ${new Date(p.expireAt).toLocaleDateString()}
                ${p.runtimeLocal ? '' : ' · 仅云端'}
              </div>
              <div class="muted">${p.kaorBound ? 'KAOR 云端执行 ✅' : '未绑定 KAOR ⚠️'}${p.runtimeVersion ? ` · 本地 v${p.runtimeVersion}` : ''}</div>
            </div>
            <span class="badge ${p.allowed ? 'ok' : 'err'}">${p.allowed ? '可运行' : '受限'}</span>
          </div>
          ${actions}
        </div>`;
        }).join('');
  } catch (e) { $('sub-plugins').textContent = `❌ ${e.message}`; }
}

// ── 设备信息 ────────────────────────────────
async function refreshDevice() {
  if (!creds.device_id) { $('device-info').innerHTML = '<div class="muted">未注册设备</div>'; return; }
  try {
    const data = await api(`/api/ecosystem/devices/me?deviceId=${creds.device_id}`);
    const d = data.device;
    $('device-info').innerHTML = `
      <div class="row"><span class="muted">设备 ID</span><code>${d.deviceId}</code></div>
      <div class="row"><span class="muted">设备名</span><span>${d.deviceName || '—'}</span></div>
      <div class="row"><span class="muted">系统</span><span>${d.os || '—'}</span></div>
      <div class="row"><span class="muted">状态</span><span class="badge ${d.status === 'ACTIVE' ? 'ok' : 'warn'}">${d.status}</span></div>
      <div class="row"><span class="muted">最后心跳</span><span>${d.lastHeartbeat ? new Date(d.lastHeartbeat).toLocaleString() : '—'}</span></div>
      <div class="row"><span class="muted">本地应用</span><span>${(d.localApps || []).map(a => a.name + ' v' + a.version).join('、') || '—'}</span></div>`;
  } catch (e) { $('device-info').innerHTML = `<div class="err-msg">${e.message}</div>`; }
}

// ── 退出 ────────────────────────────────────
async function logout() {
  await invoke('clear_credentials');
  creds = { device_id: null, device_token: null, device_fingerprint: null, access_token: null, user_name: null, organization_id: null };
  showLogin();
}

// ── 心跳（吊销信号轮询）─────────────────────
async function heartbeatLoop() {
  if (!creds.device_id || !creds.device_token) return;
  try {
    const data = await api(`/api/ecosystem/devices/${creds.device_id}/heartbeat`, {
      method: 'POST', body: { token: creds.device_token },
    });
    if (data.allowed === false) { alert('设备已被管理员吊销/禁用，请重新登录'); await logout(); return; }
    // ECO-11.3：本地运行中的插件心跳续命（云端 Agent 执行不受影响，仅运行时声明）
    for (const p of plugins) {
      if (p.runtimeLocal && p.runtimeStatus === 'RUNNING') {
        await api(`/api/ecosystem/devices/${creds.device_id}/plugins/${p.pluginId}/heartbeat`, {
          method: 'POST', body: { token: creds.device_token },
        }).catch(() => {});
      }
    }
  } catch (e) { /* 网络抖动忽略 */ }
}
setInterval(heartbeatLoop, 60000);

// ── RCA-01 诊断视图（Task 02：脱离业务验证 Shell 融合）──
var __diagEnv = {};
function renderDiagView() {
  $('view-login').classList.add('hidden');
  $('view-main').classList.add('hidden');
  $('view-diag').classList.remove('hidden');

  var tauriOk = !!(window.__TAURI__ && window.__TAURI__.core);
  var tauriEl = $('diag-tauri');
  tauriEl.textContent = tauriOk ? '✅ OK（invoke 桥可用）' : '❌ 不可用（__TAURI__ 缺失）';
  tauriEl.className = 'diag-state ' + (tauriOk ? 'ok' : 'fail');
  // 能渲染到这里 = HTML 解析 + JS 执行 + 页面加载完成
  $('diag-webview').textContent = '✅ OK（页面加载 FINISHED）';
  $('diag-webview').className = 'diag-state ok';
  $('diag-frontend').textContent = '✅ OK（HTML/CSS/JS 执行）';
  $('diag-frontend').className = 'diag-state ok';

  var ua = navigator.userAgent || '';
  var m = ua.match(/Edg\/([\d.]+)/);
  var webviewVer = m ? m[1] : (__diagEnv.webview_version || 'unknown');
  $('diag-env').textContent = [
    'appVersion   : ' + (__diagEnv.app_version || 'unknown'),
    'os           : ' + (__diagEnv.os || 'unknown') + ' / ' + (__diagEnv.arch || 'unknown'),
    'webview2     : ' + webviewVer + '  (UA Edg/' + (m ? m[1] : '?') + ')',
    'debug 模式   : ' + (__diag.enabled ? 'ON (--debug)' : 'OFF'),
    'diag 模式    : ' + (__diag.diagShell ? 'ON (--diag)' : 'OFF'),
    'logDir       : ' + (__diag.logDir || 'unknown'),
    'boot 步骤    : ' + (__diag.boot.length ? __diag.boot.join(' | ') : '—'),
  ].join('\n');
  $('diag-logdir').textContent = __diag.logDir || 'unknown';

  // 日志 tab
  var sec = 'startup';
  document.querySelectorAll('.diag-tab').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('.diag-tab').forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      sec = b.dataset.sec;
      loadDiagLog(sec);
    });
  });
  $('diag-refresh').addEventListener('click', function () { loadDiagLog(sec); });
  $('diag-copy').addEventListener('click', copyDiagReport);
  $('diag-exit').addEventListener('click', function () {
    $('view-diag').classList.add('hidden');
    showLogin();
  });
  loadDiagLog('startup');
}
function loadDiagLog(section) {
  var el = $('diag-log');
  el.textContent = '加载中…';
  if (!window.__TAURI__ || !window.__TAURI__.core) {
    el.textContent = '(浏览器调试模式无日志文件)\n' + (__diag.boot.join('\n') || '');
    return;
  }
  window.__TAURI__.core.invoke('diag_read', { section: section })
    .then(function (txt) { el.textContent = txt || '(空)'; })
    .catch(function (e) { el.textContent = '读取失败: ' + (e && e.message ? e.message : e); });
}
function copyDiagReport() {
  var sections = ['startup', 'webview', 'api', 'error'];
  var report = {
    generatedAt: new Date().toISOString(),
    env: __diagEnv,
    logDir: __diag.logDir,
    boot: __diag.boot,
    logs: {},
  };
  var pending = sections.map(function (s) {
    return window.__TAURI__.core.invoke('diag_read', { section: s })
      .then(function (txt) { report.logs[s] = txt; })
      .catch(function () { report.logs[s] = '(read failed)'; });
  });
  Promise.all(pending).then(function () {
    var text = JSON.stringify(report, null, 2);
    try {
      navigator.clipboard.writeText(text).then(function () { alert('诊断报告已复制到剪贴板 ✅'); })
        .catch(function () { fallbackCopy(text); });
    } catch (e) { fallbackCopy(text); }
  });
}
function fallbackCopy(text) {
  var ta = document.createElement('textarea');
  ta.value = text;
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); alert('诊断报告已复制到剪贴板 ✅'); }
  catch (e) { alert('复制失败，请手动复制诊断报告'); }
  document.body.removeChild(ta);
}
function showDiagFloat() {
  var btn = document.createElement('button');
  btn.textContent = '🩺 诊断';
  btn.className = 'diag-float';
  btn.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:99999;background:#1d2038;color:#e8e6f0;border:1px solid #2d3158;padding:10px 16px;border-radius:10px;cursor:pointer;font-size:13px';
  btn.addEventListener('click', renderDiagView);
  document.body.appendChild(btn);
  var line = document.createElement('div');
  line.id = 'diag-bootline';
  line.className = 'diag-boot';
  document.body.appendChild(line);
}

// ── 启动 ────────────────────────────────────
async function boot() {
  window.__probe('#ffff00'); // boot 开始
  bootMark('0. html loaded');
  bootMark('1. script executed');

  // RCA-01：诊断状态先行（--debug / --diag）
  try {
    if (isTauri) {
      var ds = await invoke('diag_status');
      __diag.enabled = !!ds.enabled;
      __diag.diagShell = !!ds.diag_shell;
      __diag.logDir = ds.log_dir || '';
      __diagEnv = ds;
      bootMark('3. tauri bridge OK', 'diag enabled=' + __diag.enabled + ' shell=' + __diag.diagShell + ' wv=' + ds.webview_version);
      diagLog('webview', 'frontend loaded — UA: ' + navigator.userAgent);
    } else {
      bootMark('3. browser debug mode (no tauri bridge)');
    }
  } catch (e) {
    diagLog('error', 'diag_status FAILED: ' + (e && e.message ? e.message : String(e)));
  }
  bootMark('2. dom ready / api client ready');

  // --diag：诊断 Shell（不加载登录/API/License/Device/Plugin）
  if (__diag.diagShell) {
    bootMark('4. diag shell — business init skipped');
    renderDiagView();
    bootMark('5. view rendered: diag');
    return;
  }

  document.querySelectorAll('.nav-item[data-view]').forEach(n => n.addEventListener('click', () => switchPage(n.dataset.view)));
  $('btn-login').addEventListener('click', doLogin);
  $('login-password').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
  $('btn-logout').addEventListener('click', logout);

  try {
    creds = await invoke('get_credentials');
    window.__probe('#00ffff'); // invoke 完成
  } catch (e) {
    window.__probe('#ff0000'); // invoke 失败
    diagLog('error', 'invoke get_credentials FAILED: ' + (e && e.message ? e.message : String(e)));
    var d = document.createElement('div');
    d.style.cssText = 'position:fixed;bottom:0;left:0;right:0;background:#7f1d1d;color:#fff;font:12px monospace;padding:8px;z-index:999999';
    d.textContent = 'invoke get_credentials FAILED: ' + (e && e.message ? e.message : String(e));
    document.body.appendChild(d);
    return;
  }
  if (creds.access_token) {
    try {
      await ensureDevice();
      showMain();
      await refreshApps(); await refreshPlugins(); await refreshDevice();
      bootMark('5. view rendered: main');
    } catch (e) {
      diagLog('error', 'boot main flow FAILED: ' + (e && e.message ? e.message : String(e)));
      await logout(); // token 失效 → 回登录
      bootMark('5. view rendered: login (token expired)');
    }
  } else {
    showLogin();
    window.__probe('#ff00ff'); // showLogin 完成
    bootMark('5. view rendered: login');
  }
  // --debug：悬浮诊断入口
  if (__diag.enabled) showDiagFloat();
}
boot();

