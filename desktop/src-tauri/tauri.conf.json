{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kunlun Media",
  "version": "1.0.1",
  "identifier": "com.kunlun.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "昆仑镜 Kunlun Desktop",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://aigc.fushtn.com http://127.0.0.1:4002 http://localhost:4002; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "昆仑镜 AI 应用操作系统桌面端",
    "longDescription": "昆仑镜桌面壳：登录昆仑镜账号，管理设备与本地应用，启动线上工作台。AI 应用操作系统入口。",
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon-1024.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {}
}
