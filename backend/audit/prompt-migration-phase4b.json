    {
      "name": "prompt_version_snapshot",
      "columns": ["promptName", "version", "callCount", "windowStart"]
    }
  ],

  "newFiles": [
    {
      "path": "runtime/prompt/PromptTelemetryAggregator.ts",
      "functions": [
        "aggregateVersionStats() — 聚合版本统计",
