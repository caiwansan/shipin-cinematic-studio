        "runFullAggregation() — 全量入口"
      ]
    },
    {
      "path": "routes/admin-prompt-telemetry.ts",
      "endpoints": [
        "POST /api/admin/prompt-telemetry/aggregate",
        "GET /api/admin/prompt-telemetry/overview",
        "GET /api/admin/prompt-telemetry/version-distribution",
        "GET /api/admin/prompt-telemetry/routing-behavior",
        "GET /api/admin/prompt-telemetry/latency-heatmap",
        "GET /api/admin/prompt-telemetry/failure-clusters",
        "GET /api/admin/prompt-telemetry/drift-timeline",
        "GET /api/admin/prompt-telemetry/prompt/:name"
      ]
    },
    {
      "path": "services/cron-prompt-telemetry.ts",
      "cron": "每 10 分钟全量聚合一次"
    }
  ],

  "telemetryIndicators": {
    "PSI (Prompt Stability Index)": "success_calls / total_calls",
    "RE (Routing Entropy)": "-Σ p(mode) * log(p(mode))",
    "VDS (Version Drift Score)": "version_snapshot 时序",
    "LSI (Latency Stability Index)": "p95_latency - avg_latency",
    "FCS (Failure Cluster Score)": "repeated_failure_patterns / total_failures"
  },

