  "newDBTables": [
    {
      "name": "prompt_variant",
      "columns": ["id", "name", "version", "label", "description", "content", "parentVersion", "createdAt"],
      "constraints": ["@@unique([name, version])", "@@index([name, label])"],
      "seedData": 18 rows (每个既有 prompt 的 v1/stable)
    },
    {
      "name": "prompt_runtime_log",
      "columns": ["id", "promptName", "version", "routingMode", "contextHash", "latencyMs", "success", "responseChars", "createdAt"],
      "constraints": ["@@index([promptName, createdAt])"],
      "initialData": "调用自动写入"
    }
  ],

  "newFiles": [
    {
      "path": "runtime/prompt/PromptVersionGraph.ts",
      "api": ["getStableVersion()", "getCurrentVersion()", "getAllVersions()", "getVersion()", "registerVersion()", "setVersionLabel()", "invalidateVersionCache()"],
      "constraints": {
        "readOnly": true,
        "onlyThreeRoutingModes": "stable / canary / override",
        "noAutoPromote": true
      }
    },
    {
      "path": "runtime/prompt/PromptRouter.ts",
      "strategies": ["stable（默认）", "canary（手动开启）", "override（调试指定版本）"],
      "bannedStrategies": ["score routing", "AI decision routing", "auto-fallback learning"]
    },
    {
      "path": "runtime/prompt/PromptRuntimeLogger.ts",
      "api": ["logPromptCall()", "getRecentLogs()", "getPromptStats()", "hashContext()"],
      "constraints": {
        "noScoring": true,
        "noAnalysis": true,
        "noEvolution": true,
        "onlyRecord": true
      }
    },
    {
      "path": "routes/admin-prompt-runtime.ts",
      "endpoints": [
        "GET /api/admin/prompt-runtime/versions/:name",
        "GET /api/admin/prompt-runtime/stable/:name",
        "POST /api/admin/prompt-runtime/set-label",
        "POST /api/admin/prompt-runtime/register",
        "GET /api/admin/prompt-runtime/preview/:name/:version",
        "GET /api/admin/prompt-runtime/logs",
        "GET /api/admin/prompt-runtime/stats/:name"
      ]
    }
  ],

  "modifiedFiles": [
