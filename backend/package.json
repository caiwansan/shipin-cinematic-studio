{
  "name": "scs-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "aes:ast": "npx tsx scripts/aes-v2/analyze-ast.ts",
    "aes:graph": "npx tsx scripts/aes-v2/analyze-graph.ts",
    "aes:check": "npx tsx scripts/aes-v2/index.ts",
    "aes:v3": "npx tsx scripts/aes-v3/index.ts",
    "aes:baseline-update": "rm -f .aes-baseline.json && npx tsx scripts/aes-v3/index.ts",
    "prebuild": "npx tsx scripts/runtime-topology-check.ts && npx tsx scripts/validate-layer-deps.ts && npx tsx scripts/runtime/provider-boundary-check.ts && npx tsx scripts/runtime/migration-boundary-check.ts && npx tsx scripts/aes-v2/index.ts && npx tsx scripts/aes-v3/index.ts",
    "build": "npx tsx scripts/runtime-topology-check.ts && npx tsx scripts/validate-layer-deps.ts && npx tsx scripts/runtime/provider-boundary-check.ts && npx tsx scripts/runtime/migration-boundary-check.ts && npx tsx scripts/aes-v2/index.ts && npx tsx scripts/aes-v3/index.ts && tsc",
    "start": "node --experimental-default-type=commonjs dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/lib-storage": "^3.1052.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "alipay-sdk": "^4.14.0",
    "archiver": "^7.0.1",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.0.0",
    "js-yaml": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.6.0",
    "sharp": "^0.34.5",
    "svg-captcha": "^1.4.0",
    "tencentcloud-sdk-nodejs-sms": "^4.1.239",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "madge": "^8.0.0",
    "prisma": "^6.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "type": "commonjs"
}
