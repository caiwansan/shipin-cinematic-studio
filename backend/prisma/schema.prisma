// ============================================================
// GEO v4 — Sprint 1: Execution, Verification & Learning
// ============================================================

model OptimizationExecution {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")

  optimizationType String   @map("optimization_type")
  executionStatus  String   @map("execution_status")
  triggerSource    String   @default("manual") @map("trigger_source")

  beforeSnapshotId String?  @map("before_snapshot_id")
  afterSnapshotId  String?  @map("after_snapshot_id")
  verificationVersion String? @map("verification_version")
  geoScoreVersion  String?  @map("geo_score_version")

  verificationStatus String? @map("verification_status")

  beforeScore     Float?    @map("before_score")
  afterScore      Float?    @map("after_score")
  scoreDelta      Float?    @map("score_delta")

  changedDimensions Json?    @map("changed_dimensions")

  beforeDimensions Json?    @map("before_dimensions")
  afterDimensions  Json?    @map("after_dimensions")

  industry        String?
  brandType       String?   @map("brand_type")

  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  verifiedAt      DateTime? @map("verified_at")

  @@map("optimization_executions")
}

model VerificationJob {
  id              String   @id @default(uuid())
  executionId     String   @map("execution_id")

  status          String   @default("pending")
  retryCount      Int      @default(0) @map("retry_count")
  maxRetries      Int      @default(3) @map("max_retries")

  lockedBy        String?  @map("locked_by")
  lockedAt        DateTime? @map("locked_at")

  lastError       String?  @map("last_error")

  createdAt       DateTime @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@unique([executionId])
  @@map("verification_jobs")
}

model VerificationResult {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")

  executionId     String   @map("execution_id")

  isImprovement   Boolean  @map("is_improvement")
  deltaWhenVerified Float  @map("delta_when_verified")

  verifiedAt      DateTime @default(now()) @map("verified_at")

  rawEvidence     Json?    @map("raw_evidence")
  details         Json?

  @@unique([executionId])
  @@map("verification_results")
}

model VerificationPolicy {
  id              String   @id @default(uuid())

  industry        String?
  optimizationType String?

  minimumDelta      Float  @default(1.0) @map("minimum_delta")
  noiseThreshold    Float  @default(0.5) @map("noise_threshold")
  minimumConfidence String @default("LOW") @map("minimum_confidence")

  requireRevalidation Boolean @default(true) @map("require_revalidation")
  maxRetries          Int     @default(3) @map("max_retries")

  priority        Int      @default(0)

  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("verification_policies")
}

model GrowthMemory {
  id              String   @id @default(uuid())

  industry        String
  brandType       String?  @map("brand_type")
  optimizationType String  @map("optimization_type")

  totalExecutions Int      @default(0) @map("total_executions")
  successfulCount Int      @default(0) @map("successful_count")
  failedCount     Int      @default(0) @map("failed_count")
  noChangeCount   Int      @default(0) @map("no_change_count")

  totalDelta      Float    @default(0) @map("total_delta")
  averageDelta    Float    @default(0) @map("average_delta")
  successRate     Float    @default(0) @map("success_rate")

  sampleSize      Int      @default(0) @map("sample_size")
  confidence      String   @default("LOW") @map("confidence")

  aggregationVersion String @default("v1") @map("aggregation_version")

  lastUpdated     DateTime @updatedAt @map("last_updated")

  @@unique([industry, brandType, optimizationType])
  @@map("growth_memories")
}

model LearningSignal {
  id              String   @id @default(uuid())

  source          String
  signalType      String   @map("signal_type")
  originalValue   Float    @map("original_value")
  normalizedValue Float    @map("normalized_value")

  weight          Float    @default(1.0)
  weightedValue   Float    @map("weighted_value")

  industry        String?
  optimizationType String?

  reason          String?

  executionId     String?  @map("execution_id")

  generatedAt     DateTime @default(now()) @map("generated_at")

  @@map("learning_signals")
}

model GeoScoreVersion {
  id              String   @id @default(uuid())

  version         String
  releaseNote     String?  @map("release_note")
  isActive        Boolean  @default(false) @map("is_active")

  dimensionWeights Json?   @map("dimension_weights")

  createdAt       DateTime @default(now()) @map("created_at")
  activatedAt     DateTime? @map("activated_at")

  @@map("geo_score_versions")
}

model GrowthKnowledge {
  id              String   @id @default(uuid())

  industry        String
  brandType       String?
  optimizationType String

  insight         String
  bestPractice    String?
  commonFailure   String?

  source          String?
  sampleSize      Int
  averageDelta    Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("growth_knowledge")
}

// ═══════════════════════════════════════════════════════════════
// P3: Publishing Plane (P3.1)
// Freeze Rules:
//   FR-A: Relations use stable IDs, not snapshots
//   FR-B: Version is append-only, never modified
//   FR-C: Channel uses Registry-defined channel ID, not free text
// ═══════════════════════════════════════════════════════════════

// PublishableClaim: Fine-grained publishable unit, derived from a verified Action.
//   One Action → multiple Claims (e.g. About Page + FAQ + Schema)
//   FR-A: References verificationId + sourceActionId, does not copy their content.
model PublishableClaim {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  verificationId   String   @map("verification_id")
  sourceActionId   String   @map("source_action_id")

  title            String
  contentType      String   @map("content_type")    // 'about_page' | 'faq_entry' | 'schema_entity' | 'press_release' | 'knowledge_article'
  content          String                            // Markdown body
  status           String   @default("draft")        // 'draft' | 'ready' | 'published'
  version          String   @default("1.0.0")        // semantic version

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  plans            PublishPlanToClaim[]
  records          PublishingRecord[]

  @@map("publishable_claims")
}

// PublishPlan: Aggregates one or more Claims into a publishable plan.
//   Execution order is expressed as a JSON array of claim IDs (dependency graph).
model PublishPlan {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  title            String
  status           String   @default("draft")        // 'draft' | 'in_review' | 'approved' | 'published' | 'rolled_back'
  targetChannels   Json     @default("[]")           // Array of channel IDs
  executionOrder   Json?    @map("execution_order")  // Optional: JSON array of claim IDs (dependency graph)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  publishedAt      DateTime? @map("published_at")

  claims           PublishPlanToClaim[]
  records          PublishingRecord[]

  @@map("publish_plans")
}

// Join table: Plan ↔ Claim (many-to-many)
model PublishPlanToClaim {
  planId   String        @map("plan_id")
  claimId  String        @map("claim_id")
  plan     PublishPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  claim    PublishableClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([planId, claimId])
  @@map("publish_plan_to_claims")
}

// PublishingRecord: Append-only audit log.
//   FR-B: Version is never modified — rollback creates a new record.
//   FR-C: channel uses Registry-defined channel ID.
//   Records version + artifactHash instead of files.
model PublishingRecord {
  id               String   @id @default(uuid())
  planId           String   @map("plan_id")
  claimId          String   @map("claim_id")
  channel          String                              // Registry-defined channel ID (e.g. 'markdown', 'html_preview', 'schema_jsonld')
  version          String                              // Semantic version at time of publish
  artifactHash     String   @map("artifact_hash")      // Content fingerprint
  artifactUrl      String?  @map("artifact_url")       // Optional URL to published result
  status           String   @default("pending")        // 'pending' | 'published' | 'failed' | 'rolled_back'

  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")

  plan             PublishPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  claim            PublishableClaim   @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("publishing_records")
}

// ============================================================
// KDP (Knowledge Distribution Plane) — Sprint K1
// Frozen 2026-06-30
// Core domain: KnowledgeAsset (not DistributionTask)
// FR-K6: KnowledgeAsset references claimId, NOT projectId directly
// FR-K7: Every asset must have all three variants (human/search/ai)
// ============================================================

// KnowledgeAsset: The core domain object of KDP.
// Does NOT reference projectId directly — goes through claimId only.
// This enables cross-project knowledge sharing (group brand, sub-brands).
model KnowledgeAsset {
  id              String   @id @default(uuid())
  claimId         String   @map("claim_id")             // ↔ PublishableClaim (indirect → Project)
  recordId        String   @map("record_id")            // ↔ PublishingRecord (source of truth)
  assetType       String                                // 'article' | 'schema_entity' | 'entity_graph' | 'fact_sheet' | 'claim_graph' | 'brand_profile' | 'qa_pack' | 'ai_knowledge_feed' | 'ai_manifest'
  status          String   @default("draft")            // 'draft' | 'ready' | 'distributing' | 'distributed' | 'expired'
  title           String   @default("")                 // Asset title (denormalized for convenience)
  humanContent    String   @default("") @map("human_content")   // Human Layer content
  searchContent   String   @default("") @map("search_content")  // Search Layer content
  aiContent       String   @default("") @map("ai_content")      // AI Layer content
  version         String   @default("1.0.0")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([recordId])
  @@index([claimId])
  @@map("knowledge_assets")
}

// AssetVariant: Human / Search / AI — three independent content layers.
// Each variant has its own version and hash, allowing independent updates.
//   Human  → HTML, Markdown (for website readers)
//   Search → JSON-LD, Schema.org (for search engines)
//   AI     → Entity Graph, Fact Sheet, Claim Graph, AI Manifest (for AI models)
model AssetVariant {
  id              String   @id @default(uuid())
  assetId         String   @map("asset_id")             // ↔ KnowledgeAsset
  variantType     String                                // 'human' | 'search' | 'ai'
  contentType     String   @default("text/markdown")    // MIME type
  content         String                                // The actual content
  version         String   @default("1.0.0")            // Independent version per variant
  artifactHash    String   @map("artifact_hash")        // Content fingerprint
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([assetId, variantType])
  @@index([assetId])
  @@map("asset_variants")
}

// DistributionTarget: Registry of all available distribution targets.
// Not a string list on Plan — a modeled entity for extensibility.
model DistributionTarget {
  id              String   @id @default(uuid())
  targetType      String   @unique                      // 'website' | 'rss' | 'sitemap' | 'robots_txt' | 'knowledge_feed' | 'ai_manifest'
  displayName     String                                // "Website", "RSS Feed", "Sitemap", etc.
  description     String?
  enabled         Boolean  @default(true)
  configSchema    Json?                                 // JSON Schema for this target's configuration
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("distribution_targets")
}

// DistributionPlan: A plan to distribute KnowledgeAssets to targets.
// Auto-created when assets are ready, user approves before execution.
model DistributionPlan {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  title           String
  status          String   @default("draft")            // 'draft' | 'pending_review' | 'approved' | 'distributing' | 'completed' | 'cancelled'
  strategy        Json     @default("{}")               // { incrementalOnly, forceFull, scheduleAt }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  approvedAt      DateTime? @map("approved_at")
  completedAt     DateTime? @map("completed_at")

  @@map("distribution_plans")
}

// Junction table: DistributionPlan ↔ KnowledgeAsset
model DistributionPlanToAsset {
  planId          String   @map("plan_id")
  assetId         String   @map("asset_id")

  @@id([planId, assetId])
  @@index([assetId])
  @@map("distribution_plan_to_assets")
}

// DistributionAttempt: Every distribution is a series of attempts.
// FR-K2: Never overwrite — append new attempt for retry.
model DistributionAttempt {
  id              String   @id @default(uuid())
  planId          String   @map("plan_id")
  adapterId       String   @map("adapter_id")           // Which adapter ran this attempt
  assetIds        Json     @default("[]")               // Which assets were included
  attemptNo       Int      @default(1)
  status          String   @default("pending")          // 'pending' | 'preparing' | 'validating' | 'packaging' | 'delivering' | 'success' | 'failed'
  outputUrl       String?  @map("output_url")
  artifactHash    String?  @map("artifact_hash")
  durationMs      Int?     @map("duration_ms")
  errorLog        String?  @map("error_log")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([planId])
  @@index([adapterId])
  @@map("distribution_attempts")
}

// DistributionAdapter: Registry of available adapters.
model DistributionAdapter {
  id              String   @id @default(uuid())
  adapterType     String   @unique                      // 'sitemap' | 'rss' | 'knowledge_feed' | 'robots_txt' | 'ai_manifest'
  name            String
  adapterClass    String   @default("local")            // 'local' | 'external'
  enabled         Boolean  @default(true)
  config          Json?                                 // Per-adapter configuration (e.g. { baseUrl, outputDir })
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("distribution_adapters")
}

// ============================================================
// KDP — Sprint K2 (Knowledge Packaging)
// Frozen 2026-06-30
// Core domain: KnowledgePackage (not Adapter)
// Packaging is a business capability, not a tool.
// FR-K10: KnowledgePackage is the distribution unit.
// ============================================================

// KnowledgePackage: The unit of distribution.
// Every KnowledgeAsset can produce one or more Packages.
// Package is immutable once created (FR-K9 by extension).
model KnowledgePackage {
  id              String   @id @default(uuid())
  assetId         String   @map("asset_id")             // ↔ KnowledgeAsset
  projectId       String   @map("project_id")
  packageType     String                                // 'website' | 'sitemap' | 'rss' | 'ai_feed' | 'knowledge_bundle'
  status          String   @default("draft")            // 'draft' | 'packaged' | 'validated' | 'delivered' | 'failed'
  version         String   @default("1.0.0")
  artifactHash    String   @map("artifact_hash")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  manifestId      String?  @map("manifest_id")          // ↔ PackageManifest
  artifacts       PackageArtifact[]

  @@index([assetId])
  @@index([projectId])
  @@index([packageType])
  @@map("knowledge_packages")
}

// PackageManifest: Independent model for package metadata.
// Not embedded JSON — enables versioning, diffing, and signing.
model PackageManifest {
  id              String   @id @default(uuid())
  schemaVersion   String   @default("2.0")
  
  // Source provenance
  sourceAssetId   String   @map("source_asset_id")
  sourceClaimId   String   @map("source_claim_id")
  sourceRecordId  String   @map("source_record_id")
  sourceProjectId String?  @map("source_project_id")

  // Content metadata
  title           String
  summary         String
  estimatedSize   Int      @map("estimated_size")
  mimeType        String   @map("mime_type")
  language        String   @default("zh-CN")

  // Delivery hints
  preferredTargets Json    @default("[]")               // Array of DistributionTarget
  cacheTTL        Int      @default(3600)               // Seconds
  requiresIndexing Boolean @default(true) @map("requires_indexing")
  priority        String   @default("normal")

  // Validation
  contentHash     String   @map("content_hash")
  signed          Boolean  @default(false)
  timestamp       DateTime @default(now())

  @@index([sourceAssetId])
  @@map("package_manifests")
}

// PackageArtifact: Individual files within a Package.
// A Package can have multiple Artifacts (e.g. index.html + about.html for Website).
// This decouples Package metadata from actual file content.
model PackageArtifact {
  id              String   @id @default(uuid())
  packageId       String   @map("package_id")           // ↔ KnowledgePackage
  fileName        String   @map("file_name")            // 'index.html', 'entities.json', 'feed.xml'
  filePath        String   @map("file_path")            // Relative path within package
  mimeType        String   @map("mime_type")
  content         String                                // The actual artifact content
  contentHash     String   @map("content_hash")
  size            Int                                   // Byte size
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  package         KnowledgePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([fileName])
  @@map("package_artifacts")
}

// ============================================================
// KDP — Sprint K3 (Knowledge Delivery Runtime)
// Frozen 2026-07-01
// Core principle: Delivery is a Runtime, not a Script.
// FR-K11: Runtime handles Queue → Dispatch → Retry → Rollback → Verify
// FR-K12: Runtime only cares about DeliveryTarget, not platform
// FR-K13: K3 only supports Local Delivery
// ============================================================

// DeliveryJob: A job packages one or more KnowledgePackages for delivery.
model DeliveryJob {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  packageIds      String   @map("package_ids")                     // JSON array
  targetId        String   @map("target_id")                       // ↔ DeliveryTarget
  status          String   @default("queued")                      // 'queued' | 'dispatching' | 'delivering' | 'verifying' | 'completed' | 'failed' | 'rolled_back'
  priority        String   @default("normal")                      // 'high' | 'normal' | 'low'
  retryCount      Int      @default(0) @map("retry_count")
  maxRetries      Int      @default(3) @map("max_retries")
  createdAt       DateTime @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  errorLog        String?  @map("error_log")

  @@index([status])
  @@index([projectId])
  @@index([targetId])
  @@map("delivery_jobs")
}

// DeliveryTarget: Where packages are delivered.
// First version: 'local' (sandbox/output/)
model DeliveryTarget {
  id              String   @id @default(uuid())
  type            String                                      // 'local' | 'website' | 'cms' | 'knowledge_base' | 'search_endpoint' | 'ai_endpoint'
  name            String
  config          Json    @default("{}")                      // Per-target configuration (outputPath, baseUrl, etc.)
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("delivery_targets")
}

// DeliveryRecord: Append-only audit trail for every delivery.
model DeliveryRecord {
  id              String   @id @default(uuid())
  jobId           String   @map("job_id")                     // ↔ DeliveryJob
  packageId       String   @map("package_id")                 // ↔ KnowledgePackage
  targetId        String   @map("target_id")                  // ↔ DeliveryTarget
  status          String                                      // 'completed' | 'failed' | 'rolled_back'
  outputPath      String   @map("output_path")                // File system path
  bytes           Int                                         // Total bytes delivered
  artifactCount   Int      @map("artifact_count")             // Number of artifacts
  checksum        String                                      // SHA256 of delivered content
  previousState   String?  @map("previous_state")             // For rollback
  durationMs      Int?     @map("duration_ms")
  errorLog        String?  @map("error_log")
  startedAt       DateTime @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([jobId])
  @@index([packageId])
  @@index([targetId])
  @@map("delivery_records")
}

