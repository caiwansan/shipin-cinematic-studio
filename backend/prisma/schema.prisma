generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-1.0.x", "debian-openssl-3.0.x", "native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiStageModelConfig {
  stage     String   @id
  provider  String   @default("bailian")
  model     String   @default("wan2.7-t2v")
  size      String   @default("1024x1024")
  baseUrl   String   @default("") // Sprint-ADMIN-IA-REALITY-03 T02: 平台默认模型自定义端点
  params    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_stage_model_config")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  username              String                 @unique
  passwordHash          String
  phone                 String?                @unique
  phoneVerified         Boolean                @default(false)
  memberTier            String                 @default("free")
  memberExpiresAt       DateTime?
  createdAt             DateTime               @default(now())
  wechatOpenId          String?                @unique
  tokenVersion          Int                    @default(1)
  qqOpenId              String?                @unique
  marketAgentId         String?
  agentPlanId           String?
  agentExpiresAt        DateTime?
  agentLevel            String?
  agentStatus           String                 @default("none")
  agentCreatedAt        DateTime?
  provinceCode          String?
  provinceName          String?
  cityCode              String?
  cityName              String?
  districtCode          String?
  districtName          String?
  updatedAt             DateTime               @updatedAt
  lastActiveAt          DateTime?
  comments              AssetComment[]
  dna                   CreatorDnaProfile?
  dailyUsage            DailyUsage[]
  membership            Membership?
  projects              Project[]
  userModelConfigV2     UserModelConfigV2?
  communityCommentLikes CommunityCommentLike[]
  communityComments     CommunityComment[]
  communityLikes        CommunityLike[]
  communityPosts        CommunityPost[]
  communityRewards      CommunityReward[]
  messagesSent          UserMessage[]          @relation("messages_sent")
  messagesReceived      UserMessage[]          @relation("messages_received")
  ownedProjects         Project[]              @relation("ProjectOwner")
  ecomProjects          EcomProject[]
  careerProfile CareerProfile?
}

model CreatorDnaProfile {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique @db.Uuid
  cinematicStyleSignature String?
  pacingProfile           String?
  emotionalProfile        String?
  visualProfile           String?
  directorSpeciesType     String?
  dominantGenres          String?
  creatorRank             Int      @default(0)
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Captcha {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SmsCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  status              String               @default("draft")
  version             Int                  @default(1)
  userId              String               @db.Uuid

  // ── Phase 1a: Tenant & Project Center ──
  tenantId            String?
  ownerId             String?              @db.Uuid
  type                String?              // 'geo' | 'video' | 'novel' | 'ppt' | 'custom'
  resourceCount       Int                  @default(0)
  lastExecutionAt     DateTime?
  lastActivityAt      DateTime?

  // ── Relations (Phase 1a, nullable until backfill) ──
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  owner               User?                @relation("ProjectOwner", fields: [ownerId], references: [id])

  // ── Profile extensions (Phase 1a) ──
  geoProfile          GeoProjectProfile?

  budgetLimit         Float?
  budgetSpent         Float                @default(0)
  budgetAlertAt       Float?
  budgetNotified      Boolean              @default(false)
  executionResults    Json?                @map("execution_results")
  mergedVideoUrl      String?              @map("merged_video_url")
  mergeStatus         String?              @map("merge_status")
  runtimeCheckpoint   Json?                @map("runtime_checkpoint")
  failureEvents       Json?                @map("failure_events")
  executionJournal    Json?                @map("execution_journal")
  script              String?
  plotBlueprint       Json?                @map("plot_blueprint")
  continuationFrom    String?              @map("continuation_from") @db.Uuid
  workspaceId         String?              @map("workspace_id") @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assets              Asset[]
  assetGraphEdges     AssetGraphEdge[]
  assetRegistries     AssetRegistry[]
  characterProfiles   CharacterProfile[]
  continuities        ContinuityLink[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id])
  sceneProfiles       SceneProfile[]
  storyboards         Storyboard[]
  videoTasks          VideoTask[]
  aiActionSpecs       AiActionSpec[]
  aiCameraSpecs       AiCameraSpec[]
  aiCharacterSpecs    AiCharacterSpec[]
  aiEffectSpecs       AiEffectSpec[]
  aiEmotionSpecs      AiEmotionSpec[]
  aiFrameDesigns      AiFrameDesign[]
  aiPropSpecs         AiPropSpec[]
  aiSceneSpecs        AiSceneSpec[]
  aiSegmentEdits      AiSegmentEdit[]
  aiVideoProduction   AiVideoProduction?
  aiVideoSegments     AiVideoSegment[]
  aiVoiceConfigs      AiVoiceConfig[]
  characterImages     CharacterImage[]
  characterReferences CharacterReference[]
  exportTasks         ExportTask[]
  frameImages         FrameImage[]
  pipelineJobs        PipelineJob[]
  pipelineStages      PipelineStage[]
  propImages          PropImage[]
  sceneImages         SceneImage[]
  sceneReferences     SceneReference[]
  storyboardImages    StoryboardImage[]
  ttsRecords          TTSRecord[]
}

model AiCharacterSpec {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  characterName       String
  variant             String   @default("")
  gender              String?
  age                 String?
  role                String?
  voiceType           String?  @map("voice_type")
  physicalDescription String?
  clothing            String?
  imagePrompt         String   @default("")
  negativePrompt      String?
  referenceImageUrl   String?
  confirmed           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterName, variant])
  @@map("ai_character_specs")
}

model TTSRecord {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  characterName String
  voiceId       String
  audioUrl      String
  duration      Int      @default(0)
  sequenceIndex Int      @default(0)
  text          String   @default("")
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, characterName])
  @@map("tts_records")
}

model AiSceneSpec {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  sceneId        String
  sceneName      String
  description    String?
  type           String?  @map("type")
  timeOfDay      String?  @map("time_of_day")
  lighting       String?  @map("lighting")
  mood           String?  @map("mood")
  colorTone      String?  @map("color_tone")
  environment    String?  @map("environment")
  imagePrompt    String   @default("")
  negativePrompt String?
  aspectRatio    String   @default("16:9")
  confirmed      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_scene_specs")
}

model ImagePromptTemplates {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  templateKey String
  title       String
  content     String
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, templateKey])
  @@map("image_prompt_templates")
}

model AiVoiceConfig {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  characterName String
  voiceType     String?
  speakingStyle String?
  pitch         Float    @default(1.0)
  speed         Float    @default(1.0)
  ttsPrompt     String?
  audioUrl      String?  @map("audio_url")
  voiceId       String?  @map("voice_id")
  confirmed     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_voice_configs")
}

model AiVideoSegment {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  title            String?
  associatedScenes String?
  duration         Int?
  narrativePurpose String?
  fullText         String?  @map("full_text")
  shotPattern      String?
  emotionArc       String?
  backgroundMusic  String?
  videoUrl         String?  @map("video_url")
  firstFrameUrl    String?  @map("first_frame_url")
  midFrameUrl      String?  @map("mid_frame_url")
  lastFrameUrl     String?  @map("last_frame_url")
  firstFrameDesc   String?  @map("first_frame_desc")
  midFrameDesc     String?  @map("mid_frame_desc")
  lastFrameDesc    String?  @map("last_frame_desc")
  confirmed        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  narrative        String?  @map("narrative")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, segmentId])
  @@map("ai_video_segments")
}

model AiSegmentEdit {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  narrative        String?  @map("narrative")
  dialogue         String?  @map("dialogue")
  effects          String?  @map("effects")
  emotion          String?  @map("emotion")
  negativePrompt   String?  @map("negative_prompt")
  duration         Int?     @map("duration")
  firstFramePrompt String?  @map("first_frame_prompt")
  firstFrameNeg    String?  @map("first_frame_neg")
  midFramePrompt   String?  @map("mid_frame_prompt")
  midFrameNeg      String?  @map("mid_frame_neg")
  lastFramePrompt  String?  @map("last_frame_prompt")
  lastFrameNeg     String?  @map("last_frame_neg")
  charImageUrls    String?  @map("char_image_urls")
  sceneImageUrls   String?  @map("scene_image_urls")
  propImageUrls    String?  @map("prop_image_urls")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, segmentId])
  @@map("ai_segment_edits")
}

model AiFrameDesign {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  firstFrameDesc   String?
  firstFramePrompt String?
  firstFrameAngle  String?
  lastFrameDesc    String?
  lastFramePrompt  String?
  lastFrameAngle   String?
  confirmed        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_frame_designs")
}

model AiVideoProduction {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @unique @db.Uuid
  overallStyle         String?
