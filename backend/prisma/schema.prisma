// ============================================================
// KMKI-GEO — Knowledge Skeleton (Sprint 1A)
// ============================================================

// ── Phase 1a: GEO Project Profile（统一 Project 的 GEO 扩展）──
model GeoProjectProfile {
  id         String   @id @default(uuid())
  projectId  String   @unique @db.Uuid
  website    String?
  domain     String?
  brand      String?
  language   String   @default("zh")
  country    String?
  industry   String?
  topic      String?
  geoConfig  Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_project_profiles")
}

model GEOProject {
  id        String   @id @default(uuid())
  userId    String
  name      String
  website   String?     // 官网 URL（MVP 新增）
  topic     String?
  industry  String?
  keywords  Json?       // 关键词 string[]（MVP 新增，从 GeoBrandSetting 移入）
  language  String   @default("zh")
  country   String?
  status    String   @default("draft")
  config    Json     @default("{}")
  workspaceId String? @map("workspace_id")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities  GEOEntity[]
  relations GEOEntityRelation[]
  versions  GEOProjectVersion[]
  scans     GEOScanRecord[]   // MVP 新增
  discoveryReports  GEODiscoveryReport[]    // P1-A 持久化
  actionPlans       GEOActionPlan[]         // P1-A 持久化
  verificationReports GEOVerificationReport[] // P1-A 持久化

  @@index([userId])
  @@index([status])
  @@map("kmki_geo_projects")
}

// P1-A 新增：GEO Discovery Report — 保存实体发现报告
model GEODiscoveryReport {
  id            String   @id @default(uuid())
  projectId     String          // 关联 GEOProject.id
  entityName    String
  adi           Float
  coverageScore Float
  shareScore    Float
  positionScore Float
  reportData    Json            // 完整报告数据（包括 scenarios, opportunities 等）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_discovery_reports")
}

// P1-A 新增：GEO Action Plan — 保存建议的行动计划
model GEOActionPlan {
  id                String   @id @default(uuid())
  projectId         String
  discoveryReportId String?
  planData          Json     // 完整计划数据（包括 steps, templates 等）
  status            String   @default("draft") // draft, active, completed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_action_plans")
}

// P1-A 新增：GEO Verification Report — 保存验证结果
model GEOVerificationReport {
  id            String   @id @default(uuid())
  projectId     String
  entityName    String
  beforeAdi     Float
  afterAdi      Float
  deltaAdi      Float
  reportData    Json     // 完整验证数据
  createdAt     DateTime @default(now())

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_verification_reports")
}

// MVP 新增：扫描记录
model GEOScanRecord {
  id        String   @id @default(uuid())
  projectId String
  userId    String

  scanStatus     String   @default("pending")  // pending | running | completed | failed | partial
  scanStartedAt  DateTime?
  scanFinishedAt DateTime?

  // 4 维分数
  visibilityScore      Int?
  accuracyScore        Int?
  consistencyScore     Int?
  recommendationScore  Int?
  overallScore         Int?

  aiResponses       Json?    // 各 AI 模型的原始响应
  optimizationItems Json?    // 优化建议列表

  errorMessage  String?
  durationMs    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([scanStatus])
  @@map("kmki_geo_scan_records")
}

model GEOEntity {
  id          String   @id @default(uuid())
  projectId   String

  // ── Phase 1a: Tenant (nullable until backfill) ──
  tenantId    String?  @db.Uuid

  name        String
  type        String   @default("Concept")
  description String?
  metadata    Json?    @default("{}")
  provenance  Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  GEOProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoing GEOEntityRelation[] @relation("outgoing")
  incoming GEOEntityRelation[] @relation("incoming")

  claims        GEOClaim[]         // Sprint 1B: Knowledge Quality
  faqs          GEOFAQ[]           // Sprint 1B: Knowledge Quality
  schemaMarkups GEOSchemaMarkup[]  // Sprint 1B: Knowledge Quality

  @@index([projectId])
  @@index([projectId, type])
  @@map("kmki_geo_entities")
}

model GEOEntityRelation {
  id        String   @id @default(uuid())
  projectId String
  sourceId  String
  tenantId    String?  @db.Uuid
  targetId  String
  type      String   @default("related_to")
  lineage   Json     @default("{}")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  GEOEntity  @relation("outgoing", fields: [sourceId], references: [id], onDelete: Cascade)
  target  GEOEntity  @relation("incoming", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceId])
  @@index([targetId])
  @@map("kmki_geo_entity_relations")
}

model GEOProjectVersion {
  id         String   @id @default(uuid())
  projectId  String
  tenantId    String?  @db.Uuid
  version    Int
  label      String?
  graphData  Json     @default("{}")
  metadata   Json?    @default("{}")
  snapshotId String?
  createdAt  DateTime @default(now())

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
  @@map("kmki_geo_project_versions")
}

// ============================================================
// KMKI-GEO — Knowledge Quality Layer (Sprint 1B)
// ============================================================

model GEOClaim {
  id          String   @id @default(uuid())
  entityId    String
  tenantId    String?  @db.Uuid
  text        String
  claimType   String   @default("fact")        // primary, derived, opinion, fact, hypothesis
  confidence  Float    @default(0.0)
  sourceType  String   @default("llm_extracted")
  status      String   @default("draft")       // draft, review, approved, rejected, stale
  provenance  Json     @default("{}")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    GEOEntity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  evidences GEOEvidence[]

  @@index([entityId])
  @@index([claimType])
  @@index([status])
  @@index([confidence])
  @@map("kmki_geo_claims")
}

model GEOEvidence {
  id                 String   @id @default(uuid())
  claimId            String
  tenantId           String?  @db.Uuid
  source             String   @default("")
  content            String   @default("")
  credibilityScore   Float    @default(0.0)
  verificationMethod String   @default("llm")        // manual, llm, crawler, api, human_review
  collectedAt        DateTime @default(now())
  provenance         Json     @default("{}")
  metadata           Json?    @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  claim     GEOClaim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  citations GEOCitation[]

  @@index([claimId])
  @@index([verificationMethod])
  @@index([credibilityScore])
  @@map("kmki_geo_evidences")
}

model GEOCitation {
  id            String   @id @default(uuid())
  evidenceId    String
  format        String   @default("custom")       // apa, mla, custom
  tenantId       String?  @db.Uuid
  citationText  String   @default("")
  sourceUrl     String?
  publisher     String?
  author        String?
  datePublished String?
  authorityLevel String  @default("news")          // government, academic, industry, news, community
  provenance    Json     @default("{}")
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidence GEOEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([authorityLevel])
  @@map("kmki_geo_citations")
}

model GEOFAQ {
  id          String   @id @default(uuid())
  entityId    String
  tenantId       String?  @db.Uuid
  question    String
  answer      String
  schemaType  String   @default("FAQPage")
  confidence  Float    @default(0.0)
  status      String   @default("draft")
  provenance  Json     @default("{}")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity GEOEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([status])
  @@map("kmki_geo_faqs")
}

model GEOSchemaMarkup {
  id               String   @id @default(uuid())
  tenantId         String?  @db.Uuid
  entityId         String
  schemaType       String   @default("Article")   // Article, Product, FAQPage, VideoObject, etc.
  markup           Json     @default("{}")         // The actual schema.org JSON-LD
  validationStatus String   @default("pending")    // pending, valid, invalid
  validationErrors Json?    @default("[]")
  provenance       Json     @default("{}")
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity GEOEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([schemaType])
  @@index([validationStatus])
  @@map("kmki_geo_schema_markups")
}

model GEOReviewQueue {
  id             String   @id @default(uuid())
  projectId      String
  tenantId       String?  @db.Uuid
  reviewableType String                           // claim, evidence, faq
  reviewableId   String
  state          String   @default("draft")       // draft, reviewed, approved, rejected, request_revision, escalated, stale, archived
  reviewerId     String?
  reviewNotes    String?
  previousState  String?
  provenance     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

