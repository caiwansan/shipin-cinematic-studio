  @@map("governance_license")
}

model AnalyticsDaily {
  id             String   @id @default(uuid())
  tenantId       String
  date           DateTime
  metric         String   // dailyActiveUsers, tokenCount, workflowCount, cost, agentSessions, successRate, failureRate, latencyAvg
  value          Float
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, date, metric])

  @@map("governance_analytics_daily")
