generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiStageModelConfig {
  stage     String   @id
  provider  String   @default("bailian")
  model     String   @default("wan2.7-t2v")
  size      String   @default("1024x1024")
  params    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_stage_model_config")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  username              String                 @unique
  passwordHash          String
  phone                 String?                @unique
  phoneVerified         Boolean                @default(false)
  memberTier            String                 @default("free")
  memberExpiresAt       DateTime?
  createdAt             DateTime               @default(now())
  wechatOpenId          String?                @unique
  tokenVersion          Int                    @default(1)
  qqOpenId              String?                @unique
  marketAgentId         String?
  agentPlanId           String?
  agentExpiresAt        DateTime?
  agentLevel            String?
  agentStatus           String                 @default("none")
  agentCreatedAt        DateTime?
  provinceCode          String?
  provinceName          String?
  cityCode              String?
  cityName              String?
  districtCode          String?
  districtName          String?
  updatedAt             DateTime               @updatedAt
  lastActiveAt          DateTime?
  comments              AssetComment[]
  dna                   CreatorDnaProfile?
  dailyUsage            DailyUsage[]
  membership            Membership?
  projects              Project[]
  userModelConfigV2     UserModelConfigV2?
  communityCommentLikes CommunityCommentLike[]
  communityComments     CommunityComment[]
  communityLikes        CommunityLike[]
  communityPosts        CommunityPost[]
  communityRewards      CommunityReward[]
  messagesSent          UserMessage[]          @relation("messages_sent")
  messagesReceived      UserMessage[]          @relation("messages_received")
  ownedProjects         Project[]              @relation("ProjectOwner")
}

model CreatorDnaProfile {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique @db.Uuid
  cinematicStyleSignature String?
  pacingProfile           String?
  emotionalProfile        String?
  visualProfile           String?
  directorSpeciesType     String?
  dominantGenres          String?
  creatorRank             Int      @default(0)
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Captcha {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SmsCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  status              String               @default("draft")
  version             Int                  @default(1)
  userId              String               @db.Uuid

  // ── Phase 1a: Tenant & Project Center ──
  tenantId            String?              @db.Uuid
  ownerId             String?              @db.Uuid
  type                String?              // 'geo' | 'video' | 'novel' | 'ppt' | 'custom'
  resourceCount       Int                  @default(0)
  lastExecutionAt     DateTime?
  lastActivityAt      DateTime?

  // ── Relations (Phase 1a, nullable until backfill) ──
  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  owner               User?                @relation("ProjectOwner", fields: [ownerId], references: [id])

  // ── Profile extensions (Phase 1a) ──
  geoProfile          GeoProjectProfile?

  budgetLimit         Float?
  budgetSpent         Float                @default(0)
  budgetAlertAt       Float?
  budgetNotified      Boolean              @default(false)
  executionResults    Json?                @map("execution_results")
  mergedVideoUrl      String?              @map("merged_video_url")
  mergeStatus         String?              @map("merge_status")
  runtimeCheckpoint   Json?                @map("runtime_checkpoint")
  failureEvents       Json?                @map("failure_events")
  executionJournal    Json?                @map("execution_journal")
  script              String?
  plotBlueprint       Json?                @map("plot_blueprint")
  continuationFrom    String?              @map("continuation_from") @db.Uuid
  workspaceId         String?              @map("workspace_id") @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assets              Asset[]
  assetGraphEdges     AssetGraphEdge[]
  assetRegistries     AssetRegistry[]
  characterProfiles   CharacterProfile[]
  continuities        ContinuityLink[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id])
  sceneProfiles       SceneProfile[]
  storyboards         Storyboard[]
  videoTasks          VideoTask[]
  aiActionSpecs       AiActionSpec[]
  aiCameraSpecs       AiCameraSpec[]
  aiCharacterSpecs    AiCharacterSpec[]
  aiEffectSpecs       AiEffectSpec[]
  aiEmotionSpecs      AiEmotionSpec[]
  aiFrameDesigns      AiFrameDesign[]
  aiPropSpecs         AiPropSpec[]
  aiSceneSpecs        AiSceneSpec[]
  aiSegmentEdits      AiSegmentEdit[]
  aiVideoProduction   AiVideoProduction?
  aiVideoSegments     AiVideoSegment[]
  aiVoiceConfigs      AiVoiceConfig[]
  characterImages     CharacterImage[]
  characterReferences CharacterReference[]
  exportTasks         ExportTask[]
  frameImages         FrameImage[]
  pipelineJobs        PipelineJob[]
  pipelineStages      PipelineStage[]
  propImages          PropImage[]
  sceneImages         SceneImage[]
  sceneReferences     SceneReference[]
  storyboardImages    StoryboardImage[]
  ttsRecords          TTSRecord[]
}

model AiCharacterSpec {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  characterName       String
  variant             String   @default("")
  gender              String?
  age                 String?
  role                String?
  voiceType           String?  @map("voice_type")
  physicalDescription String?
  clothing            String?
  imagePrompt         String   @default("")
  negativePrompt      String?
  referenceImageUrl   String?
  confirmed           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterName, variant])
  @@map("ai_character_specs")
}

model TTSRecord {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  characterName String
  voiceId       String
  audioUrl      String
  duration      Int      @default(0)
  sequenceIndex Int      @default(0)
  text          String   @default("")
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, characterName])
  @@map("tts_records")
}

model AiSceneSpec {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  sceneId        String
  sceneName      String
  description    String?
  type           String?  @map("type")
  timeOfDay      String?  @map("time_of_day")
  lighting       String?  @map("lighting")
  mood           String?  @map("mood")
  colorTone      String?  @map("color_tone")
  environment    String?  @map("environment")
  imagePrompt    String   @default("")
  negativePrompt String?
  aspectRatio    String   @default("16:9")
  confirmed      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_scene_specs")
}

model ImagePromptTemplates {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  templateKey String
  title       String
  content     String
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, templateKey])
  @@map("image_prompt_templates")
}

model AiVoiceConfig {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  characterName String
  voiceType     String?
  speakingStyle String?
  pitch         Float    @default(1.0)
  speed         Float    @default(1.0)
  ttsPrompt     String?
  audioUrl      String?  @map("audio_url")
  voiceId       String?  @map("voice_id")
  confirmed     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_voice_configs")
}

model AiVideoSegment {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  title            String?
  associatedScenes String?
  duration         Int?
  narrativePurpose String?
  fullText         String?  @map("full_text")
  shotPattern      String?
  emotionArc       String?
  backgroundMusic  String?
  videoUrl         String?  @map("video_url")
  firstFrameUrl    String?  @map("first_frame_url")
  midFrameUrl      String?  @map("mid_frame_url")
  lastFrameUrl     String?  @map("last_frame_url")
  firstFrameDesc   String?  @map("first_frame_desc")
  midFrameDesc     String?  @map("mid_frame_desc")
  lastFrameDesc    String?  @map("last_frame_desc")
  confirmed        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  narrative        String?  @map("narrative")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, segmentId])
  @@map("ai_video_segments")
}

model AiSegmentEdit {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  narrative        String?  @map("narrative")
  dialogue         String?  @map("dialogue")
  effects          String?  @map("effects")
  emotion          String?  @map("emotion")
  negativePrompt   String?  @map("negative_prompt")
  duration         Int?     @map("duration")
  firstFramePrompt String?  @map("first_frame_prompt")
  firstFrameNeg    String?  @map("first_frame_neg")
  midFramePrompt   String?  @map("mid_frame_prompt")
  midFrameNeg      String?  @map("mid_frame_neg")
  lastFramePrompt  String?  @map("last_frame_prompt")
  lastFrameNeg     String?  @map("last_frame_neg")
  charImageUrls    String?  @map("char_image_urls")
  sceneImageUrls   String?  @map("scene_image_urls")
  propImageUrls    String?  @map("prop_image_urls")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, segmentId])
  @@map("ai_segment_edits")
}

model AiFrameDesign {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  segmentId        String
  firstFrameDesc   String?
  firstFramePrompt String?
  firstFrameAngle  String?
  lastFrameDesc    String?
  lastFramePrompt  String?
  lastFrameAngle   String?
  confirmed        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_frame_designs")
}

model AiVideoProduction {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @unique @db.Uuid
  overallStyle         String?
  fps                  Int      @default(24)
  resolution           String   @default("1920x1080")
  colorPalette         String?
  transitionStyle      String?
  subtitleStyle        String?
  globalNegativePrompt String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_video_productions")
}

model AiEffectSpec {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  effectName        String
  effectType        String?
  triggerScene      String?
  triggerEvent      String?
  visualDescription String?
  colorPalette      String?
  duration          Float?
  intensity         String?
  notes             String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_effect_specs")
}

model AiActionSpec {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  characterName    String
  actionName       String
  triggerCondition String?
  movementDesc     String?
  facialExpression String?
  bodyLanguage     String?
  cameraFocus      String?
  duration         Float?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_action_specs")
}

model AiPropSpec {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  name           String
  category       String   @default("通用")
  description    String?
  sceneIds       Json?    @map("scene_ids")
  characterNames Json?    @map("character_names")
  imagePrompt    String?  @map("image_prompt")
  sortOrder      Int      @default(0) @map("sort_order")
  confirmed      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_prop_specs")
}

model AiCameraSpec {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  segmentId      String?
  cameraMovement String
  shotSize       String?
  angle          String?
  duration       Float?
  transition     String?
  purpose        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_camera_specs")
}

model AiEmotionSpec {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  characterName    String
  emotionType      String
  intensity        String?
  facialDesc       String?
  bodyLanguage     String?
  voiceTone        String?
  triggerEvent     String?
  timing           String?
  cameraPreference String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_emotion_specs")
}

model Storyboard {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String      @db.Uuid
  shotIndex       Int
  duration        Float?
  shotType        String?
  subject         String?
  action          String?
  expression      String?
  cameraMovement  String?
  lens            String?
  lighting        String?
  emotion         String?
  environment     String?
  cinematicStyle  String?
  colorStyle      String?
  realism         Boolean?
  motionBlur      Boolean?
  continuityNotes String?
  negativePrompt  String?
  storyboardImage String?
  startFrame      Int?
  endFrame        Int?
  createdAt       DateTime    @default(now())
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoTask       VideoTask[]

  @@index([projectId])
}

model VideoTask {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  storyboardId   String?         @db.Uuid
  status         VideoTaskStatus @default(queued)
  progress       Int             @default(0)
  error          String?
  idempotencyKey String?         @unique
  lockedBy       String?
  heartbeatAt    DateTime?
  retryCount     Int             @default(0)
  maxRetries     Int             @default(3)
  priority       Int             @default(1)
  taskType       String          @default("video")
  scheduledFor   DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  taskLogs       TaskLog[]
  segments       VideoSegment[]
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboard     Storyboard?     @relation(fields: [storyboardId], references: [id])

  @@index([projectId])
}

model VideoSegment {
  id            String    @id @default(uuid()) @db.Uuid
  taskId        String    @db.Uuid
  shotIndex     Int
  filePath      String?
  thumbnailPath String?
  duration      Float?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  task          VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ExportTask {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String
  projectId   String    @db.Uuid
  status      String    @default("queued")
  exportType  String    @default("zip")
  progress    Int       @default(0)
  outputUrl   String?
  packageSize Int?
  error       String?
  traceId     String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("export_tasks")
}

model CharacterProfile {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  name            String
  age             Int?
  gender          String?
  face            String?
  hair            String?
  clothes         String?
  body            String?
  identity        String?
  speakingStyle   String?
  personality     String?
  frontImage      String?
  sideImage       String?
  fullBodyImage   String?
  expressionImage String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SceneProfile {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  location       String?
  architecture   String?
  weather        String?
  lighting       String?
  timeOfDay      String?
  atmosphere     String?
  colorPalette   String?
  referenceImage String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// 视觉风格配置档案
/// 每种视觉风格（anime/realistic/3d/cartoon 等）定义全链路 prompt 模板 + 模型路由 + 画风参数
model StyleProfile {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  displayName       String
  icon              String   @default("🎨")
  /// 风格描述（prompt 语句块，注入各环节）
  description       String   @default("")
  /// 正面风格修饰词（追加到所有 image/video prompt 末尾）
  styleTokens       String   @default("")
  /// 负面风格修饰词（追加到所有 negative prompt 末尾）
  negativeTokens    String   @default("")
  /// 各环节的 prompt 模板覆盖（JSON）
  /// {
  /// "character": "…",
  /// "scene": "…",
  /// "storyboard": "…",
  /// "video": "…",
  /// "narrative": "…"
  /// }
  promptOverrides   Json?    @map("prompt_overrides")
  /// 推荐模型路由（JSON）
  /// {
  /// "image": { "provider": "volcengine", "model": "doubao-seedream-4-0-250828" },
  /// "video": { "provider": "volcengine", "model": "doubao-seedance-2-0-260128" },
  /// "llm": { "provider": "deepseek", "model": "deepseek-chat" }
  /// }
  modelRoutes       Json?    @map("model_routes")
  /// 画风参考图 URL（可选）
  referenceImageUrl String?  @map("reference_image_url")
  /// 额外参数（JSON）
  parameters        Json?    @default("{}")
  sortOrder         Int      @default(0)
  enabled           Boolean  @default(true)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("style_profiles")
}

model PromptTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  category    String?
  content     Json?
  variables   Json?
  createdAt   DateTime @default(now())
}

model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String?   @db.Uuid
  type      AssetType @default(other)
  fileName  String
  filePath  String
  mimeType  String?
  fileSize  Int?
  width     Int?
  height    Int?
  duration  Float?
  taskId    String?
  createdAt DateTime  @default(now())
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([taskId, type])
  @@index([projectId])
}

model Membership {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  tier           String          @default("free")
  credits        Int             @default(0)
  creditsUsed    Int             @default(0)
  storageUsed    BigInt          @default(0)
  storageLimit   BigInt          @default(524288000)
  agentLevel     String          @default("none")
  parentId       String?         @db.Uuid
  monthlyBudget  Float?
  monthlySpent   Float           @default(0)
  monthlyResetAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  coinLogs       CoinLog[]
  parent         Membership?     @relation("AgentReferral", fields: [parentId], references: [userId])
  children       Membership[]    @relation("AgentReferral")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         RechargeOrder[]
  storagePacks   StoragePack[]
  assets         UserAsset[]
}

model CoinLog {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  amount     Int
  type       String
  remark     String?
  relatedId  String?
  createdAt  DateTime   @default(now())
  membership Membership @relation(fields: [userId], references: [userId], map: "coinlog_membership_fkey")

  @@index([userId, createdAt])
}

model UserAsset {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  title              String
  type               String
  url                String
  thumbnail          String?
  prompt             String?
  style              String?
  mode               String?
  fileSize           Int              @default(0)
  isFeatured         Boolean          @default(false)
  source             String?
  modifiedBy         String?
  universeScore      Float            @default(0)
  cinematicScore     Float            @default(0)
  narrativeScore     Float            @default(0)
  emotionalScore     Float            @default(0)
  consistencyScore   Float            @default(0)
  renderQualityScore Float            @default(0)
  worldDepthScore    Float            @default(0)
  engagementScore    Float            @default(0)
  retentionScore     Float            @default(0)
  freshnessScore     Float            @default(0)
  universeClusterId  String?          @db.Uuid
  createdAt          DateTime         @default(now())
  comments           AssetComment[]
  likes              AssetLike[]
  cluster            UniverseCluster? @relation(fields: [universeClusterId], references: [id])
  membership         Membership       @relation(fields: [userId], references: [userId], map: "userasset_membership_fkey")

  @@index([userId, createdAt])
  @@index([universeScore(sort: Desc)])
  @@index([universeClusterId])
}

model UniverseCluster {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  genre           String?
  description     String?
  embeddingCenter String?
  activityScore   Float       @default(0)
  evolutionState  String      @default("active")
