  updatedAt DateTime @updatedAt
  schemaVersion Int @default(1)

  @@index([projectId])
  @@map("geo_graph_nodes")
}

model GeoGraphEdge {
  id        String   @id @default(uuid())
  sourceId  String
  targetId  String
  type      String   // contains, belongs_to, mentions, references, related_to, supports, competes_with
  properties String? // JSON

  source    GeoGraphNode @relation("outgoing", fields: [sourceId], references: [id], onDelete: Cascade)
  target    GeoGraphNode @relation("incoming", fields: [targetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  schemaVersion Int @default(1)

  @@index([sourceId])
  @@index([targetId])
  @@map("geo_graph_edges")
}

// ===== Unified Asset Runtime (Platform Level) =====

model UnifiedAsset {
  id        String   @id @default(uuid())
  projectId String
  type      String
  title     String
  language  String   @default("zh")
  source    String?  // scanner, import, manual, api
  sourceUrl String?
  content   String?  // plain text content
  summary   String?  // AI summary (optional)
  metadata  String?  // JSON - extensible metadata
  hash      String?  // SHA256 for dedup
  status    String   @default("draft") // draft, published, archived
  schemaVersion Int  @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  versions  UnifiedAssetVersion[]
  tags      UnifiedAssetTag[]
  relationsFrom UnifiedAssetRelation[] @relation("fromAsset")
  relationsTo   UnifiedAssetRelation[] @relation("toAsset")

  @@index([projectId])
  @@index([projectId, type])
  @@index([hash])
  @@map("unified_assets")
}

model UnifiedAssetVersion {
  id        String        @id @default(uuid())
  assetId   String
  version   Int
  content   String?
  hash      String?
  createdAt DateTime      @default(now())
  asset     UnifiedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@map("unified_asset_versions")
}

model UnifiedAssetTag {
  id      String       @id @default(uuid())
  assetId String
  tag     String
  asset   UnifiedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, tag])
  @@map("unified_asset_tags")
}

model UnifiedAssetRelation {
  id          String       @id @default(uuid())
  fromAssetId String
  toAssetId   String
  relation    String // depends_on, references, related_to, derived_from, etc.
  fromAsset   UnifiedAsset @relation("fromAsset", fields: [fromAssetId], references: [id], onDelete: Cascade)
  toAsset     UnifiedAsset @relation("toAsset", fields: [toAssetId], references: [id], onDelete: Cascade)

  @@index([fromAssetId])
  @@index([toAssetId])
  @@map("unified_asset_relations")
}

model RawDocument {
  id        String   @id @default(uuid())
  projectId String
  url       String
  mime      String?
  headers   String?  // JSON
  html      String?
  markdown  String?
  text      String?
  status    Int      @default(0)
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("raw_documents")
}

// ===== Unified Semantic Runtime (Platform Level) =====

model SemanticEntity {
  id          String   @id @default(uuid())
  projectId   String
  assetId     String?
  type        String   // Brand, Company, Organization, Person, Product, Service, Feature, etc.
  name        String   // Canonical name
  description String?
  confidence  Float    @default(0.0)
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  aliases         SemanticAlias[]
  topics          SemanticEntityTopic[]
  sourceKeywords  SemanticKeyword[]
}

model SemanticTopic {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  confidence  Float    @default(0.0)
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities    SemanticEntityTopic[]
}

model SemanticEntityTopic {
  entityId String
  topicId  String
  entity   SemanticEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  topic    SemanticTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([entityId, topicId])
}

model SemanticRelation {
  id          String   @id @default(uuid())
  projectId   String
  fromEntityId String?
  fromTopicId  String?
  toEntityId   String?
  toTopicId    String?
  relation    String   // is_a, part_of, related_to, belongs_to, mentions, references, etc.
  confidence  Float    @default(0.0)
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
}

model SemanticAlias {
  id        String   @id @default(uuid())
  entityId  String
  alias     String
  language  String   @default("zh")
  confidence Float   @default(1.0)
  entity    SemanticEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, alias])
}

model SemanticTaxonomy {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  parentId    String?  // Self-referencing for hierarchy
  description String?
  path        String?  // Materialized path: "AI/Video/Generation"
  depth       Int      @default(0)
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    SemanticTaxonomy? @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children  SemanticTaxonomy[] @relation("TaxonomyHierarchy")
}

model SemanticKeyword {
  id          String   @id @default(uuid())
  projectId   String
  keyword     String
  entityId    String?  // Associated entity
  language    String   @default("zh")
  confidence  Float    @default(0.0)
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  entity      SemanticEntity? @relation(fields: [entityId], references: [id])
}

// ===== Goal Runtime (Platform Level) =====

model Goal {
  id             String    @id @default(uuid())
  projectId      String
  title          String
  description    String?
  successCriteria String?  // JSON array of criteria
  targetMetric   String?   // e.g., "visibility_score > 80"
  deadline       DateTime?
  priority       Int       @default(3)  // 1=high, 2=medium, 3=low
  status         String    @default("draft") // draft, active, paused, completed, cancelled
  metadata       String?   // JSON
  schemaVersion  Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  strategies    Strategy[]
  tasks         Task[]
}

model Strategy {
  id            String    @id @default(uuid())
  goalId        String
  name          String
  description   String?
  type          String    // content, entity, citation, authority, visibility, etc.
  status        String    @default("draft") // draft, active, completed, cancelled
  priority      Int       @default(3)
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goal          Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  workflows     Workflow[]
  tasks         Task[]
}

model Workflow {
  id            String    @id @default(uuid())
  strategyId    String
  name          String
  description   String?
  status        String    @default("draft")
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  strategy      Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  stages        WorkflowStage[]
  tasks         Task[]
}

model WorkflowStage {
  id            String    @id @default(uuid())
  workflowId    String
  name          String
  order         Int
  status        String    @default("pending")
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())

  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks         Task[]
}

model Task {
  id            String    @id @default(uuid())
  goalId        String?
  strategyId    String?
  workflowId    String?
  stageId       String?
  title         String
  description   String?
  actionType    String    // The registered Action type
  priority      Int       @default(3)
  dependencies  String?   // JSON array of task IDs
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  deadline      DateTime?
  status        String    @default("pending") // pending, ready, running, completed, failed, cancelled
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  goal          Goal?     @relation(fields: [goalId], references: [id])
  strategy      Strategy? @relation(fields: [strategyId], references: [id])
  workflow      Workflow? @relation(fields: [workflowId], references: [id])
  stage         WorkflowStage? @relation(fields: [stageId], references: [id])
  executions    Execution[]
}

model Action {
  id            String    @id @default(uuid())
  name          String    @unique   // e.g., "GenerateFAQ", "PublishCMS"
  description   String?
  provider      String    // internal, llm, api, webhook
  config        String?   // JSON configuration schema
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Execution {
  id            String    @id @default(uuid())
  taskId        String
  actionType    String
  status        String    @default("running") // pending, running, completed, failed, cancelled
  input         String?   // JSON
  output        String?   // JSON
  error         String?
  durationMs    Int?
  retryAttempt  Int       @default(0)
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  results       ExecutionResult[]
  reviews       Review[]
}

model ExecutionResult {
  id            String    @id @default(uuid())
  executionId   String
  assetId       String?
  type          String    // created, updated, deleted, skipped, error
  summary       String?
  details       String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())

  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model Review {
  id            String    @id @default(uuid())
  executionId   String
  status        String    @default("pending") // pending, approved, rejected, needs_revision
  comments      String?
  score         Float?
  metadata      String?   // JSON
  schemaVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

// ===== Capability Platform =====

model CapabilityContract {
  id                String   @id @default(uuid())
  name              String   @unique  // e.g., "GenerateFAQ", "ExtractEntity"
  displayName       String
  description       String?
  category          String   // Generation, Analysis, Extraction, Transformation, Publishing, etc.
  version           String   @default("1.0.0")
  inputSchema       String?  // JSON Schema
  outputSchema      String?  // JSON Schema
  constraints       String?  // JSON - maxTimeout, maxRetries, idempotent, streaming, etc.
  qualityProfile    String?  // JSON - expected quality metrics
  permissionProfile String?  // JSON - required permissions
  tags              String?  // JSON array
  status            String   @default("active") // active, deprecated, removed
  metadata          String?  // JSON
  schemaVersion     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerMappings  CapabilityProviderMapping[]
}

model CapabilityProviderMapping {
  id             String   @id @default(uuid())
  capabilityId   String
  provider       String   // e.g., "openai", "deepseek", "claude" (reserved for Provider Runtime)
  priority       Int      @default(0)
  config         String?  // JSON provider-specific config
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  capability     CapabilityContract @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([capabilityId, provider])
}

// ===== AI Resource Runtime (KMKI-PLAT-008) =====

model ResourceContract {
  id             String   @id @default(uuid())
  name           String   @unique
  type           String
  vendor         String
  description    String?
  capabilities   String?
  models         String?
  endpoints      String?
  authentication String?
  pricing        String?
  limits         String?
  metadata       String?
  schemaVersion  Int      @default(1)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  credentials    ResourceCredential[]
  healthRecords  ResourceHealth[]
  capabilityMatrix ResourceCapabilityMatrix[]
  costRecords    ResourceCost[]
}

// ProviderRegistry — 模型能力注册表（DB 表 provider_registry，Prisma 模型补齐）
// Sprint-ADMIN-IA-REALITY-03 T02: credential-resolver 依赖此模型，补齐消除 (prisma as any) 运行时 undefined
model ProviderRegistry {
  id          String   @id @default(uuid()) @db.Uuid
  capability  String
  vendor      String
  modelFamily String?  @map("model_family")
  baseUrl     String?  @map("base_url")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("provider_registry")
}

// CredentialVault — 凭据保险库（DB 表 credential_vault，Prisma 模型补齐）
// Sprint-ADMIN-IA-REALITY-03 T02: credential-resolver / vault-service 依赖此模型
model CredentialVault {
  id               String   @id @default(uuid()) @db.Uuid
  ownerType        String   @map("owner_type")
  ownerId          String   @map("owner_id") @db.Uuid
  capability       String
  encryptedPayload String   @map("encrypted_payload")
  metadata         Json?
  status           String   @default("active")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid

  @@index([capability, status])
  @@index([ownerType, ownerId])
  @@map("credential_vault")
}

model ResourceCredential {
  id             String   @id @default(uuid())
  resourceId     String
  tenantId       String
  workspaceId    String?
  name           String
  encryptedKey   String
  endpoint       String?
  models         String?
  status         String   @default("active")
  rotationPolicy String?
  lastRotated    DateTime?
  expiresAt      DateTime?
  metadata       String?
  schemaVersion  Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resource      ResourceContract @relation(fields: [resourceId], references: [id])
  usageRecords  ResourceUsage[]
  @@unique([resourceId, tenantId, workspaceId])
}

model ResourceHealth {
  id                 String   @id @default(uuid())
  resourceId         String
  credentialId       String?
  status             String
  latencyMs          Float?
  errorRate          Float?
  rateLimitRemaining Int?
  quotaRemaining     Int?
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  failureReason      String?
  metadata           String?
  checkedAt          DateTime @default(now())

  resource ResourceContract @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model ResourceCapabilityMatrix {
  id             String   @id @default(uuid())
  resourceId     String
  capabilityId   String
  supported      Boolean  @default(false)
  qualityScore   Float?
  costMultiplier Float?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resource ResourceContract @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@unique([resourceId, capabilityId])
}

model ResourceUsage {
  id               String   @id @default(uuid())
  credentialId     String
  tenantId         String
  workspaceId      String?
  resourceType     String
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  estimatedCost    Float?
  actualCost       Float?
  currency         String   @default("USD")
  status           String
  executionId      String?
  metadata         String?
  createdAt        DateTime @default(now())

  credential ResourceCredential @relation(fields: [credentialId], references: [id])
}

model ResourceCost {
  id            String   @id @default(uuid())
  resourceId    String
  tenantId      String
  workspaceId   String?
  billingPeriod String
  totalCost     Float
  currency      String   @default("USD")
  metadata      String?
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resource ResourceContract @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@unique([resourceId, tenantId, workspaceId, billingPeriod, periodStart])
}

// ===== Workspace Runtime (KMKI-PLAT-009) =====

model WorkspaceRuntime {
  id          String   @id @default(uuid())
  type        String   // short_drama, novel, ppt, geo
  tenantId    String
  name        String
  description String?
  status      String   @default("active") // active, archived, published
  runtimeState String? // JSON — current runtime state for resume
  manifest    String?  // JSON — full dependency manifest
  settings    String?  // JSON — workspace settings
  metadata    String?  // JSON
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activatedAt DateTime?
  archivedAt  DateTime?

  snapshots       WorkspaceSnapshot[]
  versions        WorkspaceVersion[]
  drafts          WorkspaceDraft[]
  operations      WorkspaceOperation[]
  assets          WorkspaceAsset[]
  conversations   WorkspaceConversation[]
  checkpoints     WorkspaceCheckpoint[]
  executions      WorkspaceExecution[]

  @@map("workspace_runtime")
}

model WorkspaceSnapshot {
  id           String   @id @default(uuid())
  workspaceId  String
  version      Int
  label        String?  // user label for this snapshot
  runtimeState String?  // JSON — serialized workspace runtime state
  assetState   String?  // JSON — asset references
  graphState   String?  // JSON — execution graph state
  variables    String?  // JSON — workspace variables
  metadata     String?  // JSON
  createdAt    DateTime @default(now())
  autoSave     Boolean  @default(false)

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, version])
}

model WorkspaceVersion {
  id           String   @id @default(uuid())
  workspaceId  String
  version      Int
  label        String   // v1, v2, published-20250629
  description  String?
  snapshotId   String?  // link to the snapshot for restore
  published    Boolean  @default(false)
  parentVersion Int?    // for fork/branch history
  metadata     String?  // JSON
  createdAt    DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, version])
}

model WorkspaceDraft {
  id          String   @id @default(uuid())
  workspaceId String
  draftNumber Int
  contentState String? // JSON — workspace content at draft time
  runtimeState String? // JSON — runtime state
  autoSave    Boolean  @default(false)
  createdAt   DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, draftNumber])
}

model WorkspaceOperation {
  id          String   @id @default(uuid())
  workspaceId String
  type        String   // create, update, delete, restore, publish, archive, execute
  target      String?  // what was operated on (snapshot, version, asset, etc.)
  targetId    String?
  description String?
  diff        String?  // JSON — operation diff for undo
  reverseDiff String?  // JSON — inverse operation for redo
  userId      String?  // who performed the operation
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceAsset {
  id          String   @id @default(uuid())
  workspaceId String
  type        String   // image, video, audio, script, prompt, pdf, doc, json, output
  path        String
  mimeType    String?
  size        Int?
  hash        String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceConversation {
  id          String   @id @default(uuid())
  workspaceId String
  sessionId   String
  role        String   // user, assistant, system
  content     String   // message content
  context     String?  // JSON — AI context
  summary     String?  // conversation summary
  tokenCount  Int?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceCheckpoint {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  snapshotId  String?  // link to snapshot
  versionId   String?  // link to version
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceExecution {
  id           String   @id @default(uuid())
  workspaceId  String
  executionId  String   // link to ExecutionPlan
  planVersion  String
  status       String   // pending, running, completed, failed, cancelled
  result       String?  // JSON — execution result
  runtimeState String?  // JSON — runtime state at execution time
  metadata     String?  // JSON
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  runtime WorkspaceRuntime @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ===== Agent Runtime (KMKI-PLAT-010) =====

model AgentDefinition {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  version         String
  description     String?
  capabilities    String   // JSON — capability names this agent can handle
  supportedResources String? // JSON — resource types this agent can use
  inputSchema     String?  // JSON
  outputSchema    String?  // JSON
  executionMode   String   // sync, async, streaming
  permissions     String?  // JSON — required permissions
  category        String?  // official, enterprise, private
  status          String   @default("active") // active, deprecated, disabled
  metadata        String?  // JSON
  schemaVersion   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        AgentSession[]
  queues          AgentQueue[]
  agentPerms     AgentPermission[]

  @@map("agent_definition")
}

model AgentSession {
  id             String   @id @default(uuid())
  workspaceId    String
  agentId        String
  sessionType    String   // manual, scheduled, workflow, dispatch
  status         String   // pending, planning, executing, streaming, paused, completed, failed, cancelled
  input          String?  // JSON
  output         String?  // JSON
  runtimeState   String?  // JSON — for resume
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  executedBy     String?  // userId or agentId (for collaboration)
  metadata       String?  // JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent          AgentDefinition @relation(fields: [agentId], references: [id])
  stepExecutions AgentStepExecution[]
  events         AgentEvent[]
  artifactOutputs      AgentArtifact[]

  @@map("agent_session")
}

model AgentStepExecution {
  id             String   @id @default(uuid())
  sessionId      String
  stepName       String
  planId         String   // link to ExecutionPlan
  executionId    String   // link to ExecutionRuntime execution
  capability     String
  status         String   // pending, running, completed, failed, skipped
  input          String?  // JSON
  output         String?  // JSON
  cost           Float?
  tokenCount     Int?
  latencyMs      Int?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_step_execution")
}

model AgentEvent {
  id             String   @id @default(uuid())
  sessionId      String
  type           String   // planning, executing, streaming, completed, failed, paused, resumed, cancelled, toolCalled
  data           String?  // JSON
  timestamp      DateTime @default(now())

  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_event")
}

model AgentContextMemory {
  id             String   @id @default(uuid())
  sessionId      String
  type           String   // shortTerm, workspace, knowledge, summary
  content        String   // JSON
  relevanceScore Float?   // 0-1
  ttl            Int?     // time-to-live in seconds
  metadata       String?  // JSON
  createdAt      DateTime @default(now())
  expiresAt      DateTime?

  @@map("agent_context_memory")
}

model AgentQueue {
  id             String   @id @default(uuid())
  agentId        String
  workspaceId    String
  priority       Int      @default(0)
  status         String   // queued, running, completed, failed
  input          String?  // JSON
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  agent          AgentDefinition @relation(fields: [agentId], references: [id])

  @@map("agent_queue")
}

model AgentPermission {
