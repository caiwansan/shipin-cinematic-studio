  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, provider, model])
  @@index([organizationId, enabled])
  @@map("org_model_config")
}

model ProviderCredential {
