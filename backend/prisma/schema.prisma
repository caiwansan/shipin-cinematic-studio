// Dual Write Watcher Events (Stage 3.2.1)
// 轻量事件流——Shadow Run 的对账证据链
// 不关联外键，只记录纯事件
// 后续可 truncate，不是永久存储
// ═══════════════════════════════════════════════════════════════
model DualWriteWatcherEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entity     String   // Project / GeoProjectProfile
  entityId   String   @map("entity_id") @db.Uuid
  operation  String   // CREATE / UPDATE / DELETE
  status     String   // SUCCESS / FAIL / SKIP
  latencyMs  Int      @default(0) @map("latency_ms")
  error      String?
  flags      String?  // JSON — flag snapshot at write time
  diff       String?  // JSON — before/after if relevant
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([entity, status, createdAt])
  @@map("dual_write_watcher_events")
}

