model GEOClaim {
  id          String   @id @default(uuid())
  entityId    String
  tenantId    String?  @db.Uuid
  text        String
  claimType   String   @default("fact")        // primary, derived, opinion, fact, hypothesis
  confidence  Float    @default(0.0)
  sourceType  String   @default("llm_extracted")
  status      String   @default("draft")       // draft, review, approved, rejected, stale
  provenance  Json     @default("{}")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    GEOEntity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
