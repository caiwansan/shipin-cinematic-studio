}

model BillingRecord {
  id             String   @id @default(uuid())
  tenantId       String
  type           String   // subscription, usage, overage, refund
  amount         Float
  currency       String   @default("USD")
  description    String?
  source         String   // execution, ai_resource, workflow, storage
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("governance_billing_record")
}

model AuditLog {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String?
  action         String   // login, capabilityUsed, workflowExecuted, agentDispatched, workspaceCreated, resourceConfigured, export, publish, billing, permissionChanged, adminAction
  resource       String   // what was acted upon
  resourceId     String?
  details        String?  // JSON
  ipAddress      String?
  userAgent      String?
  metadata       String?  // JSON
