model RecruitmentPipeline {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  resumeId         String?  @map("resume_id") @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  candidateName    String   @map("candidate_name")
  stage            String
  screeningScore   Int?     @map("screening_score")
  screeningNote    String?  @map("screening_note")
  interviewCount   Int      @default(0) @map("interview_count")
  lastActivityAt   DateTime @map("last_activity_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  autoCreated      Boolean  @default(false) @map("auto_created")
  offerStatus      String?  @map("offer_status")
  tags             String[]

  workspace    EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  job          JobPosting           @relation(fields: [jobId], references: [id])
  events       PipelineEvent[]
  candidateNotes CandidateNote[]
  interviewSessions InterviewSession[]
  conversation RecruitmentConversation?
  @@index([workspaceId])
  @@index([jobId])
  @@index([stage])
  @@index([workspaceId, stage])
  @@map("recruitment_pipeline")
}

model PipelineEvent {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  type       String
  fromStage  String?  @map("from_stage")
  toStage    String?  @map("to_stage")
  actor      String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  pipeline    RecruitmentPipeline @relation(fields: [pipelineId], references: [id])
  @@index([pipelineId])
  @@index([pipelineId, createdAt])
  @@map("pipeline_event")
}

model JobPosting {
  id                String   @id @default(uuid()) @db.Uuid
  enterpriseId      String   @map("enterpriseId") @db.Uuid
  title             String
  salary            String?
  location          String?
  description       String?
  requirements      String?
  qualityScore      Int      @default(0) @map("quality_score")
  status            String
  careerPath        String?  @map("career_path")
  industry          String?
  promotionPath     String?  @map("promotion_path")
  relatedSkills     String[] @map("related_skills")
  skillRequirements String[] @map("skill_requirements")
  tags              String[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  enterprise         JobCompanyProfile        @relation(fields: [enterpriseId], references: [id])
  recruitmentPipelines RecruitmentPipeline[]
  interviewSessions    InterviewSession[]
  candidateMatches     CandidateMatch[]
  channelMappings      RecruitmentChannelMapping[]
  recruitmentConversations RecruitmentConversation[]
  recruitmentCampaigns RecruitmentCampaign[]
  @@index([enterpriseId])
  @@index([enterpriseId, status])
  @@index([status])
  @@map("job_posting")
}

model InterviewSession {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  pipelineId    String?   @map("pipeline_id") @db.Uuid
  jobId         String    @map("job_id") @db.Uuid
  candidateName String    @map("candidate_name")
  resumeId      String?   @map("resume_id") @db.Uuid
  interviewerId String?   @map("interviewer_id") @db.Uuid
  title         String
  status        String
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace   EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  pipeline    RecruitmentPipeline?  @relation(fields: [pipelineId], references: [id])
  job         JobPosting           @relation(fields: [jobId], references: [id])
  questions   InterviewQuestion[]
  evaluation  InterviewEvaluation?
  decision    InterviewDecision?
  notes       InterviewNote[]
  @@map("interview_session")
}

model InterviewQuestion {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  category        String
  question        String
  expectedAnswer  String?  @map("expected_answer")
  answer          String?
  score           Int?
  followUp        String?  @map("followUp")
  createdAt       DateTime @default(now()) @map("created_at")

  session     InterviewSession @relation(fields: [sessionId], references: [id])
  @@map("interview_question")
}

model InterviewEvaluation {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @unique @map("session_id") @db.Uuid
  overallScore      Int      @map("overall_score")
  technicalScore    Int      @map("technical_score")
  communicationScore Int     @map("communication_score")
  cultureScore      Int      @map("culture_score")
  strengths         String[]
  risks             String[]
  recommendation    String
  summary           String
  nextSteps         String[] @map("nextSteps")
  createdAt         DateTime @default(now()) @map("created_at")

  session     InterviewSession @relation(fields: [sessionId], references: [id])
  @@map("interview_evaluation")
}

model CandidateNote {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pipeline    RecruitmentPipeline @relation(fields: [pipelineId], references: [id])
  @@map("candidate_note")
}

model CandidateMatch {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  matchScore      Int      @map("match_score")
  matchBreakdown  Json?    @map("match_breakdown")
  status          String
  aiAnalysis      String?  @map("ai_analysis")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace   EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  job         JobPosting           @relation(fields: [jobId], references: [id])
  // Sprint-SSOT-SCHEMA-CLEANUP: JobCandidate removed, candidateId kept as historical ID reference
  // candidate   CareerProfile  @relation(fields: [candidateId], references: [id])  — 待 Identity Consolidation 时启用
  interviewRecords InterviewRecord[]
  @@index([workspaceId])
  @@index([jobId])
  @@index([candidateId])
  @@index([workspaceId, jobId])
  @@map("candidate_match")
}

/// 渠道候选人（企业资产）：从招聘渠道导入/手动录入的候选人
/// 与 candidate_match 区分：candidate_match = 平台用户岗位匹配（AI 匹配引擎产物）；
/// 本表 = 企业从招聘渠道获得的候选人（渠道入口 → 昆仑镜 AI 筛选/面试/评估）
/// 设计原则：渠道产生的候选人与数据归企业 Organization（KMKI 渠道 BYOK 类比）
model EnterpriseCandidate {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  channelId       String   @map("channel_id") @db.Uuid
  jobId           String?  @map("job_id") @db.Uuid
  name            String
  phone           String?
  email           String?
  skills          String[]
  experienceYears Int      @default(0) @map("experience_years")
  summary         String?
  expectedSalary  String?  @map("expected_salary")
  status          String   @default("new") // new → screening → interviewing → hired / rejected
  aiAnalysis      String?  @map("ai_analysis") // AI 评价（企业模型生成，无企业模型时为 null，诚实显示未生成）
  importedBy      String?  @map("imported_by") @db.Uuid
  importedAt      DateTime @default(now()) @map("imported_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  channel RecruitmentChannel @relation(fields: [channelId], references: [id])
  @@index([organizationId])
  @@index([channelId])
  @@index([organizationId, status])
  @@map("enterprise_candidate")
}

model RecruitmentChannel {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String
  description String?
  enabled     Boolean?
  sortOrder   Int?     @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  mappings    RecruitmentChannelMapping[]
  publishingTasks PublishingTask[]
  enterpriseCandidates EnterpriseCandidate[]
  @@map("recruitment_channel")
}

model RecruitmentChannelMapping {
  id           String   @id @default(uuid()) @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  channelId    String   @map("channel_id") @db.Uuid
  channelJobId String?  @map("channel_job_id")
  status       String?
  createdAt    DateTime @default(now()) @map("created_at")

  channel     RecruitmentChannel @relation(fields: [channelId], references: [id])
  job         JobPosting        @relation(fields: [jobId], references: [id])
  @@map("recruitment_channel_mapping")
}

model InterviewRecord {
  id           String    @id @default(uuid()) @db.Uuid
  matchId      String    @map("match_id") @db.Uuid
  round        Int
  scheduledAt  DateTime? @map("scheduled_at")
  status       String
  interviewer  String?
  feedback     String?
  rating       Int?
  aiSummary    String?   @map("ai_summary")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  match       CandidateMatch @relation(fields: [matchId], references: [id])
  @@map("interview_record")
}

model InterviewDecision {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @map("session_id") @db.Uuid
  decision  String
  reason    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  session     InterviewSession @relation(fields: [sessionId], references: [id])
  @@map("interview_decision")
}

model InterviewNote {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  content   String
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session     InterviewSession @relation(fields: [sessionId], references: [id])
  @@map("interview_note")
}

// ============================================================
// Sprint-08B: Recruitment Conversation Domain
// ============================================================

/// 招聘会话 — 整个招聘过程的主对象
/// Ownership: 由 Enterprise Recruiter Agent 创建和持有
model RecruitmentConversation {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  enterpriseId      String    @map("enterprise_id") @db.Uuid

  // ── 关联对象 ──
  jobPostingId      String?   @map("job_posting_id") @db.Uuid
  candidateId       String?   @map("candidate_id") @db.Uuid
  pipelineId        String?   @unique @map("pipeline_id") @db.Uuid
  recruiterAgentId  String    @map("recruiter_agent_id") @db.Uuid

  // ── 状态机 ──
  status            String    @default("DISCOVERED")
  stage             String    @default("discovered")

  // ── AI 评估 ──
  matchScore        Int?      @map("match_score")
  briefSnapshotId   String?   @map("brief_snapshot_id") @db.Uuid

  // ── HR 审核 ──
  reviewPriority    Int       @default(0) @map("review_priority")
  reviewSubmittedAt DateTime? @map("review_submitted_at")
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewDecision    String?   @map("review_decision")
  reviewNote        String?   @map("review_note")

  // ── 时间戳 ──
  invitedAt         DateTime? @map("invited_at")
  chattingStartedAt DateTime? @map("chatting_started_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // ── Relations ──
  workspace         EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  jobPosting        JobPosting?           @relation(fields: [jobPostingId], references: [id])
  pipeline          RecruitmentPipeline?  @relation(fields: [pipelineId], references: [id])
  messages          ConversationMessage[]
  briefs            CandidateBrief[]
  humanReview       HumanReviewItem?

  @@index([workspaceId, status])
  @@index([enterpriseId, status])
  @@index([recruiterAgentId])
  @@index([status, reviewPriority(sort: Desc)])
  @@map("recruitment_conversation")
}

/// 会话消息 — Conversation 的子对象
model ConversationMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  role            String
  content         String
  tokenCount      Int       @default(0) @map("token_count")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation    RecruitmentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_message")
}

/// Candidate Brief — 持续更新的候选人画像
model CandidateBrief {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid

  // ── 结构化画像 ──
  candidateName   String?   @map("candidate_name")
  skills          String[]  @default([])
  experience      String?
  experienceYears Int?      @map("experience_years")
  education       String?
  city            String?
  salaryMin       Int?      @map("salary_min")
  salaryMax       Int?      @map("salary_max")

  // ── AI 评估维度 ──
  skillMatch      Int?      @map("skill_match")
  cultureFit      Int?      @map("culture_fit")
  stabilityScore  Int?      @map("stability_score")
  growthPotential Int?      @map("growth_potential")
  overallScore    Int?      @map("overall_score")

  // ── 风险与优势 ──
  strengths       String[]  @default([])
  risks           String[]  @default([])
  redFlags        String[]  @default([]) @map("red_flags")

  // ── AI 总结 ──
  aiSummary       String?   @map("ai_summary")
  jobUnderstanding String?  @map("job_understanding")
  communicationScore Int?   @map("communication_score")

  // ── 版本控制 ──
  version         Int       @default(1)
  changeSummary   String?   @map("change_summary")
  sourceMessageIds String[] @default([]) @map("source_message_ids")

  // ── 时间戳 ──
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  conversation    RecruitmentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, version(sort: Desc)])
  @@map("candidate_brief")
}

/// Human Review — 等待人工审核的队列项
model HumanReviewItem {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @unique @map("conversation_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  enterpriseId      String    @map("enterprise_id") @db.Uuid

  // ── 审核内容 ──
  candidateName     String?   @map("candidate_name")
  jobTitle          String?   @map("job_title")
  matchScore        Int?      @map("match_score")
  overallScore      Int?      @map("overall_score")
  briefSummary      String?   @map("brief_summary")
  aiRecommendation  String    @map("ai_recommendation")
  priority          Int       @default(2)

  // ── 审核状态 ──
  status            String    @default("pending")
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  decision          String?
  reviewNote        String?   @map("review_note")

  // ── 时间戳 ──
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  conversation      RecruitmentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, priority(sort: Desc)])
  @@index([enterpriseId, status])
  @@map("human_review_item")
}

// ============================================================
// Sprint-08C: Recruitment Campaign Domain
// ============================================================

/// 招聘营销活动 — AI 宣发官的核心工作对象
/// Campaign = 一个岗位的一次营销行动
/// 包含：文案、图片、发布计划、统计
model RecruitmentCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  enterpriseId      String    @map("enterprise_id") @db.Uuid

  // ── 关联对象 ──
  jobPostingId      String    @map("job_posting_id") @db.Uuid
  marketingAgentId  String    @map("marketing_agent_id") @db.Uuid // EnterpriseAgentWorkforce.id

  // ── 基本信息 ──
  title             String
  description       String?
  status            String    @default("draft")
  /// draft → generating → pending_review → approved → publishing → published → paused → closed

  // ── AI 生成内容 ──
  promotionalText   String?   @map("promotional_text") // 宣传文案
  promotionalImageId String?  @map("promotional_image_id") @db.Uuid // 关联图片素材
  aiGeneratedContent Json?    @map("ai_generated_content") // { headline, body, hashtags, callToAction }

  // ── 发布配置 ──
  targetChannelIds  String[]  @default([]) @map("target_channel_ids") // 目标渠道 ID 列表
  scheduledAt       DateTime? @map("scheduled_at") // 计划发布时间

  // ── 审核 ──
  reviewStatus      String    @default("pending") @map("review_status")
  /// pending | approved | rejected | needs_revision
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  reviewNote        String?   @map("review_note")

  // ── 统计 ──
  viewCount         Int       @default(0) @map("view_count")
  clickCount        Int       @default(0) @map("click_count")
  applicationCount  Int       @default(0) @map("application_count")

  // ── 时间戳 ──
  publishedAt       DateTime? @map("published_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // ── Relations ──
  workspace         EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  jobPosting        JobPosting           @relation(fields: [jobPostingId], references: [id])
  publishingTasks   PublishingTask[]

  @@index([workspaceId, status])
  @@index([enterpriseId, status])
  @@index([jobPostingId])
  @@index([marketingAgentId])
  @@map("recruitment_campaign")
}

/// 发布任务 — Campaign 的子对象，每个 Channel 一个 Task
/// Campaign → PublishingTask → Channel Adapter
model PublishingTask {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  channelId       String    @map("channel_id") @db.Uuid // RecruitmentChannel.id

  // ── 发布内容（从 Campaign 快照） ──
  content         String    // 实际发布的文案
  imageUrl        String?   @map("image_url")
  externalJobId   String?   @map("external_job_id") // 外部平台返回的职位 ID

  // ── 状态 ──
  status          String    @default("pending")
  /// pending → scheduled → publishing → published | failed | cancelled

  // ── 执行记录 ──
  scheduledAt     DateTime? @map("scheduled_at")
  publishedAt     DateTime? @map("published_at")
  failedAt        DateTime? @map("failed_at")
  failReason      String?   @map("fail_reason")
  retryCount      Int       @default(0) @map("retry_count")

  // ── 统计 ──
  viewCount       Int       @default(0) @map("view_count")
  clickCount      Int       @default(0) @map("click_count")
  applicationCount Int      @default(0) @map("application_count")

  // ── 时间戳 ──
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // ── Relations ──
  campaign        RecruitmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel         RecruitmentChannel  @relation(fields: [channelId], references: [id])

  @@index([campaignId, status])
  @@index([channelId])
  @@index([status, scheduledAt])
  @@map("publishing_task")
}

// ============================================================
// P3 Candidate Domain v1.0 — FROZEN 2026-07-25
// 人才资产领域：Career Profile / CandidateResume / Candidate Card / Skill Graph / Career Timeline
// 设计文档：docs/product/candidate-domain/CANDIDATE_DOMAIN_V1.md
// ============================================================

/// Career Profile：唯一真实档案（SSOT）
/// 一个 User 终身只有一份 Career Profile
/// 设计原则：DP-P3-01 SSOT · DP-P3-05 唯一档案
model CareerProfile {
  id                 String   @id @default(uuid()) @map("id") @db.Uuid
  candidateId        String   @unique @map("candidate_id") @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid

  // ── 基本信息 ──
  fullName           String   @map("full_name")
  headline           String?  @map("headline")
  bio                String?  @map("bio")
  avatarUrl          String?  @map("avatar_url")

  // ── 联系信息（私有）──
  email              String?  @map("email")
  phone              String?  @map("phone")
  city               String?  @map("city")
  country            String?  @default("CN") @map("country")

  // ── 职业方向 ──
  careerDirection    String?  @map("career_direction")
  industry           String?  @map("industry")
  yearsExperience    Int      @default(0) @map("years_experience")
  currentLevel       String?  @map("current_level")

  // ── 求职状态 ──
  jobSeekingStatus   String   @default("not_looking") @map("job_seeking_status")
  openToOpportunity  Boolean  @default(false) @map("open_to_opportunity")

  // ── 可见性 ──
  visibility         String   @default("private") @map("visibility")

  // ── 元数据 ──
  completionScore    Int      @default(0) @map("completion_score")
  dataQualityStatus  String   @default("valid") @map("data_quality_status") @db.VarChar(32)
  lastActiveAt       DateTime @default(now()) @map("last_active_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences    WorkExperience[]
  educations         Education[]
  skills             CandidateSkill[]
  resumes            CandidateResume[]
  candidateCard      CandidateCard?
  timelineEvents     CareerTimelineEvent[]

  @@index([candidateId])
  @@index([jobSeekingStatus])
  @@index([visibility])
  @@map("career_profile")
}

/// Work Experience：工作经历
/// 属于 Career Profile 的事实数据，AI 不可自动修改（DP-P3-06）
model WorkExperience {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid

  company         String   @map("company")
  title           String   @map("title")
  department      String?  @map("department")
  employmentType  String?  @map("employment_type")
  startDate       DateTime @map("start_date")
  endDate         DateTime? @map("end_date")
  isCurrent       Boolean  @default(false) @map("is_current")
  location        String?  @map("location")
  description     String?  @map("description")
  achievements    String[] @map("achievements")
  skillsUsed      String[] @map("skills_used")

  // ── 来源与验证 ──
  source          String   @default("user") @map("source")
  verified        Boolean  @default(false) @map("verified")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([startDate])
  @@map("work_experience")
}

/// Education：教育经历
/// 属于 Career Profile 的事实数据，AI 不可自动修改（DP-P3-06）
model Education {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid

  school          String   @map("school")
  degree          String?  @map("degree")
  major           String?  @map("major")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  gpa             Float?   @map("gpa")
  description     String?  @map("description")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education")
}

/// CandidateResume：Career Profile 的派生视图
/// 一份档案可生成多份简历（多语言/多岗位方向）
/// 设计原则：DP-P3-01 Resume = Career Profile 的视图
/// 与已有企业侧 Resume 模型共存，通过 candidate_resume 表名区分
model CandidateResume {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid

  // ── 简历元信息 ──
  name            String   @map("name")
  language        String   @default("zh") @map("language")
  targetRole      String?  @map("target_role")
  version         Int      @default(1) @map("version")

  // ── 内容（从 Career Profile 派生的结构化数据）──
  contentJson     Json     @map("content_json")

  // ── 生成方式 ──
  generatedBy     String   @default("user") @map("generated_by")
  sourceResumeId  String?  @map("source_resume_id") @db.Uuid

  // ── 文件 ──
  fileUrl         String?  @map("file_url")
  fileFormat      String?  @map("file_format")

  // ── 状态 ──
  isDefault       Boolean  @default(false) @map("is_default")
  status          String   @default("active") @map("status")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceResume    CandidateResume?  @relation("ResumeDerivation", fields: [sourceResumeId], references: [id])
  derivedResumes  CandidateResume[] @relation("ResumeDerivation")

  @@index([profileId])
  @@index([status])
  @@map("candidate_resume")
}

/// Candidate Card：企业看到的公开投影
/// 不是 Career Profile 的 Copy，而是 Projection
/// 设计原则：DP-P3-02 默认最小公开
model CandidateCard {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @unique @map("profile_id") @db.Uuid

  // ── 公开摘要 ──
  headline        String?  @map("headline")
  summary         String?  @map("summary")
  skillTags       String[] @map("skill_tags")
  yearsExperience Int      @default(0) @map("years_experience")
  currentCity     String?  @map("current_city")
  currentCompany  String?  @map("current_company")
  currentTitle    String?  @map("current_title")

  // ── 匹配信号 ──
  openToOpportunity Boolean @default(false) @map("open_to_opportunity")

  // ── 可见性控制 ──
  visibility      String   @default("private") @map("visibility")
  hiddenFields    String[] @map("hidden_fields")

  // ── AI 摘要 ──
  aiSummary       String?  @map("ai_summary")
  aiSummaryAt     DateTime? @map("ai_summary_at")

  // ── 浏览统计 ──
  viewCount       Int      @default(0) @map("view_count")
  lastViewedAt    DateTime? @map("last_viewed_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([visibility])
  @@map("candidate_card")
}

/// Skill：标准化技能词表
/// 统一管理技能名称，避免 "Go" 和 "golang" 被当作两个技能
model Skill {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  name            String   @unique @map("name")
  category        String?  @map("category")
  aliases         String[] @map("aliases")

  createdAt       DateTime @default(now()) @map("created_at")

  // ── Relations ──
  candidateSkills CandidateSkill[]

  @@index([category])
  @@map("skill")
}

/// CandidateSkill：人才与技能的关联（含 Level / Confidence）
/// 设计原则：DP-P3-03 可成长但证据不可篡改
model CandidateSkill {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid
  skillId         String   @map("skill_id") @db.Uuid

  // ── 技能评估 ──
  level           String   @default("beginner") @map("level")
  confidence      Float    @default(0.0) @map("confidence")

  // ── 来源 ──
  source          String   @default("user") @map("source")

  // ── 时间追踪 ──
  lastAssessedAt  DateTime @default(now()) @map("last_assessed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidence        SkillEvidence[]

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
  @@map("candidate_skill")
}

/// SkillEvidence：技能的证据链
/// 每个 CandidateSkill 可有多条证据（工作经历/GitHub/AI Interview/证书）
/// 设计原则：DP-P3-03 每个 Skill 必须有 Evidence
model SkillEvidence {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  candidateSkillId String  @map("candidate_skill_id") @db.Uuid

  evidenceType    String   @map("evidence_type")
  refId           String?  @map("ref_id") @db.Uuid
  description     String?  @map("description")
  metadata        Json?    @map("metadata")

  createdAt       DateTime @default(now()) @map("created_at")

  // ── Relations ──
  candidateSkill  CandidateSkill @relation(fields: [candidateSkillId], references: [id], onDelete: Cascade)

  @@index([candidateSkillId])
  @@index([evidenceType])
  @@map("skill_evidence")
}

/// CareerTimelineEvent：职业成长事件流
/// Append-only，不允许 Update（DP-P3-04）
/// Correction 通过追加 Correction Event 实现，不覆盖原始事件
model CareerTimelineEvent {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid

  // ── 事件定义 ──
  eventType       String   @map("event_type")
  title           String   @map("title")
  description     String?  @map("description")
  organization    String?  @map("organization")

  // ── 时间 ──
  occurredAt      DateTime @map("occurred_at")
  granularity     String   @default("day") @map("granularity")

  // ── Correction ──
  relatedEventId  String?  @map("related_event_id") @db.Uuid

  // ── 关联 ──
  relatedSkillNames String[] @map("related_skill_names")
  metadata        Json?    @map("metadata")

  // ── 来源 ──
  source          String   @default("user") @map("source")

  // ── 不可变性：无 updatedAt ──
  createdAt       DateTime @default(now()) @map("created_at")

  // ── Relations ──
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, occurredAt])
  @@index([eventType])
  @@map("career_timeline_event")
}

// ── Sprint-09E-04 Career Action Progress ──
// 用户行动追踪，最小字段，AI 不自动修改状态
model CareerActionProgress {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid

  // ── Action 定义 ──
  actionId    String   @map("action_id")
  actionTitle String   @map("action_title")
  phase       String   @default("30days") @map("phase") // 30days | 90days | 12months

  // ── 状态 ──
  status      String   @default("pending") @map("status") // pending | doing | completed | rejected
  evidence    String?  @map("evidence") // 用户提供的完成证据

  // ── 反馈 ──
  feedback    String?  @map("feedback")
  alternativePath String? @map("alternative_path") // 用户拒绝后选择的新方向

  // ── 时间 ──
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, actionId])
  @@map("career_action_progress")
}

// ============================================================
// Job Agent Config — 求职管家 Agent 模型配置
// 平台 SaaS 服务，不走用户 BYOK
// 复用现有 ModelProvider + RouteConfig 体系
// ============================================================

/// JobAgentConfig：求职管家 Agent 的模型配置
/// 平台统一管理 API Key，不暴露给用户
model JobAgentConfig {
  id              String   @id @default(uuid()) @map("id") @db.Uuid

  // ── Agent 定义 ──
  agentType       String   @default("career_assistant") @map("agent_type")
  agentName       String   @default("求职管家") @map("agent_name")

  // ── 模型配置 ──
  provider        String   @map("provider")
  model           String   @map("model")
  apiKeyEncrypted String   @map("api_key_encrypted")
  baseUrl         String?  @map("base_url")

  // ── 提示词与参数 ──
  systemPrompt    String?  @map("system_prompt")
  temperature     Float    @default(0.7) @map("temperature")
  maxTokens       Int      @default(2000) @map("max_tokens")

  // ── 状态 ──
  enabled         Boolean  @default(true) @map("enabled")

  // ── 调用统计 ──
  totalCalls      Int      @default(0) @map("total_calls")
  totalTokens     Int      @default(0) @map("total_tokens")

  // ── 时间戳 ──
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([agentType])
  @@index([enabled])
  @@map("job_agent_config")
}

// ============================================================
// P4-01 Talent Matching Engine — 招聘智能匹配引擎
// 数据性质：Derived / Computed（非事实数据）
// 设计原则：DP-M01 事实不可篡改 · DP-M02 计算与解释分离
// ============================================================

/// JobRequirementProfile：JD 的结构化解析结果
/// 数据性质：Derived from JD
/// 不是岗位事实替代品，是匹配引擎可消费的结构化条件
model JobRequirementProfile {
  id                String   @id @default(uuid()) @map("id") @db.Uuid

  // ── 来源信息 ──
  enterpriseId      String   @map("enterprise_id") @db.Uuid
  jobTitle          String   @map("job_title")
  jobDescription    String?  @map("job_description")

  // ── 结构化要求（Derived from JD）──
  requiredSkills    Json     @map("required_skills")
  preferredSkills   Json?    @map("preferred_skills")

  experienceMin     Int      @default(0) @map("experience_min")
  experienceMax     Int?     @map("experience_max")
  educationMin      String?  @map("education_min")
  preferredMajors   String[] @map("preferred_majors")
  industries        String[]

  // ── 职位信息 ──
  employmentType    String?  @map("employment_type")
  location          String?
  remoteOption      String?  @map("remote_option")
  salaryMin         Int?     @map("salary_min")
  salaryMax         Int?     @map("salary_max")

  // ── 匹配配置 ──
  weights           Json?

  // ── 状态 ──
  status            String   @default("draft")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  matchResults      TalentMatchResult[]
  batchJobs         BatchJob[]

  @@index([enterpriseId])
  @@index([status])
  @@map("job_requirement_profile")
}

/// TalentMatchResult：一次匹配计算的结果
/// 数据性质：Computed（可重算、可删除、不影响事实数据）
model TalentMatchResult {
  id                String   @id @default(uuid()) @map("id") @db.Uuid

  // ── 关联（只读引用）──
  jobRequirementId  String   @map("job_requirement_id") @db.Uuid
  candidateId       String   @map("candidate_id") @db.Uuid
  profileId         String   @map("profile_id") @db.Uuid

  // ── 匹配分数（Computed）──
  score             Int
  breakdown         Json

  // ── 匹配详情（Computed）──
  matchedSkills     Json     @map("matched_skills")
  missingSkills     Json     @map("missing_skills")
  skillGap          Json?    @map("skill_gap")

  // ── 风险与解释 ──
  riskFlags         Json?    @map("risk_flags")
  reasoning         String?
  reasoningAt       DateTime? @map("reasoning_at")

  // ── 排序 ──
  rank              Int?
  rankingVersion    String?  @map("ranking_version")

  // ── 元数据 ──
  matchVersion      String   @default("v1") @map("match_version")
  createdAt         DateTime @default(now()) @map("created_at")

  // ── Relations ──
  jobRequirement    JobRequirementProfile @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  evidence          MatchEvidence[]
  batchJobs         BatchJob[]

  @@unique([jobRequirementId, candidateId])
  @@index([jobRequirementId, score(sort: Desc)])
  @@index([candidateId])
  @@map("talent_match_result")
}

/// MatchEvidence：匹配结论的证据链
/// 数据性质：Computed Evidence
/// 建立 Computed Data → Fact Data 的审计链
model MatchEvidence {
  id                String   @id @default(uuid()) @map("id") @db.Uuid

  matchResultId     String   @map("match_result_id") @db.Uuid

  // ── 证据内容 ──
  evidenceType      String   @map("evidence_type")
  claim             String
  sourceType        String   @map("source_type")
  sourceId          String   @map("source_id") @db.Uuid
  confidence        Float

  createdAt         DateTime @default(now()) @map("created_at")

  // ── Relations ──
  matchResult       TalentMatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)

  @@index([matchResultId])
  @@index([sourceType, sourceId])
  @@map("match_evidence")
}

/// BatchJob：批量匹配执行记录
/// 数据性质：Execution Record（非 Business Fact）
/// 职责：编排状态跟踪，不存储匹配真相
model BatchJob {
  id                String   @id @default(uuid()) @map("id") @db.Uuid

  // ── 关联 ──
  enterpriseId      String   @map("tenant_id") @db.Uuid
  jobRequirementId  String   @map("job_requirement_id") @db.Uuid

  // ── 执行状态 ──
  status            String   @default("PENDING") @db.VarChar(20)
  totalCandidates   Int      @default(0) @map("total_candidates")
  processedCount    Int      @default(0) @map("processed_count")
  matchedCount      Int      @default(0) @map("matched_count")

  // ── 排名参数 ──
  threshold         Int      @default(60)
  maxResults        Int      @default(20) @map("max_results")
  rankingVersion    String   @default("v1") @map("ranking_version")

  // ── 错误信息 ──
  errorMessage      String?  @map("error_message")

  // ── 时间戳 ──
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  jobRequirement    JobRequirementProfile @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  results           TalentMatchResult[]

  @@index([enterpriseId])
  @@index([jobRequirementId])
  @@index([status])
  @@map("batch_job")
}

/// PromptRuntimeLogger — Phase 4-A 最小运行时日志
model PromptRuntimeLog {
  id            String   @id @default(uuid()) @map("id") @db.Uuid
  promptName    String   @map("prompt_name")
  version       String   @default("v1")
  routingMode   String   @default("default") @map("routing_mode")
  contextHash   String?  @map("context_hash")
  latencyMs     Int      @map("latency_ms")
  success       Boolean  @default(true)
  responseChars Int      @default(0) @map("response_chars")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([promptName])
  @@index([createdAt])
  @@map("prompt_runtime_log")
}

// ============================================================
// Sprint 10 — AI Recruitment Director (AI 招聘主管)
// ============================================================

/// RecruitmentPlan — AI 招聘主管创建的招聘计划
/// 一个计划 = 一个完整的招聘目标拆解 + 任务编排
model RecruitmentPlan {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  enterpriseId    String   @map("enterprise_id") @db.Uuid

  // ── 招聘目标 ──
  goal            String
  positionTitle   String   @map("position_title")
  headcount       Int      @default(1)
  salaryRange     String?  @map("salary_range")
  location        String?
  description     String?

  // ── 计划状态 ──
  status          String   @default("planning")
  /// planning → executing → reviewing → completed | paused | failed

  // ── 执行摘要 ──
  summary         String?
  totalSubtasks   Int      @default(0) @map("total_subtasks")
  completedSubtasks Int    @default(0) @map("completed_subtasks")

  // ── 推荐结果 ──
  recommendedCandidates Json? @map("recommended_candidates")

  // ── 时间戳 ──
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  executedAt      DateTime? @map("executed_at")
  completedAt     DateTime? @map("completed_at")

  // ── Relations ──
  workspace       EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
  tasks           RecruitmentPlanTask[]

  @@index([workspaceId, status])
  @@index([enterpriseId])
  @@map("recruitment_plan")
}

/// RecruitmentPlanTask — 招聘计划的子任务
/// 每个子任务对应一个 AI Agent 的工作
model RecruitmentPlanTask {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  planId          String   @map("plan_id") @db.Uuid

  // ── 任务定义 ──
  agentType       String   @map("agent_type")
  taskName        String   @map("task_name")
  taskDescription String?  @map("task_description")
  sortOrder       Int      @default(0) @map("sort_order")

  // ── 任务状态 ──
  status          String   @default("pending")
  /// pending → running → completed | failed | skipped

  // ── 执行结果 ──
  result          Json?
  errorMessage    String?  @map("error_message")

  // ── 时间戳 ──
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // ── Relations ──
  plan            RecruitmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@index([planId, sortOrder])
  @@map("recruitment_plan_task")
}

/// HiringKnowledge — 企业招聘知识资产
/// 每次招聘完成后自动沉淀，让 AI 越用越懂企业
model HiringKnowledge {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  enterpriseId    String   @map("enterprise_id") @db.Uuid

  // ── 知识类型 ──
  knowledgeType   String   @map("knowledge_type")
  /// candidate_profile | interview_standard | hiring_preference | success_pattern

  // ── 知识内容 ──
  title           String
  content         String
  metadata        Json?

  // ── 来源 ──
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id")

  // ── 时间戳 ──
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  workspace       EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, knowledgeType])
  @@index([enterpriseId])
  @@map("hiring_knowledge")
}

// ============================================================
// Sprint-10 Step 3B — Career Agent Autonomous Task
// ============================================================

model CareerAgentTask {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text")) @db.Text
  agentInstanceId String    @map("agent_instance_id") @db.Text // EnterpriseAgentInstance.id
  userId          String    @map("user_id") @db.Text
  taskType        String    @map("task_type") @db.VarChar(50)  // e.g. job_watch, career_plan
  status          String    @default("pending") @db.VarChar(20) // pending | running | completed | failed
  input           String?   @db.Text    // 用户原始输入/指令
  result          String?   @db.Text    // 结构化执行结果 (JSON)
  error           String?   @db.Text    // 失败原因
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([userId, status])
  @@index([agentInstanceId, status])
  @@index([createdAt])
  @@map("career_agent_task")
}

// ============================================================
// Sprint-10C — Career Identity Profile（免费+付费共用资产）
// 以 JSON 文档为核心，不依赖关系表
// 所有用户信息只能来自用户明确表达，LLM 不可自动补全
// ============================================================

model CareerIdentityProfile {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid

  // ── 状态 ──
  status    String   @default("collecting") @map("status") @db.VarChar(32)
  // collecting | draft | completed | published

  // ── 基本身份 ──
  identity  Json     @default("{}") @map("identity")
  // { name:string|null, age:number|null, gender:string|null }

  // ── 位置 ──
  location  Json     @default("{}") @map("location")
  // { currentCity:string|null, preferredCities:string[] }

  // ── 教育 ──
  education Json     @default("{}") @map("education")
  // { degree:string|null, school:string|null, major:string|null }

  // ── 职业 ──
  career    Json     @default("{}") @map("career")
  // { currentStatus:string|null, targetPosition:string|null,
  //   targetIndustry:string|null, yearsExperience:number|null,
  //   careerDirection:string|null }

  // ── 技能 ──
  skills    Json     @default("[]") @map("skills")
  // [{ name:string, level:"beginner"|"intermediate"|"expert", evidence:string }]

  // ── 工作经历 ──
  workExperience  Json  @default("[]") @map("work_experience")
  // [{ company:string, position:string, years:number,
  //    description:string, achievements:string[] }]

  // ── 项目经验 ──
  projects  Json     @default("[]") @map("projects")
  // [{ name:string, description:string, technology:string }]

  // ── 求职偏好 ──
  jobPreference  Json  @default("{}") @map("job_preference")
  // { salary:string|null, location:string|null, remote:boolean }

  // ── 事实溯源 ──
  confirmedFacts  Json  @default("[]") @map("confirmed_facts")
  // [{ field:string, value:string, source:"user", createdAt:DateTime }]

  // ── 元数据 ──
  missingFields       String[] @default([]) @map("missing_fields")
  completionScore     Int      @default(0) @map("completion_score")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status, completionScore])
  @@map("career_identity_profiles")
}

// ============================================================
// SPRINT-IDENTITY-REALITY-01: EmployeeTemplate（旧模板体系，兼容表）
// 表已存在（手写 SQL 迁移），补 Prisma 模型使 provision 双表兼容
// 新模板权威 = AgentTemplate（05-C）；本表仅兼容旧 provision 数据
// ============================================================
model EmployeeTemplate {
  id                  String   @id @default(dbgenerated("gen_random_uuid()::text")) @db.Text
  name                String   @db.VarChar(100)
  department          String   @db.VarChar(50)
  role                String   @db.VarChar(100)
  description         String   @db.Text
  icon                String   @default("🎯") @db.VarChar(10)
  capabilities        String   @default("[]")
  defaultTools        String   @default("[]") @map("default_tools")
  defaultMemoryPolicy String   @default("business") @map("default_memory_policy") @db.VarChar(20)
  requiredChannels    String   @default("[]") @map("required_channels")
  isPublic            Boolean  @default(true) @map("is_public")
  isSystem            Boolean  @default(false) @map("is_system")
  sortOrder           Int      @default(0) @map("sort_order")
  metadata            String   @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isPublic, department])
  @@map("employee_template")
}
