// ═══════════════════════════════════════════════════════════════
// Dual Write Watcher Events (Stage 3.2.1)
// 轻量事件流——Shadow Run 的对账证据链
// 不关联外键，只记录纯事件
// 后续可 truncate，不是永久存储
// ═══════════════════════════════════════════════════════════════
model DualWriteWatcherEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entity     String   // Project / GeoProjectProfile
  entityId   String   @map("entity_id") @db.Uuid
  operation  String   // CREATE / UPDATE / DELETE
  status     String   // SUCCESS / FAIL / SKIP
  latencyMs  Int      @default(0) @map("latency_ms")
  error      String?
  flags      String?  // JSON — flag snapshot at write time
  diff       String?  // JSON — before/after if relevant
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([entity, status, createdAt])
  @@map("dual_write_watcher_events")
}

// ═══════════════════════════════════════════════════════════════
// LLM Usage History — KMKI-RUNTIME-008
// 每次 LLM 调用的 Token 消耗、延迟、成本记录
// 不关联外键，纯日志型数据，可清理
// ═══════════════════════════════════════════════════════════════
model LLMUsageRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  agent           String   // e.g. geo.entity
  provider        String   // deepseek / openai / volcengine
  model           String   // deepseek-chat / gpt-4o
  promptTokens    Int      @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  totalTokens     Int      @default(0) @map("total_tokens")
  latencyMs       Int      @default(0) @map("latency_ms")
  status          String   @default("success") // success / error
  error           String?
  cost            Float    @default(0)
  promptKey       String?  @map("prompt_key")
  promptVersion   String?  @map("prompt_version")
  traceId         String?  @map("trace_id")
  workflowId      String?  @map("workflow_id")
  executionId     String?  @map("execution_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([agent, createdAt])
  @@map("llm_usage_records")
}

// ═══════════════════════════════════════════════════════════════
