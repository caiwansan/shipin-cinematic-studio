  workspaceId     String   @map("workspace_id") @db.Uuid
  candidateName   String   @map("candidate_name")
  fileName        String   @map("file_name")
  fileUrl         String   @map("file_url")
  fileType        String   @map("file_type")
  fileSize        Int      @map("file_size")
  status          String
  fileHash        String?  @map("file_hash")
  modelName       String?  @map("model_name")
  parseDurationMs Int?     @map("parse_duration_ms")
  parseError      String?  @map("parse_error")
  parserType      String   @map("parser_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  workspace    EnterpriseJobWorkspace @relation(fields: [workspaceId], references: [id])
