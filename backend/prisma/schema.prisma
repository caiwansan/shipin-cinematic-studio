  job_company_profile JobCompanyProfile    @relation(fields: [enterprise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job_recommendation  job_recommendation[]

  @@index([status])
  @@index([enterprise_id])
  @@index([location])
  @@map("job_posting")
}

model AgentOutcome {
