// ═══════════════════════════════════════════════════════════════════════════
// 混沌珠小说工作台 — Hdz 模型（独立于昆仑镜短剧系统）
// ═══════════════════════════════════════════════════════════════════════════

model HdzProject {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String
  title             String
  genre             String?                   // 小说类型：玄幻/科幻/言情/悬疑...
  wordTarget        Int?                      // 目标总字数（0=不限）
  chapterWordTarget Int?                      // 单章目标字数
  styleDesc         String?                   // 写作风格描述
  status            String     @default("draft")  // draft / active / completed
  locks             Json       @default("{}")     // {styleLocked, outlineLocked, logicLocked}
  // 封面
  authorNickname    String?
  coverPrompt       String?   @db.Text
  coverImgUrl       String?
  masterStyle       String?                   // 选中的大师风格标识（如: wangzengqi, laoshe...）
  // 发布
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  publishWordCount  Int?

  // 图书馆管理员
  libraryReaderEnabled   Boolean   @default(false)   // 是否启用图书馆管理员自动阅读
  libraryReaderCache     Json?     @default("{}")   // [{chapterNo, title, summary}] — 近5章逐章摘要
  libraryReaderSummaries Json?     @default("{}")   // {batches: [{level, batchIndex, chapterStart, chapterEnd, summary}]} — 各层级批次小结

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions   HdzSession[]
  characters HdzCharacter[]
  factions   HdzFaction[]
  chapters   HdzChapter[]
  memories   HdzMemory[]
  styleDna   HdzStyleDna?
  agentTasks HdzAgentTask[]
  manuscripts HdzManuscript[]
  outlines   HdzOutline[]
  publishLogs HdzPublishLog[]
  entityRegistries    EntityRegistry[]
  sceneDags           SceneDag[]
  worldStates         WorldState[]
  writerAlignmentMetrics WriterAlignmentMetric[]
  plotDagEdges        PlotDagEdge[]
  characterStates     HdzCharacterState[]
  mindStates          CharacterMindState[]
  planRevisions       HdzPlanRevision[]
  storyEvents         StoryEvent[]
  masterPlan          Json?     @map("master_plan")  // 增强版 Master Plan（三幕结构+卷规划+角色弧线+伏笔系统）
  masterPlanVersion   Int       @default(0) @map("master_plan_version")  // 总规划版本号（每次更新自动递增）

  @@index([userId])
  @@map("hdz_projects")
}

model HdzSession {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String
  status    String   @default("active")  // active / paused / completed
  messages  Json     @default("[]")      // [{role, content, timestamp}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("hdz_sessions")
}

model HdzChapter {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  chapterNo   Int
  title       String?
  status      String   @default("outline")  // outline / draft / reviewed / final
  outline     String?  @db.Text             // 大纲 / 段落指导
  content     String?  @db.Text             // 正文
  wordCount   Int?                          // 字数
  summary     String?   @db.Text            // 章节摘要（上下文管理用）
  reviewNotes Json?    @default("[]")       // [{issue, severity, suggestion}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterNo])
  @@index([projectId, chapterNo])
  @@map("hdz_chapters")
}

model HdzCharacter {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  name       String
  role       String   @default("supporting")  // protagonist / antagonist / supporting / minor
  properties Json     @default("{}")           // {age, gender, appearance, personality, background, motivation}
  relations  Json?    @default("[]")           // [{target, type, description}]
  arc        String?                          // 角色弧线描述
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterStates HdzCharacterState[]
  mindStates      CharacterMindState[]

  @@index([projectId])
  @@map("hdz_characters")
}

model HdzFaction {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  type        String   @default("sect")     // sect/kingdom/company/family/gang/military/other
  description String?  @db.Text             // 组织介绍
  leaderIds   String[] @default([])         // 领导者角色ID列表
  memberIds   String[] @default([])         // 成员角色ID列表
  properties  Json?    @default("{}")       // {location, ranking, scale, culture, era}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_factions")
}

model HdzMemory {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  type      String                            // world_state / character_matrix / pending_hooks / chapter_summary / location_state / pov_tracker / timeline
  content   Json                              // 结构化记忆数据
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("hdz_memories")
}

model HdzStyleDna {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @unique @db.Uuid
  sourceText  String?  @db.Text             // 用户上传的参考文本
  fingerprint Json     @default("{}")          // 文风指纹：{sentenceLength, vocabulary, emotionPatterns, ...}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("hdz_style_dna")
}

model HdzAgentTask {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  sessionId       String?   @db.Uuid
  agentType       String                           // planner / character_agent / director / writer / reviewer
  status          String    @default("queued")      // queued / running / completed / failed / waiting_approval
  input           Json      @default("{}")          // 输入参数
  output          Json?                             // 输出结果
  approvalStatus  String?                           // pending / approved / rejected / modified
  approvalNote    String?                           // 用户修改意见
  tokenCost       Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_agent_tasks")
}

model HdzManuscript {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  title       String?
  content     Json     @default("[]")  // [{type: "paragraph"|"heading"|"dialogue"|"scene_break", content: "..."}]
  wordCount   Int      @default(0)
  sectionNo   Int      @default(0)
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sectionNo])
  @@map("hdz_manuscripts")
}

model HdzOutline {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  title       String
  content     Json     @default("[]")  // [{type: "act"|"chapter"|"section", title: "...", summary: "...", keyEvents: ["..."]}]
  status      String   @default("draft")  // draft / active / locked
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_outlines")
}

model HdzPublishLog {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  target      String                            // platform name
  status      String   @default("pending")       // pending / published / failed
  result      Json?
  createdAt   DateTime @default(now())

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_publish_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// HDZ-NOVEL-INTELLIGENCE-V2: 角色动态状态 + 大纲修订历史 + 剧情事件
// ═══════════════════════════════════════════════════════════════════════════

model HdzCharacterState {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid    @map("project_id")
  characterId     String   @db.Uuid    @map("character_id")
  chapterNo       Int      @default(0) @map("chapter_no")
  stateType       String               @map("state_type")  // HEALTH / INJURY / RELATIONSHIP / POWER / LOCATION / ITEM / MENTAL / IDENTITY
  event           String
  description     String?  @db.Text
  severity        String   @default("normal")  // low / normal / high / critical
  recoveryChapter Int?     @map("recovery_chapter")  // 预计恢复章节
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt  @map("updated_at")

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character HdzCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, characterId])
  @@index([projectId, chapterNo])
  @@map("hdz_character_states")
}

model CharacterMindState {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @db.Uuid    @map("project_id")
  characterId        String   @db.Uuid    @map("character_id")
  chapterNo          Int      @default(0) @map("chapter_no") // 快照章节（每章更新）
  fear               String?  @db.Text // 当前恐惧
  desire             String?  @db.Text // 当前欲望/执念
  belief             String?  @db.Text // 核心价值观/信念
  trauma             String?  @db.Text // 创伤记忆
  moralBoundary      String?  @db.Text @map("moral_boundary") // 道德底线
  personalityDrift   String?  @db.Text @map("personality_drift") // 性格漂移警告（如：谨慎少年→莽夫）
  summary            String?  @db.Text // 心理状态小结（每章 MENTAL 事件聚合）
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character HdzCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  @@index([projectId, chapterNo])
  @@map("character_mind_states")
}

model HdzPlanRevision {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid    @map("project_id")
  version      Int
  reason       String?  @db.Text
  planBefore   Json?               @map("plan_before")
  planAfter    Json                @map("plan_after")
  blueprint    Json?               @map("blueprint")  // Story Blueprint（AI 分析生成的结构化故事蓝图）
  diffSummary  String?  @db.Text   @map("diff_summary")
  createdAt    DateTime @default(now()) @map("created_at")

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, version])
  @@map("hdz_plan_revisions")
}

model StoryEvent {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid    @map("project_id")
  chapterNo   Int                  @map("chapter_no")
  eventType   String               @map("event_type")  // battle / dialogue / revelation / travel / transformation / death / other
  title       String
  description String   @db.Text
  participants String[] @default([])           // 参与角色ID列表
  impacts     Json     @default("[]")          // [{characterId, stateType, change, description}]
  location    String?
  timestamp   DateTime @default(now())         // 剧情内时间戳
  createdAt   DateTime @default(now()) @map("created_at")

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, chapterNo])
  @@map("story_events")
}

