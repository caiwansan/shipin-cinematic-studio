model GovUser {
  id          String   @id @default(uuid())
  tenantId    String
  email       String?
  name        String
  role        String?  // reference to Role.id
  status      String   @default("active")
  metadata    String?  // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("governance_user")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  code        String   // owner, admin, manager, operator, reviewer, member, guest
  name        String
  description String?
  capabilities String  // JSON — granted capability codes
  metadata    String?  // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, code])

  @@map("governance_role")
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  price        Float?
  currency     String   @default("USD")
  billingCycle String   // monthly, yearly, once
