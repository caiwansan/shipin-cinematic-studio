model AiEmotionSpec {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  characterName    String
  emotionType      String
  intensity        String?
  facialDesc       String?
  bodyLanguage     String?
  voiceTone        String?
  triggerEvent     String?
  timing           String?
