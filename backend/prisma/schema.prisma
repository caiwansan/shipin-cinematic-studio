  worldId   String   @db.Uuid
  type      String
  tick      Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  world     World    @relation("WorldEvents", fields: [worldId], references: [id])

  @@index([worldId, tick])
  @@map("Event")
}

model NarrativeScene {
  id         String   @id @default(uuid()) @db.Uuid
  worldId    String   @db.Uuid
  summary    String   @default("")
  importance Float    @default(0.5)
  tickRange  String   @default("")
  data       Json?    @default("{}")
  createdAt  DateTime @default(now())
  world      World    @relation("WorldScenes", fields: [worldId], references: [id])

  @@index([worldId])
  @@map("NarrativeScene")
}

model Character {
  id          String              @id @default(uuid())
  worldId     String              @db.Uuid
  name        String
  age         Int                 @default(30)
  faction     String              @default("civilian")
  location    String              @default("city_center")
  activity    String              @default("observing")
  alive       Boolean             @default(true)
  personality String              @default("{\"logic\":0.5,\"emotion\":0.5,\"aggression\":0.3,\"empathy\":0.5}")
  emotion     String              @default("{\"joy\":0.5,\"anger\":0.1,\"fear\":0.2,\"sadness\":0.1,\"trust\":0.5}")
  state       String              @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tickBorn    Int                 @default(0)
  tickDied    Int?
  world       World               @relation("WorldCharacters", fields: [worldId], references: [id])
  behaviors   CharacterBehavior[]
  memories    CharacterMemory[]
  relations   CharacterRelation[] @relation("fromChar")
  relationsTo CharacterRelation[] @relation("toChar")

  @@index([worldId])
  @@map("Character")
}

model CharacterMemory {
  id           String    @id @default(uuid())
  characterId  String
  type         String    @default("event")
  content      String
  importance   Float     @default(0.5)
  tick         Int
  emotionalTag String    @default("neutral")
  createdAt    DateTime  @default(now())
  character    Character @relation(fields: [characterId], references: [id])

  @@index([characterId])
  @@map("CharacterMemory")
}

model CharacterRelation {
  id        String    @id @default(uuid())
  fromId    String
  toId      String
  type      String    @default("trust")
  value     Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  from      Character @relation("fromChar", fields: [fromId], references: [id])
  to        Character @relation("toChar", fields: [toId], references: [id])

  @@index([fromId])
  @@index([toId])
  @@map("CharacterRelation")
}

model CharacterBehavior {
  id          String    @id @default(uuid())
  characterId String
  action      String    @default("observe")
  targetId    String?
  context     String    @default("")
  tick        Int
  score       Float     @default(0)
  executed    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id])

  @@index([characterId])
  @@map("CharacterBehavior")
}

model PipelineStage {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @db.Uuid
  stageKey       String    @map("stage_key")
  status         String    @default("pending")
  inputData      Json?     @map("input_data")
  outputData     Json?     @map("output_data")
  referenceUrls  Json?     @map("reference_urls")
  runtimeVersion String?   @map("runtime_version")
  blockedBy      String?   @map("blocked_by")
  blockReason    String?   @map("block_reason")
  error          String?
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageKey])
  @@map("pipeline_stages")
}

model PipelineJob {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  stageKey    String    @map("stage_key")
  jobType     String    @map("job_type")
  status      String    @default("pending")
  payload     Json?
  result      Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  priority    Int       @default(0)
  sortKey     Int?      @map("sort_key")
  error       String?
  lockedBy    String?   @map("locked_by")
  lockedAt    DateTime? @map("locked_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageKey])
  @@index([status, lockedBy])
  @@index([status, priority])
  @@map("pipeline_jobs")
}

