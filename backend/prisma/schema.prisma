model Organization {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  slug       String?     @unique
  logoUrl    String?     @map("logo_url")
  ownerId    String?     @map("owner_id") @db.Uuid
  plan       String      @default("free") // free | pro | enterprise
  planExpiresAt DateTime? @map("plan_expires_at")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  members       OrgMember[]
  workspaces    Workspace[]
  profile       EnterpriseProfile?
  aiProviders   AIProviderConfig[]
  subscription  EnterpriseSubscription?
  entitlements  EnterpriseEntitlement[]
  // Sprint 12: Tenant Identity Consolidation — reverse relations
  agentInstances     EnterpriseAgentInstance[]
  agentProfiles      EnterpriseAgentProfile[]
  auditTrails        AgentAuditTrail[]
  enterpriseAgentTasks EnterpriseAgentTask[]

  @@map("Organization")
}

model EnterpriseProfile {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @map("organization_id") @db.Uuid
  industry        String?      // SaaS, eCommerce, Education, Finance, Healthcare, Manufacturing, etc.
  businessSummary String?      @map("business_summary") // 主营业务简介
  targetCustomer  String?      @map("target_customer")  // 目标客户描述
  brandVoice      String?      @map("brand_voice")     // 品牌语言风格
  website         String?
  location        String?
  onboardingStep  Int          @default(0) @map("onboarding_step") // 0-6
  onboardingDone  Boolean      @default(false) @map("onboarding_done")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("enterprise_profile")
}

model AIProviderConfig {
  /// @deprecated KMKI AI Runtime Principle（2026-08-01 冻结）：双轨断裂死表（0 数据）
  /// 唯一权威 = OrgModelConfig + ProviderCredential；写端点已 410 拒绝，仅保留兼容读
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  provider        String       // deepseek | openai | claude | qwen | zhipu
  encryptedApiKey String       @map("encrypted_api_key")
  baseUrl         String?      @map("base_url")
  model           String       // deepseek-chat | gpt-4o | claude-3 | etc.
  maxTokensPerDay Int          @default(0) @map("max_tokens_per_day")
  enabled         Boolean      @default(true)
  status          String       @default("active") // active | expired | rate_limited
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, model])
  @@map("ai_provider_config")
}

// ============================================================
// Enterprise Subscription (Sprint 4.2.8)
// ============================================================

model EnterprisePlan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String?  @unique // Sprint-RECRUITMENT-REALITY-02-B: 套餐等级代码 BASIC | PRO | ENTERPRISE | TRIAL | FREE（取代 displayName 字符串猜测）
  name              String   @unique // 套餐标识（管理员配置）
  displayName       String   @map("display_name") // 显示名称
  description       String? // 套餐说明
  price             Int      @default(0) // 月付价格（分），管理员配置
  yearlyPrice       Int      @default(0) @map("yearly_price") // 年付价格（分），管理员配置
  originalPrice     Int      @default(0) @map("original_price") // 原价（分）
  currency          String   @default("CNY") // CNY | USD
  billingCycle      String   @default("monthly") @map("billing_cycle") // monthly | yearly
  maxEmployees      Int      @default(2) @map("max_employees") // AI员工上限
  maxChannels       Int      @default(1) @map("max_channels") // 渠道上限
  maxMembers        Int      @default(5) @map("max_members") // 企业成员上限
  storageLimit      Int      @default(5) @map("storage_limit_gb") // 存储上限（GB）
  // BYOK 策略
  requireOwnLLMKey  Boolean  @default(true) @map("require_own_llm_key") // 必须自带模型Key
  allowedProviders  Json     @default("[\"deepseek\",\"openai\",\"claude\",\"zhipu\"]") @map("allowed_providers") // 允许的模型供应商
  // 额度策略
  quotaPolicy      String   @default("unlimited") @map("quota_policy") // unlimited | fixed | pay_as_you_go
  quotaConfig      Json?    @map("quota_config") // Sprint-RECRUITMENT-REALITY-04 T03: 按能力月配额 { "AI_JD_GENERATE": { "monthly": 100, "unit": "次" } }
  features          Json     @default("[]") // 功能特性列表
  // Sprint-RECRUITMENT-REALITY-03: 套餐能力集（Plan → Entitlement 继承）。空数组=全部能力开放
  capabilityCodes   Json     @default("[]") @map("capability_codes") // 新格式: {employees:[], capabilities:[]}；旧格式: ["AI_JD_GENERATE"]
  enabled           Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions     EnterpriseSubscription[]

  @@map("enterprise_plan")
}

model EnterpriseSubscription {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  orderId         String?  @map("order_id") @db.Uuid // 关联 RechargeOrder，复用统一支付体系
  status          String   @default("active") // active | expired | cancelled | trial
  trialEndsAt     DateTime? @map("trial_ends_at")
  startAt         DateTime @default(now()) @map("start_at")
  expireAt    DateTime @map("expire_at")
  autoRenew       Boolean  @default(true) @map("auto_renew")
  // Snapshot fields for fast subscription resolution (avoid join)
  snapshotName        String?  @map("snapshot_name")
  snapshotPrice       Int?     @map("snapshot_price") // 快照价格（分）
  snapshotCycle       String?  @map("snapshot_cycle") // monthly | yearly
  snapshotMaxEmployees Int?    @map("snapshot_max_employees")
  snapshotMaxChannels  Int?    @map("snapshot_max_channels")
  snapshotMaxMembers   Int?    @map("snapshot_max_members")
  snapshotFeatures     Json?   @map("snapshot_features")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            EnterprisePlan @relation(fields: [planId], references: [id])
  entitlement     EnterpriseEntitlement?

  @@index([status])
  @@index([expireAt])
  @@map("enterprise_subscription")
}

model EnterpriseEntitlement {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  subscriptionId  String   @unique @map("subscription_id") @db.Uuid
  maxAgents       Int      @default(1) @map("max_agents")
  maxChannels     Int      @default(1) @map("max_channels")
  maxMembers      Int      @default(3) @map("max_members")
  storageLimit    Int      @default(5) @map("storage_limit_gb")
  features        Json     @default("{}")
  capabilityCodes       Json?    @map("capability_codes")
  capabilityDeniedCodes Json?    @map("capability_denied_codes")
  quotaUsage      Json?    @map("quota_usage") // Sprint-RECRUITMENT-REALITY-04 T03: 当前计费周期已用额度 { "AI_JD_GENERATE": { "used": 37, "periodStart": "2026-08-01T00:00:00Z" } }
  status          String   @default("active") // active | suspended | expired
  effectiveFrom   DateTime @default(now()) @map("effective_from")
  effectiveUntil  DateTime? @map("effective_until")
  overrideReason  String?  @map("override_reason")
  overrideBy      String?  @map("override_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    EnterpriseSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
