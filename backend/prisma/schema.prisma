// P2 Brand Domain — Brand（品牌数字身份）
// 注意：这是工作台共享模型，GEO 是第一个消费者。未来短剧/小说/PPT 工作台可直接复用。
model GEOBrand {
  id        String   @id @default(uuid())
  slug      String   @unique // 永久稳定标识符，自动从 name 生成，可手动覆盖
  name      String
  primaryDomain String             // 主域名（原 website 重构）
  additionalDomains Json   @default("[]") // string[]，额外域名
  description String?
  industry  String?
  region    String?        // 所在国家/地区
  companyType String?      // brand | saas | ecommerce | local | other
  primaryLanguage String   @default("zh")
  targetMarkets Json?      // string[]
  competitors Json?        // BrandCompetitor[]（预留：name/website/industry/notes）
  goals      Json?         // BrandGoal[]（预留：id(GoalEnum)/priority, 未来加 target/current）
  aiTargets  Json?         // AITarget[]（预留：id/label/version/priority）
  status     String        @default("draft") // draft | active | monitoring | archived
  version    Int           @default(1)       // 关键信息变更时 +1
  // TODO: ownerId + organizationId for enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeSources GEOKnowledgeSource[]
  projects         GEOProject[]

  @@index([slug])
  @@index([status])
  @@map("kmki_geo_brands")
}

// P2 Brand Domain — Knowledge Source（知识源，扫描器直接消费）
model GEOKnowledgeSource {
  id            String   @id @default(uuid())
  brandId       String
  type          String   // official_site | blog | docs | github | wikipedia | news | social | forum | video | custom
  url           String
  label         String?
  crawlStrategy String   @default("manual") // manual | rss | sitemap | api | github | youtube | crawler
  status        String   @default("pending") // pending | verified | error | disabled
  lastScanned   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand GEOBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([status])
  @@map("kmki_geo_knowledge_sources")
}

model GEOProject {
  id        String   @id @default(uuid())
  userId    String
  brandId   String?       // P2 Brand Domain：关联 Brand（兼容期可空）
  name      String
  website   String?       // 官网 URL（MVP 新增，兼容期保留）
  topic     String?
  industry  String?
  keywords  Json?         // 关键词 string[]（MVP 新增，从 GeoBrandSetting 移入）
  language  String   @default("zh")
  country   String?
  status    String   @default("draft")
  config    Json     @default("{}")
  brandVersion Int?       // P2 Brand Domain：创建时的品牌版本号
  brandSnapshot Json?     // P2 Brand Domain：创建时的完整品牌数据快照
  trigger   String   @default("manual") // manual | scheduled | monitoring_alert | api_import
  workspaceId String? @map("workspace_id")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   GEOBrand?     @relation(fields: [brandId], references: [id])
  entities  GEOEntity[]
  relations GEOEntityRelation[]
  versions  GEOProjectVersion[]
  scans     GEOScanRecord[]       // MVP 新增
  discoveryReports  GEODiscoveryReport[]    // P1-A 持久化
  actionPlans       GEOActionPlan[]         // P1-A 持久化
  verificationReports GEOVerificationReport[] // P1-A 持久化

  @@index([userId])
  @@index([status])
  @@index([brandId])
  @@map("kmki_geo_projects")
}

// P1-A 新增：GEO Discovery Report — 保存实体发现报告
model GEODiscoveryReport {
  id            String   @id @default(uuid())
  projectId     String          // 关联 GEOProject.id
  entityName    String
  adi           Float
  coverageScore Float
  shareScore    Float
  positionScore Float
  reportData    Json            // 完整报告数据（包括 scenarios, opportunities 等）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_discovery_reports")
}

// P1-A 新增：GEO Action Plan — 保存建议的行动计划
model GEOActionPlan {
  id                String   @id @default(uuid())
  projectId         String
  discoveryReportId String?
  planData          Json     // 完整计划数据（包括 steps, templates 等）
  status            String   @default("draft") // draft, active, completed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_action_plans")
}

// P1-A 新增：GEO Verification Report — 保存验证结果
model GEOVerificationReport {
  id            String   @id @default(uuid())
  projectId     String
  entityName    String
  beforeAdi     Float
  afterAdi      Float
  deltaAdi      Float
  reportData    Json     // 完整验证数据
  createdAt     DateTime @default(now())

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("kmki_geo_verification_reports")
}

// MVP 新增：扫描记录
model GEOScanRecord {
  id        String   @id @default(uuid())
  projectId String
  userId    String

  scanStatus     String   @default("pending")  // pending | running | completed | failed | partial
  scanStartedAt  DateTime?
  scanFinishedAt DateTime?

  // 4 维分数
  visibilityScore      Int?
  accuracyScore        Int?
  consistencyScore     Int?
  recommendationScore  Int?
  overallScore         Int?

  aiResponses       Json?    // 各 AI 模型的原始响应
  optimizationItems Json?    // 优化建议列表

  errorMessage  String?
  durationMs    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project GEOProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([scanStatus])
  @@map("kmki_geo_scan_records")
}

model GEOEntity {
  id          String   @id @default(uuid())
  projectId   String

  // ── Phase 1a: Tenant (nullable until backfill) ──
  tenantId    String?  @db.Uuid

  name        String
  type        String   @default("Concept")
  description String?
  metadata    Json?    @default("{}")
  provenance  Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  GEOProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoing GEOEntityRelation[] @relation("outgoing")
  incoming GEOEntityRelation[] @relation("incoming")

  claims        GEOClaim[]         // Sprint 1B: Knowledge Quality
