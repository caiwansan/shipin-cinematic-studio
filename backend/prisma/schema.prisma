model UsageLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tenantId       String?  @db.Uuid @map("tenant_id") // Sprint 12: 保持 organizationId (已是 UUID)
  projectId      String?  @db.Uuid
  taskId         String?
  organizationId String?  @db.Uuid @map("organization_id") // IDENTITY-REALITY-FIX-01 G5: 成本归属企业
  agentId        String?  @map("agent_id") @db.Text // IDENTITY-REALITY-FIX-01 G5: AI 员工维度
  cost           Float    @default(0)
  taskType       String
  provider       String
  model          String?  @db.VarChar(200) // IDENTITY-REALITY-FIX-01 G5: 实际模型
  tokens         String?
  isPlatform     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([agentId])
  @@index([createdAt])
