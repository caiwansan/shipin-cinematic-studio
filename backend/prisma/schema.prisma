  runtimeStatus     String   @default("active") @map("runtime_status") // active | paused | stopped
  // Hardening-01: Agent Lifecycle State Machine (replaces emergencyStop boolean)
  lifecycleState    String   @default("ACTIVE") @map("lifecycle_state") // ACTIVE | PAUSED | STOPPED | EMERGENCY_STOP | RECOVERING
  lastActiveAt      DateTime? @map("last_active_at")
  lastRecoveredAt   DateTime? @map("last_recovered_at") // Hardening-01: timestamp of last startup recovery
  totalTasks        Int      @default(0) @map("total_tasks")
  totalErrors       Int      @default(0) @map("total_errors")
  metadata          String   @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([lifecycleState])
  @@index([createdAt])
  @@index([organizationId, lifecycleState])
  @@map("enterprise_agent_instance")
}

