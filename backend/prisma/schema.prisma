model SceneProfile {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  location       String?
  architecture   String?
  weather        String?
  lighting       String?
  timeOfDay      String?
  atmosphere     String?
  colorPalette   String?
  referenceImage String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// 视觉风格配置档案
/// 每种视觉风格（anime/realistic/3d/cartoon 等）定义全链路 prompt 模板 + 模型路由 + 画风参数
model StyleProfile {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  displayName       String
  icon              String   @default("🎨")
  /// 风格描述（prompt 语句块，注入各环节）
  description       String   @default("")
  /// 正面风格修饰词（追加到所有 image/video prompt 末尾）
  styleTokens       String   @default("")
  /// 负面风格修饰词（追加到所有 negative prompt 末尾）
  negativeTokens    String   @default("")
  /// 各环节的 prompt 模板覆盖（JSON）
  /// {
  /// "character": "…",
  /// "scene": "…",
  /// "storyboard": "…",
  /// "video": "…",
  /// "narrative": "…"
  /// }
  promptOverrides   Json?    @map("prompt_overrides")
  /// 推荐模型路由（JSON）
  /// {
  /// "image": { "provider": "volcengine", "model": "doubao-seedream-4-0-250828" },
  /// "video": { "provider": "volcengine", "model": "doubao-seedance-2-0-260128" },
  /// "llm": { "provider": "deepseek", "model": "deepseek-chat" }
  /// }
  modelRoutes       Json?    @map("model_routes")
  /// 画风参考图 URL（可选）
  referenceImageUrl String?  @map("reference_image_url")
  /// 额外参数（JSON）
  parameters        Json?    @default("{}")
  sortOrder         Int      @default(0)
  enabled           Boolean  @default(true)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("style_profiles")
}

model PromptTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  category    String?
  content     Json?
  variables   Json?
  createdAt   DateTime @default(now())
}

model Asset {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String?   @db.Uuid
  type      AssetType @default(other)
  fileName  String
  filePath  String
  mimeType  String?
  fileSize  Int?
  width     Int?
  height    Int?
  duration  Float?
  taskId    String?
  createdAt DateTime  @default(now())
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([taskId, type])
  @@index([projectId])
}

model Membership {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  tier           String          @default("free")
  credits        Int             @default(0)
  creditsUsed    Int             @default(0)
  storageUsed    BigInt          @default(0)
  storageLimit   BigInt          @default(524288000)
  agentLevel     String          @default("none")
  parentId       String?         @db.Uuid
  monthlyBudget  Float?
  monthlySpent   Float           @default(0)
  monthlyResetAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  CoinLog        CoinLog[]
  parent         Membership?     @relation("AgentReferral", fields: [parentId], references: [userId])
  children       Membership[]    @relation("AgentReferral")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         RechargeOrder[]
  storagePacks   StoragePack[]
  assets         UserAsset[]
}

model CoinLog {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  amount     Int
  type       String
  remark     String?
  relatedId  String?
  createdAt  DateTime   @default(now())
  Membership Membership @relation(fields: [userId], references: [userId], map: "coinlog_membership_fkey")

  @@index([userId, createdAt])
}

model UserAsset {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  title              String
  type               String
  url                String
