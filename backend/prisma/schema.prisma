  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  completedAt DateTime? @db.Timestamp(6)
  P18Pair     P18Pair   @relation(fields: [pairId], references: [pairId], onDelete: NoAction, onUpdate: NoAction)

  @@map("V3RenderResult")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model p18_pairs {
  pairId              String
  projectId           String    @db.Uuid
  userId              String    @db.Uuid
  scriptContent       String?
  v2TaskId            String?
  v3TaskId            String?
  status              String    @default("pending")
  error               String?
  v3FillRate          Json?
  v3QualityRate       Json?
  v3SemanticYield     Float     @default(0)
  v3FallbackRate      Float     @default(0)
  v3MissingFieldRate  Float     @default(0)
  v3PromptFailureRate Float     @default(0)
  v3PerceptualScores  Json?
  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  completedAt         DateTime? @db.Timestamp(6)

  @@ignore
}

enum VideoTaskStatus {
  queued
  processing
  optimizing
  storyboarding
  generating
  stitching
  completed
  failed
  cancelled
}

enum TaskLogLevel {
  info
  warn
  error
}

enum AssetType {
  image
  video
  audio
  other
}

// ═══════════════════════════════════════════════════════════════════════════
// 混沌珠小说工作台 — Hdz 模型（独立于昆仑镜短剧系统）
// ═══════════════════════════════════════════════════════════════════════════

model HdzProject {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String
  title             String
  genre             String?                   // 小说类型：玄幻/科幻/言情/悬疑...
  wordTarget        Int?                      // 目标总字数（0=不限）
  chapterWordTarget Int?                      // 单章目标字数
  styleDesc         String?                   // 写作风格描述
  status            String     @default("draft")  // draft / active / completed
  locks             Json       @default("{}")     // {styleLocked, outlineLocked, logicLocked}
  // 封面
  authorNickname    String?
  coverPrompt       String?   @db.Text
  coverImgUrl       String?
  masterStyle       String?                   // 选中的大师风格标识（如: wangzengqi, laoshe...）
  // 发布
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  publishWordCount  Int?

  // 图书馆管理员
  libraryReaderEnabled   Boolean   @default(false)   // 是否启用图书馆管理员自动阅读
  libraryReaderCache     Json?     @default("{}")   // [{chapterNo, title, summary}] — 近5章逐章摘要
  libraryReaderSummaries Json?     @default("{}")   // {batches: [{level, batchIndex, chapterStart, chapterEnd, summary}]} — 各层级批次小结

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions   HdzSession[]
  characters HdzCharacter[]
  factions   HdzFaction[]
  chapters   HdzChapter[]
  memories   HdzMemory[]
  styleDna   HdzStyleDna?
  agentTasks HdzAgentTask[]
  manuscripts HdzManuscript[]
  outlines   HdzOutline[]
  publishLogs HdzPublishLog[]
  entityRegistries    EntityRegistry[]
  sceneDags           SceneDag[]
  worldStates         WorldState[]
  writerAlignmentMetrics WriterAlignmentMetric[]
  plotDagEdges        PlotDagEdge[]

  @@index([userId])
  @@map("hdz_projects")
}

model HdzSession {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String
  status    String   @default("active")  // active / paused / completed
  messages  Json     @default("[]")      // [{role, content, timestamp}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("hdz_sessions")
}

model HdzChapter {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  chapterNo   Int
  title       String?
  status      String   @default("outline")  // outline / draft / reviewed / final
  outline     String?  @db.Text             // 大纲 / 段落指导
  content     String?  @db.Text             // 正文
  wordCount   Int?                          // 字数
  summary     String?   @db.Text            // 章节摘要（上下文管理用）
  reviewNotes Json?    @default("[]")       // [{issue, severity, suggestion}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterNo])
  @@index([projectId, chapterNo])
  @@map("hdz_chapters")
}

model HdzCharacter {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  name       String
  role       String   @default("supporting")  // protagonist / antagonist / supporting / minor
  properties Json     @default("{}")           // {age, gender, appearance, personality, background, motivation}
  relations  Json?    @default("[]")           // [{target, type, description}]
  arc        String?                          // 角色弧线描述
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_characters")
}

model HdzFaction {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  type        String   @default("sect")     // sect/kingdom/company/family/gang/military/other
  description String?  @db.Text             // 组织介绍
  leaderIds   String[] @default([])         // 领导者角色ID列表
  memberIds   String[] @default([])         // 成员角色ID列表
  properties  Json?    @default("{}")       // {location, ranking, scale, culture, era}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_factions")
}

model HdzMemory {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  type      String                            // world_state / character_matrix / pending_hooks / chapter_summary / location_state / pov_tracker / timeline
  content   Json                              // 结构化记忆数据
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@map("hdz_memories")
}

model HdzStyleDna {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @unique @db.Uuid
  sourceText  String?  @db.Text             // 用户上传的参考文本
  fingerprint Json     @default("{}")          // 文风指纹：{sentenceLength, vocabulary, emotionPatterns, ...}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("hdz_style_dna")
}

model HdzAgentTask {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  sessionId       String?   @db.Uuid
  agentType       String                           // planner / character_agent / director / writer / reviewer
  status          String    @default("queued")      // queued / running / completed / failed / waiting_approval
  input           Json      @default("{}")          // 输入参数
  output          Json?                             // 输出结果
  approvalStatus  String?                           // pending / approved / rejected / modified
  approvalNote    String?                           // 用户修改意见
  tokenCost       Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_agent_tasks")
}

model HdzManuscript {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  title       String?
  content     Json     @default("[]")  // [{type: "paragraph"|"heading"|"dialogue"|"scene_break", content: "..."}]
  wordCount   Int      @default(0)
  sectionNo   Int      @default(0)
  isFinal     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sectionNo])
  @@map("hdz_manuscripts")
}

model HdzOutline {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  title       String
  content     Json     @default("[]")  // [{type: "act"|"chapter"|"section", title: "...", summary: "...", keyEvents: ["..."]}]
  status      String   @default("draft")  // draft / active / locked
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_outlines")
}

model HdzPublishLog {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  target      String                            // platform name
  status      String   @default("pending")       // pending / published / failed
  result      Json?
  createdAt   DateTime @default(now())

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("hdz_publish_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// HDZ Schema Reconcile — Phase X 基础设施模型（于 2026-06-26 补齐）
// 6 个模型在代码中被引用但 Prisma Schema 缺失，属于架构完整性修复。
// ═══════════════════════════════════════════════════════════════════════════

model EntityRegistry {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  entityType  String                        // 'character' | 'item' | 'location' | 'event'
  name        String
  aliases     String[] @default([])         // 别名列表
  createdAt   DateTime @default(now())

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, entityType])
  @@map("entity_registry")
}

model EventLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String                        // 'task' | 'chapter' | 'character'
  entityId    String                        // 关联实体 ID
  eventType   String                        // 'TASK_STARTED' | 'TASK_COMPLETED' | 'TASK_FAILED' | 'TASK_REJECTED' | 'TASK_APPROVED' | 'CHAPTER_STATUS_CHANGED'
  payload     Json     @default("{}")       // 事件负载数据
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
  @@map("event_log")
}

model SceneDag {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  sceneId     String                        // e.g. 'ch1_s1'
  chapterNo   Int
  sceneNo     Int
  dagJson     Json     @default("{}")       // { involvedEntities, constraints, entityCount, entityContract? }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneId])
  @@index([projectId, chapterNo])
  @@map("scene_dag")
}

model WorldState {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  entityId    String                        // 关联 entityRegistry.id
  stateJson   Json     @default("{}")       // { health, inventory, location, relationships, statusFlags... }
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityId])
  @@index([projectId])
  @@map("world_state")
}

model WriterAlignmentMetric {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  chapterId         String?  @db.Uuid          // 可选关联章节
  scoreJson         Json     @default("{}")   // { overall_score, character, plot, style, pacing, dialogue... }
  shadowStateDelta  Json?                       // Writer Shadow 状态差异
  createdAt         DateTime @default(now())

  project HdzProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("writer_alignment_metrics")
}

model PlotDagEdge {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  sourceId    String                        // 源节点 sceneId
  targetId    String                        // 目标节点 sceneId
  edgeType    String   @default("causality")// 'causality' | 'parallel' | 'alternative'
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  project HdzProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("plot_dag_edges")
}


model PromptVariant {
  id            String   @id @default(uuid())
  name          String
  version       String   @default("v1")
  label         String   @default("canary")
  description   String?
  parentVersion String?
  content       Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, version])
  @@map("prompt_variant")
}

