      "duration": 3.0
    }
  ],
  "cameraSpecs": [
    {
      "segmentId": "seg_0",
      "cameraMovement": "推 | 拉 | 摇 | 移 | 跟 | 升 | 降 | 旋转 | 手持 | 斯坦尼康",
      "shotSize": "远景 | 全景 | 中景 | 近景 | 特写 | 大特写",
      "angle": "平视 | 俯视 | 仰视 | 过肩 | 主观视角",
      "duration": 5.0,
      "transition": "dissolve | cut | fade | wipe",
      "purpose": "镜头语言目的描述"
    }
  ],
  "emotionSpecs": [
    {
      "characterName": "角色名",
      "emotionType": "喜悦 | 悲伤 | 愤怒 | 恐惧 | 惊讶 | 厌恶 | 爱慕 | 焦虑 | 平静 | 激动",
      "intensity": "轻微 | 中等 | 强烈 | 爆发",
      "facialDesc": "面部表现（眉毛、眼睛、嘴巴的详细描述，20-50字）",
      "bodyLanguage": "肢体语言描述",
      "voiceTone": "语调描述（如：颤抖、低沉、高昂、哽咽）",
      "triggerEvent": "触发该情绪的事件",
      "timing": "贯穿全片 | 特定场景描述",
      "cameraPreference": "推荐运镜（如：情绪特写 / 近景跟随）"
    }
  ]
}`

  app.post('/api/v1/narrative/aigc-spec', async (request, reply) => {
    const start = Date.now()
    const body = request.body as NarrativeAnalysisRequest & { aspectRatio?: string }
    const { text, title, aspectRatio } = body

    if (!text || text.trim().length < 10) {
      return reply.status(400).send({
        success: false,
        error: '文本太短，至少 10 个字符',
      })
    }

    try {
      const provider = getProvider('deepseek')
      if (!provider) {
        return reply.status(500).send({
          success: false,
          error: 'LLM provider 不可用',
        })
      }

      const userPrompt = `请根据以下故事文本，生成完整的 AIGC 制作规格表 JSON。

故事标题：${title || '未命名故事'}
用户选择的画幅比例：${aspectRatio || '16:9'}

故事文本：
${text.slice(0, 8000)}

注意事项：
- aspectRatio 用用户选择的 "${aspectRatio || '16:9'}"
- 角色数量根据故事中的角色确定，一般 2-4 个
- 场景根据故事场景变化设定，一般 2-5 个
- 视频段落 3-6 段，每段 10-20 秒
- 所有 imagePrompt 必须包含详细的视觉描述，可用于文生图模型直接生成