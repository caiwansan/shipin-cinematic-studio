      "imagePrompt": "文生图 prompt，包含：环境描述、光线、色调、构图、氛围词",
      "negativePrompt": "负面词",
      "aspectRatio": "16:9"
    }
  ],
  "voiceConfigs": [
    {
      "characterName": "角色名",
