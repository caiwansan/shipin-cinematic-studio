  },
  "effectSpecs": [
    {
      "effectName": "特效名称",
      "effectType": "粒子特效 | 光效 | 爆炸 | 烟雾 | 魔法 | 转场特效",
      "triggerScene": "触发场景名称",
      "triggerEvent": "触发事件描述（如：角色释放魔法时、情绪高潮时）",
      "visualDescription": "视觉表现描述（50-100字，详细描述颜色、形态、运动轨迹）",
      "colorPalette": "特效色彩（如：蓝色主调配金色粒子）",
      "duration": 2.5,
      "intensity": "轻微 | 中等 | 强烈",
      "notes": "补充说明"
    }
  ],
  "actionSpecs": [
    {
      "characterName": "角色名",
      "actionName": "动作名称（如：拔刀、转身、奔跑、拥抱、跳跃）",
      "triggerCondition": "触发条件描述",
      "movementDesc": "动作描述（肢体轨迹、速度、力度，30-80字）",
      "facialExpression": "伴随面部表情",
      "bodyLanguage": "身体语言补充",
