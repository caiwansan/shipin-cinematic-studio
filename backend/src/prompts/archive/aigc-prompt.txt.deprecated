      "speakingStyle": "说话风格描述（如：沉稳、急促、温柔）",
      "pitch": 1.0,
      "speed": 1.0,
      "ttsPrompt": "用于 TTS 的 prompt 辅助描述"
    }
  ],
  "videoSegments": [
    {
      "segmentId": "seg_0",
      "title": "段落标题",
      "associatedScenes": ["scene_0", "scene_1"],
      "duration": 15,
      "narrativePurpose": "叙事目的描述",
      "shotPattern": "wide_to_close | close_to_wide | medium_medium | montage",
