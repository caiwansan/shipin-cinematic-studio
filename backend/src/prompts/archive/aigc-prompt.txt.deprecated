      "backgroundMusic": "配乐风格建议"
    }
  ],
  "frameDesign": [
    {
      "segmentId": "seg_0",
      "firstFrame": {
        "description": "开场画面描述",
        "imagePrompt": "文生图 prompt",
        "cameraAngle": "wide_establishing | close_up | over_shoulder"
      },
      "lastFrame": {
        "description": "结束画面描述",
