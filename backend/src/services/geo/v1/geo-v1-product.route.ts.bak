// ============================================================
// GEO V1 Product Routes — RC1 Product Freeze API
// Maps /api/v1/geo/* → existing GEO Services + Repositories
// ============================================================

import { FastifyInstance } from 'fastify'
import { geoProjectRepository } from '../repositories/geo-project.repository.js'
import { geoBrandSettingRepository } from '../repositories/geo-brand-setting.repository.js'
import { geoBrandProfileRepository } from '../repositories/geo-brand-profile.repository.js'
import { geoKeywordRepository } from '../repositories/geo-keyword.repository.js'
import { geoClaimRepository } from '../repositories/geo-claim.repository.js'
import { geoEvidenceRepository } from '../repositories/geo-evidence.repository.js'
import { geoEntityRepository, geoEntityRelationRepository } from '../repositories/geo-entity.repository.js'
import { geoScoreSnapshotRepository } from '../repositories/geo-score-snapshot.repository.js'
import { geoQualityRepository } from '../repositories/geo-quality.repository.js'
import { geoFreshnessRepository } from '../repositories/geo-freshness.repository.js'
import { geoReviewRepository } from '../repositories/geo-review.repository.js'
import { geoFaqRepository } from '../repositories/geo-faq.repository.js'
import { geoSchemaRepository } from '../repositories/geo-schema.repository.js'
import { knowledgeObjectRepository } from '../../repositories/knowledge-object.repository.js'
import { calculateScore, calculateScoreSimple } from '../recommendation/recommendation-score.service.js'
import { MonitorService } from '../monitor/monitor.service.js'

const monitorService = new MonitorService()

export default async function geoV1ProductRoutes(fastify: FastifyInstance) {

  // ──────────────────────────────────────────────
  // 1. Health — Brand Health Score + Dimensions
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/health/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any
    const user = request.user as any
    const userId = user.id

    // Get brand info
    const project = await geoProjectRepository.findUnique({ where: { id: projectId } })
    if (!project || project.deletedAt) {
      return reply.status(404).send({ error: 'Project not found' })
    }

    const brandSetting = await geoBrandSettingRepository.findFirst({
      where: { projectId, userId },
    })

    // Calculate real scores
    const scoreResult = await calculateScoreSimple(projectId)
    const overallScore = scoreResult?.overall ?? 0

    // Get dimension breakdown
    const dimensions = [
      { id: 'visibility', label: 'AI Visibility', score: scoreResult?.visibility ?? 0, maxScore: 100 },
      { id: 'authority', label: 'Authority', score: scoreResult?.authority ?? 0, maxScore: 100 },
      { id: 'content', label: 'Content Quality', score: scoreResult?.content ?? 0, maxScore: 100 },
      { id: 'website', label: 'Website Health', score: scoreResult?.website ?? 0, maxScore: 100 },
      { id: 'knowledge', label: 'Knowledge Coverage', score: scoreResult?.knowledge ?? 0, maxScore: 100 },
    ]

    // Get latest score snapshot for trend
    const latestSnapshot = await geoScoreSnapshotRepository.findFirst({
      where: { projectId },
      orderBy: { createdAt: 'desc' },
    })

    // Count evidence nodes for coverage
    const evidenceCount = await geoEvidenceRepository.count({ projectId })
    const entityCount = await geoEntityRepository.count({ projectId })
    const claimCount = await geoClaimRepository.count({ projectId })

    // Recent changes — from score history
    const scoreHistory = await geoScoreSnapshotRepository.findMany({
      where: { projectId },
      orderBy: { createdAt: 'desc' },
      take: 5,
    })

    const recentChanges = scoreHistory.map(s => ({
      date: s.createdAt.toISOString(),
      score: (s.snapshot as any)?.overall ?? 0,
      change: 0, // @beta-stub: 暂未实现与前一次的 diff 计算
    }))

    return {
      success: true,
      data: {
        brand: {
          name: project.name,
          website: brandSetting?.website || project.website || '',
          industry: brandSetting?.industry || project.industry || '',
          status: brandSetting?.status || project.status || 'active',
        },
        healthScore: {
          overall: overallScore,
          change: latestSnapshot ? (latestSnapshot.snapshot as any)?.overall - (scoreHistory[1]?.snapshot as any)?.overall || 0 : 0,
          trend: scoreHistory.length > 2 ? 'improving' : 'stable',
        },
        dimensions,
        explanation: {
          summary: `Your brand has a ${overallScore >= 80 ? 'strong' : overallScore >= 60 ? 'moderate' : 'weak'} AI presence across ${dimensions.filter(d => d.score > 0).length} of 5 dimensions.`,
          nextFocus: dimensions.reduce((a, b) => (a.score < b.score ? a : b)).id,
        },
        coverage: {
          evidenceCount,
          entityCount,
          claimCount,
        },
        recentChanges,
        quickActions: [
          { id: 'improve-visibility', label: 'Improve AI Visibility', impact: 'High' },
          { id: 'add-claims', label: 'Verify Brand Claims', impact: 'Medium' },
          { id: 'check-freshness', label: 'Update Content', impact: 'Low' },
        ],
      },
    }
  })

  // ──────────────────────────────────────────────
  // 2. Recommendations — Optimization suggestions
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/recommendations/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any

    // Get current state
    const evidenceCount = await geoEvidenceRepository.count({ projectId })
    const claimCount = await geoClaimRepository.count({ projectId })
    const entityCount = await geoEntityRepository.count({ projectId })
    const keywordCount = await geoKeywordRepository.count({ projectId } as any)
    const schemaCount = await geoSchemaRepository.count({ projectId })
    const faqCount = await geoFaqRepository.count({ projectId })

    // Get overall score
    const scoreResult = await calculateScoreSimple(projectId)
    const overallScore = scoreResult?.overall ?? 0

    // Build contextual recommendations
    const recommendations = []
    if (evidenceCount < 5) {
      recommendations.push({
        id: 'add-evidence',
        title: 'Add Supporting Evidence',
        description: 'Strengthen your brand claims with supporting evidence from authoritative sources.',
        priority: 'high',
        impact: { label: 'Score +5-8', value: Math.min(5 + (5 - evidenceCount) * 2, 15) },
        difficulty: 'easy',
        expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 8, 100) },
        category: 'knowledge',
        status: 'ready',
      })
    }
    if (claimCount < 3) {
      recommendations.push({
        id: 'create-claims',
        title: 'Define Brand Claims',
        description: 'Create structured claims about your brand to improve AI understanding.',
        priority: 'high',
        impact: { label: 'Score +3-5', value: 5 },
        difficulty: 'medium',
        expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 5, 100) },
        category: 'knowledge',
        status: 'ready',
      })
    }
    if (keywordCount < 10) {
      recommendations.push({
        id: 'expand-keywords',
        title: 'Expand Keyword Coverage',
        description: 'Add more relevant keywords to increase AI visibility in search.',
        priority: 'medium',
        impact: { label: 'Score +2-4', value: 4 },
        difficulty: 'easy',
        expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 4, 100) },
        category: 'visibility',
        status: 'ready',
      })
    }
    if (schemaCount < 1) {
      recommendations.push({
        id: 'add-schema',
        title: 'Add Schema Markup',
        description: 'Implement structured data markup to help AI understand your brand.',
        priority: 'medium',
        impact: { label: 'Score +3-5', value: 5 },
        difficulty: 'medium',
        expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 5, 100) },
        category: 'website',
        status: 'ready',
      })
    }
    if (faqCount < 3) {
      recommendations.push({
        id: 'add-faqs',
        title: 'Add Brand FAQs',
        description: 'Create FAQ content to populate AI knowledge panels.',
        priority: 'low',
        impact: { label: 'Score +1-2', value: 2 },
        difficulty: 'easy',
        expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 2, 100) },
        category: 'knowledge',
        status: 'ready',
      })
    }

    // Add a general improvement
    recommendations.push({
      id: 'full-optimization',
      title: 'Run Full Brand Optimization',
      description: 'Execute a complete optimization pipeline across all knowledge dimensions.',
      priority: overallScore < 60 ? 'high' : 'medium',
      impact: { label: 'Score +10-20', value: 20 },
      difficulty: 'complex',
      expectedScoreChange: { from: overallScore, to: Math.min(overallScore + 20, 100) },
      category: 'comprehensive',
      status: 'ready',
    })

    return {
      success: true,
      data: {
        summary: {
          total: recommendations.length,
          highPriority: recommendations.filter(r => r.priority === 'high').length,
          mediumPriority: recommendations.filter(r => r.priority === 'medium').length,
          lowPriority: recommendations.filter(r => r.priority === 'low').length,
          totalExpectedGain: recommendations.reduce((s, r) => s + r.impact.value, 0),
        },
        recommendations,
        history: [],
      },
    }
  })

  // POST execute — placeholder for real execution
  fastify.post('/api/v1/geo/recommendations/:projectId/execute', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any
    const { recommendationIds } = request.body as any
    return {
      success: true,
      data: {
        executed: true,
        projectId,
        recommendationIds: recommendationIds || [],
        status: 'started',
        startedAt: new Date().toISOString(),
      },
    }
  })

  // ──────────────────────────────────────────────
  // 3. Verification — Before/After + Evidence
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/verification/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any

    // Get latest scores for before/after
    const scoreHistory = await geoScoreSnapshotRepository.findMany({
      where: { projectId },
      orderBy: { createdAt: 'desc' },
      take: 2,
    })

    const before = scoreHistory[1]?.snapshot as any
    const after = scoreHistory[0]?.snapshot as any

    // Get evidence and claims
    const evidenceList = await geoEvidenceRepository.findMany({ projectId })
    const claimList = await geoClaimRepository.findMany({ entity: { projectId } })

    // AI visibility data
    const keywordCount = await geoKeywordRepository.count({ projectId } as any)
    const entityCount = await geoEntityRepository.count({ projectId })

    // Coverage
    const schemaCount = await geoSchemaRepository.count({ projectId })
    const faqCount = await geoFaqRepository.count({ projectId })

    // Review queue for latest verification
    const latestReview = await geoReviewRepository.findFirst({
      where: { projectId },
      orderBy: { createdAt: 'desc' },
    })

    return {
      success: true,
      data: {
        summary: {
          outcome: latestReview?.status === 'approved' ? 'verified' : 'pending',
          confidence: after?.overall ? Math.round(after.overall / 100 * 80 + 20) : 0,
          proofLevel: evidenceCount > 0 ? 'evidenced' : 'needs-evidence',
          trustScore: after?.overall ?? 0,
        },
        beforeAfter: {
          before: {
            overall: before?.overall ?? 0,
            dimensions: {
              visibility: before?.visibility ?? 0,
              authority: before?.authority ?? 0,
              content: before?.content ?? 0,
              website: before?.website ?? 0,
              knowledge: before?.knowledge ?? 0,
            },
          },
          after: {
            overall: after?.overall ?? 0,
            dimensions: {
              visibility: after?.visibility ?? 0,
              authority: after?.authority ?? 0,
              content: after?.content ?? 0,
              website: after?.website ?? 0,
              knowledge: after?.knowledge ?? 0,
            },
          },
          changes: {
            overall: (after?.overall ?? 0) - (before?.overall ?? 0),
            visibility: (after?.visibility ?? 0) - (before?.visibility ?? 0),
            authority: (after?.authority ?? 0) - (before?.authority ?? 0),
            content: (after?.content ?? 0) - (before?.content ?? 0),
            website: (after?.website ?? 0) - (before?.website ?? 0),
            knowledge: (after?.knowledge ?? 0) - (before?.knowledge ?? 0),
          },
        },
        evidence: {
          total: evidenceList.length,
          items: evidenceList.slice(0, 20).map(e => ({
            id: e.id,
            title: e.title || 'Untitled Evidence',
            source: e.source || 'Unknown',
            status: e.status || 'pending',
            createdAt: e.createdAt?.toISOString(),
          })),
        },
        aiVisibility: {
          keywordCount,
          entityCount,
          claimCount,
        },
        coverage: {
          schemas: schemaCount,
          faqs: faqCount,
          evidences: evidenceCount,
        },
        status: 'verified',
        history: scoreHistory.map(s => ({
          date: s.createdAt.toISOString(),
          score: (s.snapshot as any)?.overall ?? 0,
        })),
      },
    }
  })

  // ──────────────────────────────────────────────
  // 4. Publishing — Distribution Center
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/publishing/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any

    // Get project
    const project = await geoProjectRepository.findUnique({ where: { id: projectId } })

    // Get claims (counts as publishable content)
    const claimList = await geoClaimRepository.findMany({ entity: { projectId } })
    const evidenceList = await geoEvidenceRepository.findMany({ projectId })
    const schemaList = await geoSchemaRepository.findMany({ projectId })
    const faqList = await geoFaqRepository.findMany({ projectId })
    const koCount = await knowledgeObjectRepository.count({ projectId } as any)

    // Determine supported channels
    const channels = [
      {
        id: 'website',
        name: 'Website',
        type: 'web',
        status: project?.website ? 'connected' : 'not_connected',
        lastSync: null,
        publishable: true,
        health: project?.website ? 'good' : 'unknown',
      },
      {
        id: 'knowledge-graph',
        name: 'Knowledge Graph',
        type: 'ai',
        status: 'ready',
        lastSync: null,
        publishable: claimList.length > 0,
        health: 'good',
      },
      {
        id: 'search-console',
        name: 'Search Console',
        type: 'search',
        status: project?.website ? 'connected' : 'not_connected',
        lastSync: null,
        publishable: true,
        health: 'good',
      },
    ]

    const totalContent = claimList.length + evidenceList.length + schemaList.length + faqList.length

    return {
      success: true,
      data: {
        channels,
        publishingStatus: koCount > 0 ? 'published' : 'draft',
        currentVersion: `v1.0.0`,
        contentOverview: {
          total: totalContent,
          claims: claimList.length,
          evidences: evidenceList.length,
          schemas: schemaList.length,
          faqs: faqList.length,
          knowledgeObjects: koCount,
        },
        history: [],
      },
    }
  })

  fastify.post('/api/v1/geo/publishing/:projectId/publish', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any
    return {
      success: true,
      data: {
        published: true,
        projectId,
        version: `v1.0.0-${Date.now()}`,
        publishedAt: new Date().toISOString(),
        status: 'published',
      },
    }
  })

  // ──────────────────────────────────────────────
  // 5. Growth — Progress + Trend + Opportunity
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/growth/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any

    // Get score history for trend
    const scoreHistory = await geoScoreSnapshotRepository.findMany({
      where: { projectId },
      orderBy: { createdAt: 'asc' },
      take: 30,
    })

    const currentScore = scoreHistory[scoreHistory.length - 1]?.snapshot as any
    const firstScore = scoreHistory[0]?.snapshot as any
    const scoreTrend = scoreHistory.map(s => ({
      date: s.createdAt.toISOString().split('T')[0],
      score: (s.snapshot as any)?.overall ?? 0,
    }))

    // Get optimization history
    const optimizations = await geoScoreSnapshotRepository.findMany({
      where: { projectId, type: 'optimization' as any },
      orderBy: { createdAt: 'desc' },
      take: 10,
    })

    // Count milestones
    const milestones = []
    if (scoreHistory.length >= 1) {
      milestones.push({ date: scoreHistory[0].createdAt.toISOString().split('T')[0], label: 'Started Tracking', score: firstScore?.overall ?? 0, achieved: true })
    }
    if (currentScore?.overall >= 40) {
      milestones.push({ date: scoreHistory.find(s => (s.snapshot as any)?.overall >= 40)?.createdAt.toISOString().split('T')[0] || '', label: 'Reached Basic Visibility', score: 40, achieved: true })
    }
    if (currentScore?.overall >= 70) {
      milestones.push({ date: scoreHistory.find(s => (s.snapshot as any)?.overall >= 70)?.createdAt.toISOString().split('T')[0] || '', label: 'Strong AI Presence', score: 70, achieved: true })
    }
    milestones.push({ date: '', label: 'Excellent AI Readiness', score: 90, achieved: (currentScore?.overall ?? 0) >= 90 })

    const overallChange = currentScore?.overall - firstScore?.overall || 0
    const improvementAreas = [
      { action: 'Knowledge Coverage', impact: `+${currentScore?.knowledge - firstScore?.knowledge || 0} pts`, period: 'All time' },
      { action: 'Content Quality', impact: `+${currentScore?.content - firstScore?.content || 0} pts`, period: 'All time' },
    ]

    return {
      success: true,
      data: {
        trend: {
          current: currentScore?.overall ?? 0,
          previous: firstScore?.overall ?? 0,
          change: overallChange,
          direction: overallChange > 0 ? 'improving' : overallChange < 0 ? 'declining' : 'stable',
          history: scoreTrend,
        },
        growthSummary: {
          direction: overallChange > 5 ? 'improving' : overallChange < -3 ? 'declining' : 'stable',
          totalActions: optimizations.length,
          successfulActions: optimizations.filter(o => (o.snapshot as any)?.status === 'completed').length,
          overallChange,
        },
        improvements: improvementAreas,
        milestones,
        mostEffectiveActions: optimizations.slice(0, 5).map(o => ({
          date: o.createdAt.toISOString().split('T')[0],
          action: 'Optimization Run',
          impact: (o.snapshot as any)?.overall ?? 0,
          score: (o.snapshot as any)?.overall ?? 0,
        })),
        opportunity: {
          targetScore: Math.min((currentScore?.overall ?? 0) + 20, 100),
          potentialGain: 20,
          actions: ['Improve AI Visibility', 'Expand Knowledge Graph', 'Add Schema Markup'],
        },
      },
    }
  })

  // ──────────────────────────────────────────────
  // 6. Knowledge — Knowledge Assets Overview
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/knowledge/:projectId', { preHandler: [fastify.authenticate] }, async (request, reply) => {
    const { projectId } = request.params as any

    // Get all knowledge assets
    const entities = await geoEntityRepository.findMany({ projectId })
    const claims = await geoClaimRepository.findMany({ entity: { projectId } })
    const evidences = await geoEvidenceRepository.findMany({ projectId })
    const relations = await geoEntityRelationRepository.findMany({ projectId })
    const schemas = await geoSchemaRepository.findMany({ projectId })
    const faqs = await geoFaqRepository.findMany({ projectId })
    const keywords = await geoKeywordRepository.findMany({ projectId } as any)
    const kos = await knowledgeObjectRepository.findMany({ projectId } as any)

    // Coverage estimation
    const totalPossibleDimensions = 7
    const coveredDimensions = [
      entities.length > 0 && 'entities',
      claims.length > 0 && 'claims',
      evidences.length > 0 && 'evidences',
      schemas.length > 0 && 'schemas',
      faqs.length > 0 && 'faqs',
      keywords.length > 0 && 'keywords',
      kos.length > 0 && 'knowledgeObjects',
    ].filter(Boolean).length

    const coverageScore = Math.round(coveredDimensions / totalPossibleDimensions * 100)

    // Categorize knowledge
    const categories = [
      { name: 'Core Brand', count: entities.filter(e => e.type === 'Brand').length, items: entities.filter(e => e.type === 'Brand').slice(0, 5).map(e => e.name) },
      { name: 'Products & Services', count: entities.filter(e => e.type === 'Product').length, items: entities.filter(e => e.type === 'Product').slice(0, 5).map(e => e.name) },
      { name: 'Technology', count: entities.filter(e => e.type === 'Technology' || e.type === 'Concept').length, items: entities.filter(e => e.type === 'Technology' || e.type === 'Concept').slice(0, 5).map(e => e.name) },
      { name: 'People', count: entities.filter(e => e.type === 'Person').length, items: entities.filter(e => e.type === 'Person').slice(0, 5).map(e => e.name) },
      { name: 'Claims', count: claims.length, items: claims.slice(0, 5).map(c => c.title || c.name || 'Untitled Claim') },
    ]

    // Freshness status
    const freshness = {
      overall: coverageScore,
      lastUpdated: claims[0]?.updatedAt?.toISOString() || null,
      staleItems: 0, // @beta-stub: 暂未实现 freshness 检查
      freshItems: entities.length + claims.length,
    }

    return {
      success: true,
      data: {
        assets: {
          total: entities.length + claims.length + evidences.length + schemas.length + faqs.length + keywords.length + kos.length,
          entities: entities.length,
          claims: claims.length,
          evidences: evidences.length,
          relations: relations.length,
          schemas: schemas.length,
          faqs: faqs.length,
          keywords: keywords.length,
          knowledgeObjects: kos.length,
        },
        coverage: {
          percentage: coverageScore,
          coveredDimensions,
          totalDimensions: totalPossibleDimensions,
          dimensions: [
            { name: 'Entities', covered: entities.length > 0, count: entities.length },
            { name: 'Claims', covered: claims.length > 0, count: claims.length },
            { name: 'Evidence', covered: evidences.length > 0, count: evidences.length },
            { name: 'Schema Markup', covered: schemas.length > 0, count: schemas.length },
            { name: 'FAQs', covered: faqs.length > 0, count: faqs.length },
            { name: 'Keywords', covered: keywords.length > 0, count: keywords.length },
            { name: 'Knowledge Objects', covered: kos.length > 0, count: kos.length },
          ],
        },
        categories,
        freshness,
        missingKnowledge: categories.filter(c => c.count === 0).map(c => ({
          category: c.name,
          suggestion: `No ${c.name} data found. Consider adding ${c.name} to your knowledge base.`,
        })),
        relationships: relations.map(r => ({
          source: r.sourceName || r.sourceEntityId || 'Unknown',
          target: r.targetName || r.targetEntityId || 'Unknown',
          type: r.type || 'related_to',
        })),
      },
    }
  })

  // ──────────────────────────────────────────────
  // Health check
  // ──────────────────────────────────────────────
  fastify.get('/api/v1/geo/ping', async (_request, reply) => {
    return { success: true, message: 'GEO V1 Product API', version: '1.0.0', status: 'ready' }
  })
}
