{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoveryResult",
  "description": "Structured output from Brand Intelligence Discovery Agent",
  "type": "object",
  "properties": {
    "scenarios": {
      "type": "array",
      "description": "List of scenarios evaluated for this entity",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "description": "Unique identifier for the scenario"
          },
          "scenarioName": {
            "type": "string",
            "description": "Human-readable name of the scenario"
          },
          "industryId": {
            "type": "string",
            "description": "Industry sector identifier"
          },
          "entityCoverage": {
            "type": "boolean",
            "description": "Whether the entity has any presence in this scenario"
          },
          "coverageScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Coverage score 0-100"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Confidence in this assessment 0-100"
          },
          "trend": {
            "type": "string",
            "enum": ["up", "stable", "down"],
            "description": "Direction of change in visibility"
          }
        },
        "required": ["scenarioId", "scenarioName", "coverageScore", "confidence", "trend"]
      }
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall coverage score across all scenarios"
    },
    "share": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall share of voice score"
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "description": "Overall position/rank score (lower is better)"
    },
    "raw": {
      "type": "string",
      "description": "Raw evidence or reasoning text"
    }
  },
  "required": ["scenarios", "coverage", "share", "position"]
}
