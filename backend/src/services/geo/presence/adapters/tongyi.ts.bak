// ============================================================
// 通义千问 (Tongyi) Adapter — AI Presence Engine
// P0-T005.1: 12 Platform Extension
// P0-B.2: Replaced stub with real API call (shared DashScope API with qwen.ts)
// ============================================================

import { ProviderAdapter } from '../adapter.interface.js'
import { PresenceContext, ProviderResult } from '../types.js'
import { executePresenceCall } from '../presence-executor.js'


interface TongyiMessage {
  role: string
  content: string
}

function buildPrompt(context: PresenceContext): TongyiMessage[] {
  const systemPrompt = 'You are a brand presence analyst for AI training data. Your task is to determine how well this brand is recognized in AI training data (specifically 通义千问\'s knowledge base).\n\nAnalyze the brand and return a JSON object ONLY (no markdown, no explanation):\n\n{\n  "visibility": "visible" | "partial" | "missing" | "unknown",\n  "knowledgeQuality": <0-100>,\n  "confidence": <0-100>,\n  "evidenceCount": <number>,\n  "summary": "<1-2 sentence explanation in Chinese>",\n  "recommendations": ["<recommendation 1 in Chinese>", "<recommendation 2 in Chinese>", "<recommendation 3 in Chinese>"]\n}\n\nRules:\n- visibility: "visible" if the brand is well-known and info is readily available, "partial" if some info exists but gaps, "missing" if not found, "unknown" if insufficient data\n- knowledgeQuality: how detailed is the AI\'s knowledge about this brand (0=none, 100=comprehensive)\n- confidence: how confident you are in this assessment (0=guessing, 100=very confident)\n- evidenceCount: number of distinct data points about the brand you can identify\n\nReturn ONLY valid JSON.'

  const brandInfo = [
    context.website ? 'Website: ' + context.website : null,
    context.industry ? 'Industry: ' + context.industry : null,
    context.description ? 'Description: ' + context.description : null,
  ].filter(Boolean).join('\n')

  const userPrompt = 'Analyze this brand\'s presence in AI training data:\nBrand Name: ' + context.name + (brandInfo ? '\n' + brandInfo : '') + '\n\nReturn ONLY the JSON object.'

  return [
    { role: 'system', content: systemPrompt },
    { role: 'user', content: userPrompt },
  ]
}

import { StructuredOutputService } from '../../../structured-output.service.js'
import { getProviderProfile } from '../../../provider-output-profile.js'
import { parseProviderResult } from './_parse-provider-result.js'

const sol = new StructuredOutputService()
const profile = getProviderProfile('tongyi')

export const tongyiAdapter: ProviderAdapter = {
  provider: 'tongyi',
  displayName: '通义千问',
  supportsPresence: true,
  meta: { group: 'china', displayOrder: 8 },

  async checkPresence(context: PresenceContext): Promise<ProviderResult> {
      // Platform Runtime handles credentials


    if (!context.name) {
      return {
        visibility: 'unknown', evidenceLevel: 'N/A', confidence: 0,
        lastCheckedAt: new Date().toISOString(), evidenceCount: 0,
        summary: '缺少品牌名称，无法分析在通义千问中的可见度。',
        explain: '品牌名称是必须的输入参数。',
        recommendations: ['输入品牌名称以开始分析'],
      }
    }

    try {
      const messages = buildPrompt(context)
      const { content } = await executePresenceCall({
        messages: undefined,
        temperature: 0.1,
        maxTokens: 1000,
      })
      console.log(`[Tongyi DEBUG] raw content (${typeof content}, len=${content?.length}): ${(content || '').slice(0, 300)}`)
      const parsed = sol.extract(content, profile)

      if (parsed.__stage === 'UNSTRUCTURED') {
        return {
          visibility: 'unknown', evidenceLevel: 'N/A', confidence: 0,
          lastCheckedAt: new Date().toISOString(), evidenceCount: 0,
          summary: '通义千问返回了无法解析的响应。',
          explain: 'AI 响应格式不符合预期。',
          recommendations: ['稍后重试分析'],
        }
      }

      const result = parseProviderResult(parsed)
      const now = new Date().toISOString()
      return {
        visibility: result.visibility ?? 'unknown', knowledgeQuality: result.knowledgeQuality,
        evidenceLevel: result.evidenceLevel ?? 'N/A', confidence: result.confidence ?? 0,
        lastCheckedAt: now, evidenceCount: result.evidenceCount ?? 0,
        summary: result.summary, explain: '基于 通义千问 (DashScope) 大模型对品牌的实时分析结果。',
        recommendations: result.recommendations ?? [],
      }
    } catch (err: any) {
      console.error('[通义千问 Adapter] Request failed:', err)
      return {
        visibility: 'unknown', evidenceLevel: 'N/A', confidence: 0,
        lastCheckedAt: new Date().toISOString(), evidenceCount: 0,
        summary: '通义千问 API 请求异常: ' + err.message,
        explain: '网络错误或请求超时导致无法完成分析。',
        recommendations: ['检查网络连接', '稍后重试分析'],
      }
    }
  },
}
