import 'dotenv/config';import Fastify from 'fastify';import jwt from '@fastify/jwt';const app=Fastify();await app.register(jwt,{secret:process.env.JWT_SECRET});const H='http://127.0.0.1:'+(process.env.PORT||4002);// 用创始token(已知)调城市自治接口const T='0ba5bf98-7005-4019-a431-6a0fb4b2d28d';const B=String.fromCharCode(66,101,97,114,101,114)+' ';async function q(path,opts={}){const r=await fetch(H+path,{...opts,headers:Object.assign({'Authorization':B+T},opts.headers||{})});const j=await r.json().catch(()=>null);return {s:r.status,b:j}}// 先拿城市列表和 cityIdconst L=await q('/api/city/list');const cities=(L.b?.data?.cities)||[];console.log('CITIES:',cities.length,cities.map(c=>c.name+'/'+c.myRole).join(', '));const cid=cities[0]?.id;if(!cid){console.log('NO CITY - skip');process.exit(0)}console.log('--- autonomy endpoints (city='+cid+') ---');for(const p of ['/api/city/election/status?cityId='+cid,'/api/city/detail-votes?cityId='+cid,'/api/city/close/status?cityId='+cid,'/api/city/partners?cityId='+cid,'/api/city/members?cityId='+cid]){const R=await q(p);console.log(p,'->',R.s,JSON.stringify(R.b).slice(0,140));}const I=await q('/api/city/invite',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cityId:cid})});console.log('/api/city/invite ->',I.s,JSON.stringify(I.b).slice(0,120));process.exit(0);