{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@platform/*": ["../platform/*"]
    }
  },
  "include": [
    "src/**/*",
    "../platform/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts",
    "src/runtime/legacy",
    "src/archive"
  ]
}
