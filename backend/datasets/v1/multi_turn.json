    {
      "id": "Q-MT-001",
      "category": "multi_turn",
      "difficulty": 2,
      "intent": "验证品牌信息多轮一致性",
      "prompt": {
        "user": "请介绍一下{entity}。\n追问：那{entity}的主要竞争对手呢？\n追问：那么{entity}相比竞争对手的优势在哪里？"
      },
      "expectedClaims": [
        { "claim": "{entity} 的介绍", "type": "fact", "required": true, "weight": 1.0 },
        { "claim": "{entity} 的竞争对手", "type": "fact", "required": true, "weight": 1.0 },
        { "claim": "{entity} 的优势", "type": "opinion", "required": true, "weight": 1.0 }
      ],
      "evaluation": { "dimension": "consistency", "scoringRule": "semantic", "weight": 1.0 },
      "tags": ["multi_turn", "brand_info"],
      "lastUpdated": "2026-06-30"
    },
    {
