/**
 * S1.1 Identity Ticket Bridge — POST /api/auth/ticket/exchange
 * 云端 Workspace 页面: ticket → accessToken + user（单次消费，防重放）
 * 依据: KUNLUN-AI-OS-IDENTITY-BRIDGE-v1.md / ADR-021
 * 关键: 页面自己存 token（自己域 localStorage），壳不接触。
 */
import { FastifyInstance, FastifyRequest } from 'fastify';

const PREFIX = 'auth:ticket:';

interface TicketPayload {
  userId: string;
  deviceId?: string;
  iat: number;
}

export default async function ticketExchangeRoute(app: FastifyInstance) {
  app.post('/api/auth/ticket/exchange', async (req: FastifyRequest, reply) => {
    const { ticket } = (req.body || {}) as { ticket?: string };
    if (!ticket || typeof ticket !== 'string') {
      return reply.code(400).send({ error: 'TICKET_REQUIRED' });
    }

    // 1) 单次消费: GETDEL 原子取走（Redis ≥6.2；若版本低用 multi GET+DEL）
    const raw = await app.redis.getdel(`${PREFIX}${ticket}`);
    if (!raw) {
      return reply.code(410).send({ error: 'TICKET_USED_OR_EXPIRED' });
    }

    let payload: TicketPayload;
    try {
      payload = JSON.parse(raw);
    } catch {
      return reply.code(410).send({ error: 'TICKET_INVALID' });
    }

    // 2) 复用现有 LoginService 的 JWT 签发（不新建平行身份系统）
    const user = await app.prisma.user.findUnique({
      where: { id: payload.userId },
      select: { id: true, name: true, email: true, avatar: true, tokenVersion: true },
    });
    if (!user) {
      return reply.code(410).send({ error: 'TICKET_INVALID' });
    }

    const accessToken = app.jwt.sign(
      { userId: user.id, tokenVersion: user.tokenVersion },
      { expiresIn: '7d' }
    );

    // 3) 返回 accessToken + user；存储由页面负责（ADR-021）
    return reply.send({
      data: {
        accessToken,
        user: {
          id: user.id,
          name: user.name,
          email: user.email,
          avatar: user.avatar,
        },
      },
    });
  });
}
