<template>
  <div class="geo-dashboard">
    <!-- Loading -->
    <div v-if="loading" class="geo-loading-wrapper">
      <div class="geo-loading-spinner"></div>
      <span>加载中...</span>
    </div>

    <template v-else>
      <!-- ════════ SECTION 1: "下一步应该做什么" — Single CTA ════════ -->
      <div class="geo-mission-card">
        <div class="geo-mission-content">
          <div class="geo-mission-icon-wrapper">
            <span class="geo-mission-icon">{{ missionIcon }}</span>
          </div>
          <div class="geo-mission-text">
            <h2 class="geo-mission-title">{{ missionTitle }}</h2>
            <p class="geo-mission-desc">{{ missionDesc }}</p>
          </div>
          <button class="geo-btn geo-btn-primary geo-btn-lg" @click="onMissionAction">
            {{ missionAction }}
          </button>
        </div>
      </div>

      <!-- ════════ SECTION 2: AI Recommendation Score ════════ -->
      <div v-if="hasProjects" class="geo-section">
        <div class="geo-section-header">
          <h3 class="geo-section-title">AI 推荐指数</h3>
        </div>
        <div class="geo-score-card">
          <div class="geo-score-overall">
            <div class="geo-score-circle" :class="scoreColorClass">
              <span class="geo-score-number">{{ scoreData.overall }}</span>
              <span class="geo-score-max">/100</span>
            </div>
            <div class="geo-score-label">综合评分</div>
          </div>
          <div class="geo-score-bars">
            <div class="geo-score-bar-item">
              <div class="geo-score-bar-header">
                <span class="geo-score-bar-label">可见度</span>
                <span class="geo-score-bar-value">{{ scoreData.visibility }}</span>
              </div>
              <div class="geo-score-bar-track">
                <div class="geo-score-bar-fill geo-bar-visibility" :style="{ width: scoreData.visibility + '%' }"></div>
              </div>
            </div>
            <div class="geo-score-bar-item">
              <div class="geo-score-bar-header">
                <span class="geo-score-bar-label">权威性</span>
                <span class="geo-score-bar-value">{{ scoreData.authority }}</span>
              </div>
              <div class="geo-score-bar-track">
                <div class="geo-score-bar-fill geo-bar-authority" :style="{ width: scoreData.authority + '%' }"></div>
              </div>
            </div>
            <div class="geo-score-bar-item">
              <div class="geo-score-bar-header">
                <span class="geo-score-bar-label">内容</span>
                <span class="geo-score-bar-value">{{ scoreData.content }}</span>
              </div>
              <div class="geo-score-bar-track">
                <div class="geo-score-bar-fill geo-bar-content" :style="{ width: scoreData.content + '%' }"></div>
              </div>
            </div>
            <div class="geo-score-bar-item">
              <div class="geo-score-bar-header">
                <span class="geo-score-bar-label">网站</span>
                <span class="geo-score-bar-value">{{ scoreData.website }}</span>
              </div>
              <div class="geo-score-bar-track">
                <div class="geo-score-bar-fill geo-bar-website" :style="{ width: scoreData.website + '%' }"></div>
              </div>
            </div>
            <div class="geo-score-bar-item">
              <div class="geo-score-bar-header">
                <span class="geo-score-bar-label">知识</span>
                <span class="geo-score-bar-value">{{ scoreData.knowledge }}</span>
              </div>
              <div class="geo-score-bar-track">
                <div class="geo-score-bar-fill geo-bar-knowledge" :style="{ width: scoreData.knowledge + '%' }"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Task list: "今天建议完成" -->
        <div v-if="tasks.length > 0" class="geo-tasks-section">
          <h4 class="geo-tasks-title">今天建议完成</h4>
          <div class="geo-tasks-list">
            <div
              v-for="(task, idx) in tasks.slice(0, 3)"
              :key="idx"
              class="geo-task-item"
              :class="'geo-task--' + task.priority.toLowerCase()"
            >
              <div class="geo-task-left">
                <span class="geo-task-priority-dot" :class="'geo-dot--' + task.priority.toLowerCase()"></span>
                <span class="geo-task-title">{{ task.title }}</span>
              </div>
              <div class="geo-task-right">
                <span class="geo-task-impact">+{{ task.impact }} 分</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ════════ SECTION 3: Recent Projects (max 5) ════════ -->
      <div class="geo-section">
        <div class="geo-section-header">
          <h3 class="geo-section-title">最近项目</h3>
          <button v-if="recentBrands.length > 0" class="geo-btn geo-btn-ghost geo-btn-sm" @click="$emit('navigate', 'brands')">
            查看全部
          </button>
        </div>
        <div v-if="recentBrands.length > 0" class="geo-project-list">
          <div
            v-for="brand in recentBrands"
            :key="brand.id"
            class="geo-project-card"
            @click="selectBrand(brand.id)"
          >
            <div class="geo-project-card-left">
              <span class="geo-project-name">{{ brand.name }}</span>
              <span v-if="brand.industry" class="geo-project-meta">{{ brand.industry }}</span>
            </div>
            <div class="geo-project-card-right">
              <span :class="['geo-project-badge', statusClass(brand)]">
                {{ statusLabel(brand) }}
              </span>
              <span class="geo-project-arrow">→</span>
            </div>
          </div>
        </div>
        <div v-else class="geo-empty-card">
          <p>还没有品牌项目，点击上方按钮开始分析。</p>
        </div>
      </div>

      <!-- ════════ SECTION 4: System Status (default collapsed) ════════ -->
      <details class="geo-system-details">
        <summary class="geo-system-summary">
          <span class="geo-system-summary-icon">⚙️</span>
          <span>系统状态</span>
        </summary>
        <div class="geo-system-panel">
          <div class="geo-system-row">
            <span class="geo-system-label">AI 服务</span>
            <span class="geo-system-value">{{ providerConnected ? '已连接' : '未配置' }}</span>
          </div>
          <div class="geo-system-row">
            <span class="geo-system-label">关联对象</span>
            <span class="geo-system-value">{{ stats.entityCount }} 个对象</span>
          </div>
          <div class="geo-system-row geo-system-row--link" @click="$emit('navigate', 'settings')">
            <span class="geo-system-label">前往设置</span>
            <span class="geo-system-value">→</span>
          </div>
        </div>
      </details>
    </template>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { brandService } from '../services/brandService'
import { client } from '../clients/GEOApiClient'
import { recommendationService, type ScoreData, type TaskData } from '../services/recommendationService'

const emit = defineEmits<{
  navigate: [panelId: string]
  selectBrand: [brandId: string]
}>()

const loading = ref(false)
const providerConnected = ref(false)
const recentBrands = ref<any[]>([])

interface DashboardStats {
  brandCount: number
  keywordCount: number
  koCount: number
  entityCount: number
  relationCount: number
  claimsCount: number
}

const stats = ref<DashboardStats>({
  brandCount: 0, keywordCount: 0, koCount: 0,
  entityCount: 0, relationCount: 0, claimsCount: 0,
})

// Recommendation score state
const scoreData = ref<ScoreData>({
  overall: 0, visibility: 0, authority: 0, content: 0, website: 0, knowledge: 0,
})
const tasks = ref<TaskData[]>([])

// ─── Mission CTA logic ───
const hasBrands = computed(() => stats.value.brandCount > 0)
const hasProjects = computed(() => recentBrands.value.length > 0)
const hasScans = computed(() => recentBrands.value.length > 0 && recentBrands.value.some((b: any) => b.status === 'active' || b.status === 'completed'))
const hasResults = computed(() => stats.value.koCount > 0 || stats.value.claimsCount > 0)

const missionIcon = computed(() => {
  if (!hasBrands.value) return '🚀'
  if (!hasScans.value) return '🔍'
  if (!hasResults.value) return '🧠'
  return '📊'
})

const missionTitle = computed(() => {
  if (!hasBrands.value) return '还没有品牌，立即开始分析'
  if (!hasScans.value) return `继续分析 ${recentBrands.value[0]?.name || ''}`
  if (!hasResults.value) return '分析进行中'
  return '查看最新报告'
})

const missionDesc = computed(() => {
  if (!hasBrands.value) return '输入品牌名称，系统将自动完成扫描、分析和报告生成。'
  if (!hasScans.value) return `「${recentBrands.value[0]?.name || ''}」已创建，启动分析以获取公开信息。`
  if (!hasResults.value) return '系统正在处理中，完成后即可查看报告。'
  return '分析已完成，查看完整的品牌分析报告。'
})

const missionAction = computed(() => {
  if (!hasBrands.value) return '开始分析'
  if (!hasScans.value) return '继续分析'
  if (!hasResults.value) return '查看进度'
  return '查看报告'
})

const scoreColorClass = computed(() => {
  const s = scoreData.value.overall
  if (s >= 80) return 'geo-score--excellent'
  if (s >= 60) return 'geo-score--good'
  if (s >= 40) return 'geo-score--fair'
  return 'geo-score--poor'
})

function onMissionAction() {
  if (!hasBrands.value) { emit('navigate', 'wizard'); return }
  if (!hasScans.value) { emit('navigate', 'brands'); return }
  if (!hasResults.value) { emit('navigate', 'brands'); return }
  emit('navigate', 'report')
}

function selectBrand(id: string) {
  emit('selectBrand', id)
}

function statusClass(brand: any): string {
  if (brand.status === 'active') return 'geo-badge--active'
  if (brand.status === 'completed') return 'geo-badge--completed'
  return 'geo-badge--draft'
}

function statusLabel(brand: any): string {
  if (brand.status === 'active') return '分析中'
  if (brand.status === 'completed') return '已完成'
  return '待分析'
}

async function fetchDashboardData() {
  loading.value = true
  try {
    // Fetch brands
    const brands = await brandService.list()
    const brandsList = Array.isArray(brands) ? brands : []
    recentBrands.value = brandsList.slice(0, 5)

    // Update stats
    stats.value.brandCount = brandsList.length

    // Fetch dashboard stats
    try {
      const res = await client.get<DashboardStats>('/dashboard/stats')
      if (res.success && res.data) {
        const d = res.data
        stats.value.brandCount = d.brandCount ?? stats.value.brandCount
        stats.value.keywordCount = d.keywordCount ?? 0
        stats.value.koCount = d.koCount ?? 0
        stats.value.entityCount = d.entityCount ?? 0
        stats.value.relationCount = d.relationCount ?? 0
        stats.value.claimsCount = d.claimsCount ?? 0
      }
    } catch { /* use defaults */ }

    // Fetch provider status
    try {
      const pres = await client.get<{ configured: boolean }>('/dashboard/provider-status')
      if (pres.success) providerConnected.value = pres.data?.configured || false
    } catch { /* use defaults */ }

    // Fetch AI recommendation score and tasks
    const hasProjectId = brandsList.length > 0 && brandsList[0]?.projectId
    if (hasProjectId) {
      try {
        const scoreRes = await recommendationService.getScore(brandsList[0].projectId)
        if (scoreRes.success && scoreRes.data) {
          scoreData.value = scoreRes.data
        }
      } catch { /* use defaults */ }

      try {
        const tasksRes = await recommendationService.getTasks(brandsList[0].projectId)
        if (tasksRes.success && tasksRes.data) {
          tasks.value = tasksRes.data
        }
      } catch { /* use defaults */ }
    }
  } catch (err) { console.error('Failed to fetch dashboard:', err) }
  finally { loading.value = false }
}

onMounted(fetchDashboardData)
</script>

<style scoped>
.geo-dashboard { padding: 24px; color: #e0e0e0; height: 100%; overflow-y: auto; max-width: 820px; margin: 0 auto; }

/* Loading */
.geo-loading-wrapper { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 80px 0; font-size: 14px; color: #888; }
.geo-loading-spinner { width: 22px; height: 22px; border: 3px solid rgba(129,140,248,0.2); border-top-color: #818cf8; border-radius: 50%; animation: spin 0.6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Mission Card (Section 1) ── */
.geo-mission-card { margin-bottom: 24px; }
.geo-mission-content {
  display: flex; align-items: center; gap: 20px;
  padding: 28px; background: linear-gradient(135deg, #1a1a2e, #1e1e36);
  border-radius: 14px; border: 1px solid rgba(129,140,248,0.12);
}
.geo-mission-icon-wrapper {
  width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;
  border-radius: 14px; background: rgba(129,140,248,0.15); flex-shrink: 0;
}
.geo-mission-icon { font-size: 42px; }
.geo-mission-text { flex: 1; }
.geo-mission-title { font-size: 20px; font-weight: 700; margin: 0 0 6px; }
.geo-mission-desc { font-size: 13px; color: #888; margin: 0; line-height: 1.5; }
.geo-btn { border: none; cursor: pointer; font-weight: 600; transition: all 0.15s; white-space: nowrap; }
.geo-btn:active { transform: scale(0.97); }
.geo-btn-primary { background: linear-gradient(135deg, #818cf8, #6366f1); color: white; }
.geo-btn-primary:hover { opacity: 0.9; }
.geo-btn-lg { padding: 12px 28px; border-radius: 10px; font-size: 15px; }
.geo-btn-ghost { background: rgba(255,255,255,0.06); color: #ccc; border-radius: 6px; padding: 6px 14px; font-size: 12px; }
.geo-btn-ghost:hover { background: rgba(255,255,255,0.1); }
.geo-btn-sm { padding: 6px 14px; font-size: 12px; border-radius: 6px; }

/* ── Sections ── */
.geo-section { margin-bottom: 24px; }
.geo-section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.geo-section-title { font-size: 15px; font-weight: 600; margin: 0; color: #ccc; }

/* ── AI Score Card ── */
.geo-score-card {
  display: flex; gap: 24px; padding: 24px;
  background: #1a1a2e; border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.04);
  margin-bottom: 16px;
}
.geo-score-overall {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; flex-shrink: 0; gap: 8px;
}
.geo-score-circle {
  width: 100px; height: 100px; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 4px solid #4b5563; transition: border-color 0.3s;
}
.geo-score--excellent { border-color: #34d399; }
.geo-score--good { border-color: #818cf8; }
.geo-score--fair { border-color: #fbbf24; }
.geo-score--poor { border-color: #f87171; }
.geo-score-number { font-size: 36px; font-weight: 800; line-height: 1; }
.geo-score--excellent .geo-score-number { color: #34d399; }
.geo-score--good .geo-score-number { color: #818cf8; }
.geo-score--fair .geo-score-number { color: #fbbf24; }
.geo-score--poor .geo-score-number { color: #f87171; }
.geo-score-max { font-size: 12px; color: #6b7280; }
.geo-score-label { font-size: 12px; color: #888; }
.geo-score-bars { flex: 1; display: flex; flex-direction: column; gap: 10px; justify-content: center; }
.geo-score-bar-item { display: flex; flex-direction: column; gap: 4px; }
.geo-score-bar-header { display: flex; justify-content: space-between; font-size: 12px; }
.geo-score-bar-label { color: #9ca3af; font-weight: 500; }
.geo-score-bar-value { color: #e0e0e0; font-weight: 600; }
.geo-score-bar-track { height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
.geo-score-bar-fill { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
.geo-bar-visibility { background: linear-gradient(90deg, #818cf8, #6366f1); }
.geo-bar-authority { background: linear-gradient(90deg, #34d399, #10b981); }
.geo-bar-content { background: linear-gradient(90deg, #fbbf24, #f59e0b); }
.geo-bar-website { background: linear-gradient(90deg, #f87171, #ef4444); }
.geo-bar-knowledge { background: linear-gradient(90deg, #a78bfa, #8b5cf6); }

/* ── Tasks ── */
.geo-tasks-section { margin-top: 4px; }
.geo-tasks-title { font-size: 13px; font-weight: 600; color: #9ca3af; margin: 0 0 10px; }
.geo-tasks-list { display: flex; flex-direction: column; gap: 8px; }
.geo-task-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 14px; background: #16162a; border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.04);
}
.geo-task-left { display: flex; align-items: center; gap: 10px; }
.geo-task-priority-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.geo-dot--high { background: #f87171; }
.geo-dot--medium { background: #fbbf24; }
.geo-dot--low { background: #9ca3af; }
.geo-task-title { font-size: 13px; font-weight: 500; }
.geo-task-right { flex-shrink: 0; }
.geo-task-impact { font-size: 12px; font-weight: 600; color: #34d399; }

/* ── Recent Projects ── */
.geo-project-list { display: flex; flex-direction: column; gap: 8px; }
.geo-project-card {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 16px; background: #1a1a2e; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.04); cursor: pointer; transition: all 0.12s;
}
.geo-project-card:hover { border-color: rgba(129,140,248,0.2); background: #1e1e36; }
.geo-project-card-left { display: flex; flex-direction: column; gap: 2px; }
.geo-project-name { font-size: 14px; font-weight: 600; }
.geo-project-meta { font-size: 11px; color: #6b7280; }
.geo-project-card-right { display: flex; align-items: center; gap: 10px; }
.geo-project-badge { font-size: 11px; padding: 3px 10px; border-radius: 10px; font-weight: 600; }
.geo-badge--draft { background: rgba(156,163,175,0.12); color: #9ca3af; }
.geo-badge--active { background: rgba(52,211,153,0.12); color: #34d399; }
.geo-badge--completed { background: rgba(129,140,248,0.12); color: #818cf8; }
.geo-project-arrow { color: #4b5563; font-size: 16px; }
.geo-project-card:hover .geo-project-arrow { color: #818cf8; }
.geo-empty-card { padding: 24px; text-align: center; color: #6b7280; font-size: 13px; background: #1a1a2e; border-radius: 10px; border: 1px dashed rgba(255,255,255,0.06); }

/* ── System Status (collapsed) ── */
.geo-system-details { border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.04); }
.geo-system-summary {
  display: flex; align-items: center; gap: 8px;
  padding: 12px 16px; background: #1a1a2e; cursor: pointer; font-size: 13px; color: #888; user-select: none;
}
.geo-system-summary::-webkit-details-marker { color: #4b5563; }
.geo-system-summary-icon { font-size: 14px; }
.geo-system-panel { padding: 0 16px 12px; background: #16162a; }
.geo-system-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 12px; border-top: 1px solid rgba(255,255,255,0.04); }
.geo-system-label { color: #888; }
.geo-system-value { color: #ccc; }
.geo-system-row--link { cursor: pointer; }
.geo-system-row--link:hover .geo-system-label { color: #818cf8; }
</style>
