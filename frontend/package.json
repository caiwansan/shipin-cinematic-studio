{
  "name": "shipin-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/patch-manifest.mjs",
    "validate": "node scripts/build-validator.mjs",
    "sync": "node scripts/asset-sync.mjs",
    "meta": "node scripts/release-meta.mjs",
    "smoke": "node scripts/deployment-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/build-validator.mjs && node scripts/patch-manifest.mjs && node scripts/asset-sync.mjs && node scripts/release-meta.mjs",
    "release": "nuxt build && node scripts/build-validator.mjs && node scripts/patch-manifest.mjs && node scripts/asset-sync.mjs && node scripts/release-meta.mjs && pm2 restart nuxt-frontend --update-env && sleep 3 && node scripts/deployment-check.mjs",
    "generate": "nuxt generate",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@pinia/nuxt": "^0.11.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.184.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "cookie-es": "^3.1.1",
    "d3": "^7.9.0",
    "defu": "^6.1.7",
    "devalue": "^5.8.0",
    "echarts": "^6.0.0",
    "esbuild": "^0.27.7",
    "gsap": "3.15.0",
    "h3": "2.0.1-rc.22",
    "internmap": "^2.0.3",
    "motion-v": "^2.2.1",
    "nuxt": "3.16.2",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "pinia": "latest",
    "qrcode": "^1.5.4",
    "radix3": "^1.1.2",
    "scule": "^1.3.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "unctx": "^2.5.0",
    "vue": "^3.5.34",
    "vue-echarts": "^8.0.1",
    "vue-router": "latest",
    "zrender": "^6.1.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.0"
  }
}