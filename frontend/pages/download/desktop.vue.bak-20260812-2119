                <span class="dl-os-icon">{{ p.icon }}</span>
                <div>
                  <div class="dl-os-name">{{ p.name }}</div>
                  <div class="dl-os-sub">{{ p.subtitle }}</div>
                </div>
              </div>
              <div class="dl-meta" v-if="p.meta">
                <div class="dl-meta-row"><span>版本</span><b>{{ p.meta.version }}</b></div>
                <div class="dl-meta-row"><span>大小</span><b>{{ p.meta.sizeText }}</b></div>
                <div class="dl-meta-row"><span>更新时间</span><b>{{ p.meta.publishedText }}</b></div>
              </div>
            </div>

            <p class="dl-pdesc">{{ p.desc }}</p>

            <a
              :href="p.meta ? p.meta.downloadUrl : '#'"
              class="dl-btn"
              :class="{ 'dl-btn-disabled': !p.meta }"
              @click="p.meta ? null : $event.preventDefault()"
            >
              <span class="dl-btn-icon">⬇️</span>
              {{ p.meta ? '下载 ' + p.name + ' ' + p.meta.version : '正在获取版本信息…' }}
            </a>

            <div class="dl-foot" v-if="p.meta">
              <span>SHA256：<code class="dl-sha">{{ p.meta.sha256 }}</code></span>
            </div>
