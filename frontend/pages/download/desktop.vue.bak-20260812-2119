    <KunlunNav
      :is-logged-in="isLoggedIn"
      @show-login="showLogin = true"
      @show-register="goRegister"
      @logout="doLogout"
    />

    <!-- 主区 -->
    <main class="dl-main">
      <section class="dl-hero">
        <div class="dl-badge">昆仑镜官方下载</div>
        <h1 class="dl-title">昆仑 AI 桌面应用 <span class="dl-title-accent">Download Center</span></h1>
        <p class="dl-subtitle">昆仑工坊 · AI 短剧视频创作工作台　|　智慧车间 · 新媒体运营工作台</p>
        <p class="dl-desc">
          全部桌面应用均为本地安装、数据本地保存，复用昆仑镜云端账号 / VIP / 支付体系。
          安装包全程 HTTPS 安全传输，提供 SHA256 校验。
        </p>

        <!-- 产品卡片 -->
        <div class="dl-grid">
          <div v-for="p in products" :key="p.id" class="dl-card" :style="{ borderTop: '3px solid ' + p.accent }">
