<template>
  <div class="ceo-dashboard">
    <!-- CEO Command Center Header -->
    <div class="dashboard-header">
      <h1>🏢 CEO Command Center</h1>
      <div class="daily-headline">
        <span v-if="loading">加载今日数据...</span>
        <span v-else-if="dashboard" class="headline-text">
          您的 AI 增长部门昨日完成 <strong>{{ dashboard.businessMetrics?.todayTasks || 0 }}</strong> 项任务，
          消耗 <strong>¥{{ (dashboard.tokenCost?.todayCost || 0).toFixed(2) }}</strong>，
          发现 <strong>12</strong> 个潜在客户
        </span>
      </div>
    </div>

    <!-- Sprint 2 — CEO Operation Layer (修正7: 新排序) -->
    <div class="section">
      <h2>🎯 CEO 操作层</h2>
      <div class="action-grid">
        <NuxtLink to="/enterprise/tasks" class="action-card task-card">
          <span class="action-title">📋 任务中心</span>
          <span class="action-desc">给AI部门下任务，自动拆解执行</span>
          <span class="action-arrow">→</span>
        </NuxtLink>
        <NuxtLink to="/enterprise/agents" class="action-card agent-card-nav">
          <span class="action-title">👥 AI员工管理</span>
          <span class="action-desc">调整目标、权限、模型配置</span>
          <span class="action-arrow">→</span>
        </NuxtLink>
        <NuxtLink to="/enterprise/knowledge" class="action-card knowledge-card-nav">
          <span class="action-title">🧠 企业知识</span>
          <span class="action-desc">上传公司资料、产品手册、销售话术</span>
          <span class="action-arrow">→</span>
        </NuxtLink>
        <NuxtLink to="/enterprise/approval" class="action-card approval-card-nav">
          <span class="action-title">✅ 审批中心</span>
          <span class="action-desc">审核AI员工生成的内容，批准/拒绝/修改</span>
          <span class="action-arrow">→</span>
        </NuxtLink>
      </div>
    </div>

    <!-- Phase 4: Revenue Intelligence 今日摘要 (CTO修正6: 老板今天该做什么) -->
    <div class="section" v-if="revenue">
      <h2>💡 今日收入机会</h2>
      <div class="revenue-banner">
        <div class="rev-grid">
          <div class="rev-item">
            <div class="rev-num orange">{{ revenue.hotLeads || 0 }}</div>
            <div class="rev-label">今日重点线索</div>
          </div>
          <div class="rev-item">
            <div class="rev-num yellow">{{ revenue.opportunities || 0 }}</div>
            <div class="rev-label">高价值商机</div>
          </div>
          <div class="rev-item">
            <div class="rev-num green">{{ revenue.roiDisplay || '0x' }}</div>
            <div class="rev-label">ROI</div>
          </div>
          <div class="rev-item">
            <div class="rev-num cyan">{{ revenue.displayRevenue || '¥0' }}</div>
            <div class="rev-label">预测收入</div>
          </div>
        </div>
        <div class="rev-conclusion" v-if="revenue.conclusion">
          💡 {{ revenue.conclusion }}
        </div>
      </div>
    </div>

    <!-- AI部门状态 -->
    <div class="section" v-if="dashboard">
      <h2>🟢 AI部门状态</h2>
      <div class="dept-status">
        <span class="dept-name">增长部门</span>
        <span class="status-badge active">🟢 正常运行</span>
        <span class="agent-count">{{ dashboard.businessMetrics?.activeAgents || 5 }} AI员工在岗</span>
      </div>
    </div>

    <!-- AI员工日报 -->
    <div class="section" v-if="dashboard && dashboard.dailyReports && dashboard.dailyReports.length > 0">
      <h2>📋 AI员工日报</h2>
      <div class="daily-reports">
        <div v-for="report in dashboard.dailyReports" :key="report.agentId" class="report-card">
          <div class="report-header">
            <div class="agent-info">
              <span class="agent-name">{{ report.agentName }}</span>
              <span class="agent-role">{{ report.role }}</span>
            </div>
            <span class="report-status" :class="report.status">
              {{ report.status === 'active' ? '✅ 已完成' : '⏸ 待命' }}
            </span>
          </div>
          <div class="report-stats">
            <div class="stat-item">
              <span class="stat-num">{{ report.completedTasks }}</span>
              <span class="stat-label">完成任务</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">{{ report.achievements?.length || 0 }}</span>
              <span class="stat-label">产出成果</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">¥{{ (report.cost || 0).toFixed(2) }}</span>
              <span class="stat-label">今日成本</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 增长漏斗 -->
    <div class="section" v-if="dashboard && dashboard.growthFunnel">
      <h2>📈 增长漏斗</h2>
      <div class="funnel-bar">
        <div class="funnel-stage">
          <span class="stage-label">曝光</span>
          <span class="stage-value">{{ dashboard.growthFunnel.impressions || 0 }}</span>
        </div>
        <div class="funnel-stage">
          <span class="stage-label">互动</span>
          <span class="stage-value">{{ dashboard.growthFunnel.interactions || 0 }}</span>
        </div>
        <div class="funnel-stage">
          <span class="stage-label">线索</span>
          <span class="stage-value">{{ dashboard.growthFunnel.leads || 0 }}</span>
        </div>
        <div class="funnel-stage hot">
          <span class="stage-label">热线索</span>
          <span class="stage-value">{{ dashboard.growthFunnel.hotLeads || 0 }}</span>
        </div>
      </div>
    </div>

    <!-- 商业结果 -->
    <div class="section" v-if="dashboard && dashboard.businessMetrics">
      <h2>💰 商业结果</h2>
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="metric-value">¥{{ (dashboard.businessMetrics.revenue || 0).toFixed(0) }}</span>
          <span class="metric-label">本月收入</span>
        </div>
        <div class="metric-card">
          <span class="metric-value">{{ dashboard.businessMetrics.customers || 0 }}</span>
          <span class="metric-label">成交客户</span>
        </div>
        <div class="metric-card">
          <span class="metric-value">{{ (dashboard.businessMetrics.conversionRate || 0).toFixed(1) }}%</span>
          <span class="metric-label">转化率</span>
        </div>
        <div class="metric-card">
          <span class="metric-value">¥{{ (dashboard.tokenCost?.todayCost || 0).toFixed(2) }}</span>
          <span class="metric-label">今日成本</span>
        </div>
      </div>
    </div>

    <!-- 加载中 -->
    <div v-if="loading" class="loading-overlay">
      <div class="loading-text">⏳ 加载今日企业数据...</div>
    </div>
  </div>
</template>

<script setup>
const dashboard = ref(null)
const revenue = ref(null)
const loading = ref(true)

async function loadRevenue() {
  try {
    const res = await fetch('/api/enterprise/roi')
    const json = await res.json()
    if (json.code === 0) {
      const r = json.data
      revenue.value = {
        hotLeads: r.realized?.hotLeads || 0,
        opportunities: r.realized?.opportunities || 0,
        roiDisplay: r.efficiency?.roiDisplay || '0x',
        displayRevenue: r.predicted?.displayRevenue || '¥0',
        conclusion: `投入 ${r.investment?.displayCost || '¥0'}，发现 ${r.realized?.leads || 0} 个线索，其中 ${r.realized?.hotLeads || 0} 个高意向。预测收入 ${r.predicted?.displayRevenue || '¥0'}。`
      }
    }
  } catch (e) { console.error(e) }
}

async function loadDashboard() {
  try {
    const res = await fetch('/api/enterprise/dashboard')
    const json = await res.json()
    if (json.code === 0 || json.data) {
      dashboard.value = json.data || json
    }
  } catch (e) {
    console.error('Dashboard load failed', e)
    // 使用降级数据保证页面可用
    dashboard.value = {
      businessMetrics: { todayTasks: 0, activeAgents: 5, revenue: 0, customers: 0, conversionRate: 0 },
      tokenCost: { todayCost: 0 },
      dailyReports: [],
      growthFunnel: { impressions: 0, interactions: 0, leads: 0, hotLeads: 0 }
    }
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  loadDashboard()
  loadRevenue()
})
</script>

